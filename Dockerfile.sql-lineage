# ==============================================================================
# METIS SQL Lineage Sidecar Dockerfile (`metis-sql-lineage`)
#
# Epic #294 (#303) — a dedicated PYTHON sidecar that extracts SQL usage
# (tables / columns / OpenLineage edges) via `sqlglot`. It mirrors the
# deployment shape of `metis-embeddings` (shared-secret auth, restricted egress,
# own image) but is Python/FastAPI/uvicorn rather than Node.
#
# CRITICAL — self-hosted-runner health: there is NO model download at build time
# and NO heavy native dependency. `sqlglot` is a zero-dependency, pure-Python SQL
# parser; FastAPI/uvicorn/pydantic are small pure-Python wheels. This image
# therefore does NOT reintroduce the build-time model-bake flake fixed in #290.
#
# The sidecar NEVER executes SQL — it only parses it — and makes NO outbound
# network calls.
#
# #1379 — both stages are pinned by DIGEST to `python:3.12-slim-trixie` (the
# tag alone moved under the layer cache: the image scanned in #1312 was a stale
# 13.6 base). The runner applies Debian's security updates, and neither the
# runtime venv nor the base interpreter keeps pip, which nothing at runtime runs.
# To move the base: `docker buildx imagetools inspect python:3.12-slim-trixie`
# and replace the digest in BOTH `FROM`s (image-build-wiring.test.mjs checks).
# ==============================================================================

# ----- Stage 1: install pinned deps into a venv -----------------------------
FROM python:3.12-slim-trixie@sha256:cb33f7f771ecec2ef1225cf39b159591a040391bd73e4c01f00fdfc4c47611d2 AS builder
WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Pinned runtime deps only (no dev/test/lint deps in the runtime image).
COPY metis-sql-lineage/requirements.txt ./requirements.txt
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt \
 && /opt/venv/bin/pip uninstall -y pip

# ----- Stage 2: runtime -----------------------------------------------------
FROM python:3.12-slim-trixie@sha256:cb33f7f771ecec2ef1225cf39b159591a040391bd73e4c01f00fdfc4c47611d2 AS runner
WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:${PATH}" \
    SQL_LINEAGE_PORT=5070 \
    SQL_LINEAGE_HOST=0.0.0.0

# #1379 — Debian security updates, and no pip in the base interpreter either.
# OS_PATCH_DATE busts the layer cache so CI (which passes the date) picks up a
# distro fix the day it ships; it is not otherwise read.
# Non-root runtime user (least privilege).
ARG OS_PATCH_DATE=unset
RUN echo "os patch level: ${OS_PATCH_DATE}" \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/* \
 && python -m pip uninstall -y pip \
 && groupadd --system --gid 1001 metis \
 && useradd  --system --uid 1001 --gid metis --create-home --home-dir /home/metis metis

COPY --from=builder /opt/venv /opt/venv
COPY --chown=metis:metis metis-sql-lineage/app ./app

USER metis

EXPOSE 5070

# `urllib` ships with the stdlib — no extra dependency for the healthcheck.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import os,urllib.request,sys; \
url='http://127.0.0.1:%s/healthz' % os.environ.get('SQL_LINEAGE_PORT','5070'); \
sys.exit(0 if urllib.request.urlopen(url, timeout=4).status==200 else 1)" || exit 1

CMD ["python", "-m", "app.server"]
