# ==============================================================================
# METIS Copilot Sidecar Dockerfile (`metis-copilot`)
#
# Issue #180 — externalises `@github/copilot-sdk` so the main `metis-server`
# image can stay minimal/Alpine while the SDK runs in its own glibc Node
# container. The sidecar is OPT-IN (`COPILOT_NATIVE_MODE=sidecar`) and is
# only enabled via the `copilot-native` compose profile.
#
# Base image: `node:20-bookworm-slim` (glibc) — matches the embeddings
# sidecar pattern. This service is **exempt** from the 350 MB image-size
# budget; track image size separately.
# ==============================================================================

ARG NODE_VERSION=20

# ----- Stage 1: install + build --------------------------------------------
FROM node:${NODE_VERSION}-bookworm-slim AS builder
WORKDIR /app

ENV PNPM_HOME=/usr/local/share/pnpm
ENV PATH="${PNPM_HOME}:${PATH}"

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable \
 && corepack prepare pnpm@10.33.0 --activate

# Workspace manifest scaffolding — copy only package.json files first so the
# install layer stays cacheable across source-only changes.
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/ui-kit/package.json ./packages/ui-kit/
COPY server/package.json ./server/
COPY server/embeddings-svc/package.json ./server/embeddings-svc/
COPY server/copilot-svc/package.json ./server/copilot-svc/
COPY ui/package.json ./ui/
COPY e2e/package.json ./e2e/

RUN pnpm install --frozen-lockfile --filter @metis/copilot-svc

COPY server/copilot-svc ./server/copilot-svc
RUN pnpm --filter @metis/copilot-svc build

# Use `pnpm deploy` to produce a fully self-contained, deduplicated tree
# under /deploy/. This collapses the workspace's symlinked store into a flat
# node_modules and prunes devDependencies.
RUN pnpm --filter @metis/copilot-svc deploy --prod --legacy /deploy

# ----- Stage 2: runtime ----------------------------------------------------
FROM node:${NODE_VERSION}-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV COPILOT_NATIVE_PORT=5060
ENV COPILOT_NATIVE_HOST=0.0.0.0

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 1001 metis \
 && useradd  --system --uid 1001 --gid metis --create-home --home-dir /home/metis metis \
 && mkdir -p /data \
 && chown -R metis:metis /data /home/metis

COPY --from=builder --chown=metis:metis /deploy/dist           ./dist
COPY --from=builder --chown=metis:metis /deploy/node_modules   ./node_modules
COPY --from=builder --chown=metis:metis /deploy/package.json   ./package.json

USER metis

EXPOSE 5060

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get({host:'127.0.0.1',port:process.env.COPILOT_NATIVE_PORT||5060,path:'/healthz',timeout:4000},r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

CMD ["node", "dist/index.js"]
