# ==============================================================================
# METIS Environment Variables — Example
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# ==============================================================================

# --- Database (SQLite for local dev, Postgres in prod) ----------------------
# Local dev (default): SQLite at server/prisma/dev.db
DATABASE_URL=file:./dev.db
# DATABASE_PROVIDER selects the schema file used by `pnpm db:*` scripts.
#   sqlite     -> prisma/schema.prisma          (default)
#   postgresql -> prisma/postgres/schema.prisma (autogenerated; entrypoint switches automatically based on DATABASE_URL scheme)
DATABASE_PROVIDER=sqlite
# Production example:
# DATABASE_URL=postgresql://metis:metis@localhost:5432/metis
# DATABASE_PROVIDER=postgresql

# --- Auth ---------------------------------------------------------------------
# JWT signing secret — generate with: openssl rand -hex 32 (min 32 bytes).
# REQUIRED everywhere except genuine local development (NODE_ENV=development or
# test, outside a container platform). Anywhere else — staging, preview/review
# apps, CI reachable off-localhost, or an image that never sets NODE_ENV — the
# server REFUSES TO START without a real secret rather than falling back to the
# publicly-known development key (issue #1057). Leaving the placeholder below
# counts as unset.
JWT_SECRET=replace-me-with-a-long-random-string
# Auth provider: mock (dev) | ldap | saml | oidc
#   mock        — username/password against seeded dev users (admin/password).
#   ldap        — bind+search against an LDAP/AD directory (env-driven, see below).
#   saml / oidc — single sign-on; configured via the admin API, NOT env vars
#                 (PUT /api/admin/auth/providers/{saml,oidc}). Leave AUTH_MODE=mock
#                 and layer SAML/OIDC on top — the SSO routes do not gate on AUTH_MODE.
AUTH_MODE=mock
# JWT lifetimes
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# --- LDAP / Active Directory (only read when AUTH_MODE=ldap) -------------------
# The LDAP provider (server/src/lib/auth/ldap-provider.ts) binds with the service
# account, searches for the user, then re-binds as the user to verify the password.
# For a one-command local directory to exercise these, see
# docs/auth/ldap-local-testing.md (`make ldap-up`), which prints this exact block.
#
# LDAP server URL (ldap:// or ldaps://). REQUIRED for ldap mode.
# AUTH_LDAP_URL=ldap://localhost:4400
# Root suffix / baseDN of the directory tree.
# AUTH_LDAP_BASE_DN=dc=metis,dc=local
# Service-account (read) bind DN used to SEARCH for users. REQUIRED for ldap mode.
# AUTH_LDAP_BIND_DN=cn=admin,dc=metis,dc=local
# Service-account bind password.
# AUTH_LDAP_BIND_PASSWORD=adminpassword
# Subtree to search for users (falls back to AUTH_LDAP_BASE_DN if unset).
# AUTH_LDAP_USER_SEARCH_BASE=ou=users,dc=metis,dc=local
# User search filter. `{{username}}` is substituted (RFC-4515 escaped) with the
# login name. Default is Active-Directory shaped; override for OpenLDAP/inetOrgPerson:
# AUTH_LDAP_SEARCH_FILTER=(&(objectClass=inetOrgPerson)(uid={{username}}))
# Skip TLS cert verification for ldaps:// (self-signed enterprise LDAP only).
# DEV-ONLY: when NODE_ENV=production this flag is REFUSED — the LDAP connection
# fails fast rather than silently authenticating over an unverified channel
# (#529). Provide a trusted certificate in production instead.
# AUTH_LDAP_TLS_SKIP_VERIFY=false
# Connection/bind timeout in ms (default 10000).
# AUTH_LDAP_CONNECTION_TIMEOUT=10000
#
# NOTE: LDAP group→role mapping needs `groupMappings`, which env vars do NOT carry
# (env-only config maps every user to the default role 'reader'). Configure the
# group→role mappings via the admin API: PUT /api/admin/auth/providers/ldap.

# Master key for envelope-encrypted secret vault — generate with: openssl rand -base64 32
# REQUIRED in production. Server refuses to boot without one.
VAULT_MASTER_KEY=replace-me-with-a-32-byte-base64-key

# --- Rate limiting ------------------------------------------------------------
# Auth route limiter (defaults: 20 req / 15 min)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

# --- Microsoft Teams bridge security (Epic #547, #554) ------------------------
# Azure AD tenant allowlist for INBOUND Teams bridge traffic. The Bot Framework
# JWT (validated by the SDK CloudAdapter) proves an activity is genuinely from the
# channel service but does NOT restrict WHICH tenant may drive the bridge. Set
# this to pin a MultiTenant bot to approved tenant(s).
#   - UNSET / blank  → allow-all (default; any JWT-valid tenant is accepted).
#   - comma-separated tenant guids → only those tenants; comparison is
#     case-insensitive, and a tenant-less sender is rejected.
# TEAMS_ALLOWED_TENANTS=00000000-0000-0000-0000-000000000000
#
# Per-(workspace, conversation) inbound cap so a chatty/abusive channel cannot
# flood METIS with messages. Reuses DISCUSSION_RATE_LIMIT_BACKEND (set =postgres
# for a cluster-wide cap across replicas).
TEAMS_INBOUND_RATE_LIMIT_MAX=30
TEAMS_INBOUND_RATE_LIMIT_WINDOW_MS=60000

# --- PagerDuty sev-1 alerting (#580) ------------------------------------------
# PagerDuty incidents for critical operational events (publish rollback, vault
# key rotation failure, provider/sandbox down). Per-workspace routing keys are
# registered via the admin API and stored ENCRYPTED in the vault — there is no
# routing-key env var (a key in the environment would defeat the at-rest
# encryption requirement).
#
# Some sev-1 conditions are platform-level rather than tenant-scoped: vault key
# rotation failures (secrets are platform/project-scoped) and provider-down for
# global/user-scoped MCP servers (no project → no workspace). Designate ONE
# workspace whose registered PagerDuty service receives those platform alerts.
# Unset → platform-level alerting is disabled (tenant-scoped alerts, e.g. project
# publish rollbacks, still page because they derive their workspace from the project).
# PAGERDUTY_OPS_WORKSPACE_ID=

# --- AI Engine (Phase 4) ------------------------------------------------------
# Offline mode — when 1, the offline-stub provider is used (no SDK calls,
# deterministic word-by-word stream). Useful for tests and air-gapped envs.
AI_OFFLINE=0

# Per-user AI rate limit (defaults: 60 req / 15 min). Layered on top of auth limiter.
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=60

# /readyz deep-health probe timeout for provider.ping() (ms).
AI_PING_TIMEOUT_MS=1500

# Bounded retry/backoff for transient Bedrock throttling on the OpenAI-compatible
# direct provider (429 ThrottlingException / 503 / connection-reset). Retries use
# exponential backoff with FULL JITTER and honor any `Retry-After` header as the
# delay floor. AI_MAX_RETRIES is the TOTAL number of tries (initial + retries),
# clamped to [1,6]; set 1 to disable retrying. AI_RETRY_BASE_DELAY_MS is the base
# delay (ms) for the exponential window (capped at 20s/attempt). A stream() call
# is retried ONLY before the first byte — a mid-stream failure surfaces, never
# restarts. (Defaults: 4 tries, 500ms base.)
AI_MAX_RETRIES=4
AI_RETRY_BASE_DELAY_MS=500

# Where the Copilot wrapper persists auth state (defaults to ~/.metis).
# Per-session COPILOT_HOME is created under <METIS_AUTH_DIR>-sessions/<sessionId>.
# METIS_AUTH_DIR=

# Default Copilot model used when a session does not pin one.
COPILOT_MODEL=gpt-4.1

# Default Bedrock-fronted model id (used when COPILOT_PROVIDER_TYPE=bedrock-gateway).
BEDROCK_MODEL=us.anthropic.claude-sonnet-5

# --- AI BYOK (R-SDK-14) -------------------------------------------------------
# COPILOT_PROVIDER_TYPE: leave unset for native Copilot, or set to one of
#   bedrock-gateway | openai | azure | anthropic
# Public LLM hosts (api.openai.com, api.anthropic.com, etc.) are refused —
# you MUST point at an internal proxy/gateway.
# COPILOT_PROVIDER_TYPE=bedrock-gateway
# COPILOT_PROVIDER_BASE_URL=http://localhost:8080
# COPILOT_PROVIDER_API_KEY=replace-me-byok-api-key
# COPILOT_PROVIDER_MODEL=us.anthropic.claude-sonnet-5

# Bedrock gateway shortcut envs (alternative to COPILOT_PROVIDER_*)
# BEDROCK_GATEWAY_URL=http://localhost:8080
# BEDROCK_GATEWAY_API_KEY=replace-me-gateway-api-key

# --- Local Gemma via Ollama (local-gemma) -------------------------------------
# Run Gemma on-prem instead of Bedrock. Switching back is a one-line change:
# set AI_PROVIDER=bedrock-gateway. local-gemma is chat/stream only — embeddings
# stay on the existing embeddings backend.
#
#   1. Install Ollama (>= 0.6): https://ollama.com/download
#   2. ollama pull gemma4:12b        # ~7.6 GB, multimodal, 256K context
#   3. Set the four vars below and start the server.
#
# AI_PROVIDER=local-gemma
# Ollama's OpenAI-compatible endpoint — MUST include the /v1 suffix.
# Only loopback / private (RFC1918) hosts are accepted; public LLM hosts are refused.
# LOCAL_GEMMA_BASE_URL=http://localhost:11434/v1
# Model id to stream (default: gemma4:12b).
# LOCAL_GEMMA_MODEL=gemma4:12b
# Dummy bearer token — the header is required but Ollama ignores the value.
# LOCAL_GEMMA_API_KEY=ollama
#
# Timeouts (ms, plain digits only: write 1200000, not 1_200_000 or 1.2e6; 0
# disables; max 2147453647, ~24.8 days). Unset keeps the default; any other
# invalid value keeps the default and logs a warning. A local runtime sends
# NOTHING until it has processed the whole prompt, so the first-token budget must
# cover prefill: prompt tokens / prefill tok/s. Measured (#111): a 130K-token
# docs-gen prompt at ~224 tok/s needed ~9.7 min of prefill; the 10-min default
# left too little headroom and the request was aborted at 98% processed. Raising
# DOCS_GEN_LOCAL_FACTS_CHAR_CAP grows the prompt, so raise this budget with it. A
# timeout is logged with the prompt size and is never retried with the same
# prompt (that repeats the whole prefill).
# LOCAL_GEMMA_FIRST_BYTE_TIMEOUT_MS=600000   # time to first token (stream)
# LOCAL_GEMMA_IDLE_TIMEOUT_MS=120000         # gap between tokens once streaming
# LOCAL_GEMMA_REQUEST_TIMEOUT_MS=300000      # whole non-streaming request
#
# Concurrency: Ollama serves ONE request at a time by default (OLLAMA_NUM_PARALLEL
# unset) and sends no bytes until that request's first token, so METIS queues its
# own local requests: at most this many in flight per local server, shared
# by docs-gen, grounding, analysis and chat, FIFO. The timeouts above start only
# once a request holds a slot, so queue time never counts as a stall. Match it to
# OLLAMA_NUM_PARALLEL on the server. Positive integer; anything else keeps 1.
# LOCAL_GEMMA_MAX_CONCURRENCY=1
#
# Thinking control: when thinking is off, local requests send think:false AND
# reasoning_effort:"none" — Ollama's /v1 endpoint ignores think (measured: Ollama
# 0.34.2 + laguna-s-2.1 spent the whole output cap reasoning with think:false).
# Explicit efforts (e.g. DOCS_GEN_PHASE1_REASONING=low) are sent as
# reasoning_effort. auto = send, and if a model rejects it (non-thinking models
# 400 on any effort but "none") retry once without it and remember the model;
# always = send, never fall back; never = never send reasoning_effort.
# LOCAL_GEMMA_SEND_REASONING_EFFORT=auto

# --- Local serving per machine (#332) ----------------------------------------
# Stand up OpenAI-compatible local serving on each box and point local-gemma at
# it. FULL operator runbook (start commands + fallback ladder + how to measure
# limits): docs/ops/local-serving.md. Verify any endpoint with the smoke test:
#   node scripts/local-llm/smoke-test.mjs --base <url> --model <id>
#
# RULES (enforced by validateLocalProviderUrl in server/src/lib/ai/config.ts):
#   • LOCAL_GEMMA_BASE_URL MUST end in /v1.
#   • Host MUST be loopback or RFC-1918/private. Public hosts are REFUSED. For the
#     cross-machine case use the serving box's private LAN IP, or an SSH tunnel to
#     loopback (ssh -N -L 8000:localhost:8000 user@<lan-ip>).
#
# ⚠️  Do NOT use gemma4:12b for local doc-gen — it is a REASONING model and returns
#     EMPTY content at low max_tokens (finish_reason: length). Prefer a clean
#     INSTRUCT model (qwen2.5:14b, or Qwen3-14B with thinking disabled).
#
# Mac (Apple M4 Pro, 24 GB) — Ollama on Metal (24 GB is below MLX's 32 GB floor):
# AI_PROVIDER=local-gemma
# LOCAL_GEMMA_BASE_URL=http://localhost:11434/v1
# LOCAL_GEMMA_MODEL=qwen2.5:14b
# LOCAL_GEMMA_API_KEY=ollama
#
# PC (2× RTX 3060 12 GB, no NVLink) — vLLM tensor-parallel, default port 8000:
#   vllm serve Qwen/Qwen3-32B-AWQ --tensor-parallel-size 2 \
#     --gpu-memory-utilization 0.92 --max-model-len <measured>
#   fallback A: --pipeline-parallel-size 2   fallback B: single-card Qwen/Qwen3-14B-AWQ
# AI_PROVIDER=local-gemma
# LOCAL_GEMMA_BASE_URL=http://localhost:8000/v1     # or http://<pc-lan-ip>:8000/v1 cross-machine
# LOCAL_GEMMA_MODEL=Qwen/Qwen3-32B-AWQ
# LOCAL_GEMMA_API_KEY=ollama                        # or the real --api-key set on vLLM

# --- Native Anthropic provider (#285) ----------------------------------------
# First-class Anthropic Messages API via the official @anthropic-ai/sdk. This is
# distinct from the Bedrock path: it talks directly to api.anthropic.com using
# BARE model ids (claude-opus-4-8 / claude-sonnet-4-6 / claude-haiku-4-5), NOT
# the Bedrock `us.anthropic.*` form. Chat/stream only — embeddings stay on the
# existing embeddings backend (Anthropic has no embeddings API).
#
# AUTH / SUBSCRIPTION CAVEAT:
#   • SUPPORTED: an Anthropic API key (console.anthropic.com, pay-per-token) via
#     ANTHROPIC_API_KEY, or a developer OAuth token via ANTHROPIC_AUTH_TOKEN.
#   • NOT SUPPORTED: a personal Claude Pro/Max (claude.ai) subscription or Claude
#     Code OAuth credentials. That licence covers Claude.ai / Claude Code only;
#     using it programmatically in a third-party server violates Anthropic's
#     consumer terms. Do not attempt to reuse subscription credentials here.
#
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-replace-me
# Optional developer OAuth token (alternative to the API key).
# ANTHROPIC_AUTH_TOKEN=replace-me-oauth-token
# Optional base URL override (defaults to the SDK's https://api.anthropic.com).
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Optional bare default model (default: claude-sonnet-4-6). AI_DEFAULT_MODEL /
# AI_MODEL also override this if set.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Documentation generator tuning (Epic #108, optional) --------------------
# The two-phase doc generator has OPTIMIZED DEFAULTS per provider; the BEDROCK_*
# and LOCAL_* namespaces are fully independent (switching AI_PROVIDER never lets
# one provider's settings affect the other). All keys below are OPTIONAL.
#
# Cross-provider CLAIM-EXTRACTION model (#701). UNSET by default → the
# per-provider Haiku default is kept, which is the cost-optimal choice: claim
# extraction's output:input ratio (~0.47) far exceeds the 0.07 ceiling below
# which cached-Sonnet could ever beat uncached-Haiku (see docs/OPERATIONS.md
# §7.5). Set to a Sonnet id ONLY to flip claim extraction onto cached-Sonnet for
# a workload proven cheaper by the #699 cache-telemetry endpoint. Rollback =
# unset. Provider-specific DOCS_GEN_*_CLAIM_MODEL / DOCS_GEN_GROUNDING_MODEL win.
# DOCS_GEN_CLAIM_MODEL=us.anthropic.claude-sonnet-4-6
#
# #157 — Business Rules, Key Workflows, Calculations and Data Model are written
# in BATCHES that together read every relevant module, each sized to finish
# within the section output cap. Default ON. Set to 0 to fall back to one call
# per section over the modules that fit the facts cap: much faster on a local
# model, but those sections may be cut off and skip modules.
# DOCS_GEN_BATCHED_SECTIONS=1
#
# OUTPUT cap (max_tokens) for one grounding CLAIM-EXTRACTION call (#152).
# Previously claim extraction reused DOCS_GEN_SECTION_MAX_OUTPUT_TOKENS. Sections
# are sent in passages of about 8,000 characters, and a passage whose claim list
# still stops at the cap is split and asked again, so raise this only when a
# section's warning says its claim list "exceeded its output cap". Clamped to the
# claim model's known output ceiling; an unknown (e.g. local) model defaults to
# 8192. Also settable at runtime from the admin settings page.
# DOCS_GEN_CLAIM_MAX_OUTPUT_TOKENS=16384
#
# Bedrock gateway (large ~200K context, paid, prompt-caching):
# DOCS_GEN_BEDROCK_PHASE1_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# DOCS_GEN_BEDROCK_PHASE2_MODEL=us.anthropic.claude-sonnet-4-6
# DOCS_GEN_BEDROCK_FACTS_CHAR_CAP=150000
# DOCS_GEN_BEDROCK_TEMPERATURE=0.2
#
# local-gemma / Ollama (small context, free, single-slot). Phase 1 = fast
# extraction model, Phase 2 = stronger synthesis model.
#
# #337 — RIGHT-SIZE THESE TO THE SERVED MODEL. Full runbook + derivation table +
# per-model recommended values: docs/ops/local-serving.md (§ "Right-sizing the
# doc-gen tuning knobs"). Key rules:
#  - FACTS_CHAR_CAP must fit the served model's EFFECTIVE window, or Phase-2
#    sections context-shift to EMPTY. Set OLLAMA_CONTEXT_LENGTH (Ollama defaults
#    to a tiny 2048!) or vLLM --max-model-len, then size the cap to ~80% of
#    (window - system_prompt - output) * ~3.3 chars/token. Floor is 4000.
#    e.g. 32K window -> 48000 (default); tight 8K vLLM TP=2 window -> 6000.
#    When facts exceed the cap the run now logs a warning AND marks the doc
#    `degraded` (facts-truncated) so the truncation is observable, not silent.
#  - TEMPERATURE is PER SERVED MODEL, not a blind 0. Unset, each phase's default
#    follows the family of the model THAT phase serves (#177): a `gemma` model
#    gets 1.0 / TOP_P 0.95,
#    any other or unknown model 0.2 / 0.95 (0.2 measured best for Phase-1
#    extraction on laguna-s-2.1). Both are always sent explicitly, because
#    Ollama's /v1 substitutes 1.0 for an omitted temperature or top_p.
#      * Gemma 3/4 (MoE): keep 1.0 / TOP_P 0.95 (model-card mandate; lower temp
#        makes MoE routing over-activate thinking and return EMPTY content).
#      * Dense instruct (Qwen2.5, Qwen3 w/ thinking off, Phi-4): 0 (or 0.1) for
#        faithful near-deterministic literal/reconstruction output.
#  - PHASE2 model must NOT be a reasoning model. gemma4:12b returns EMPTY content
#    via /v1 — use a clean instruct model (e.g. qwen2.5:14b). The verbose prompt
#    is default; CONCISE_PROMPT=1 only for terse summaries. REFINE adds a pass.
# DOCS_GEN_LOCAL_PHASE1_MODEL=gemma3:4b
# DOCS_GEN_LOCAL_PHASE2_MODEL=qwen2.5:14b
# DOCS_GEN_LOCAL_FACTS_CHAR_CAP=48000
# DOCS_GEN_LOCAL_TEMPERATURE=0
# DOCS_GEN_LOCAL_TOP_P=0.95
# DOCS_GEN_LOCAL_FREQ_PENALTY=0.1
# DOCS_GEN_LOCAL_CONCISE_PROMPT=0
# DOCS_GEN_LOCAL_REFINE=0
# Structured-output enforcement on the local/vLLM path (#336, #117). DEFAULT off.
# Values: json_schema | json_object | off  (1 = json_schema, 0 = off, as before).
#   json_schema — the JSON-shaped grounding calls (claim extraction, faithfulness
#     judge) request schema-constrained decoding via the OpenAI-compatible
#     `response_format: { type: "json_schema" }` field, which vLLM (>= 0.8.5) maps
#     to its xgrammar/guidance backend. Some runtimes accept the field with HTTP
#     200 and IGNORE it (measured: laguna-s-2.1 on Ollama 0.34.2 returns prose);
#     a reply that does not parse is retried once in json_object mode, and the
#     log says which mode succeeded.
#   json_object — JSON mode, `response_format: { type: "json_object" }`, with the
#     expected shape stated in the prompt. Use it for a runtime that ignores
#     json_schema but honours JSON mode (laguna-s-2.1 does); saves the wasted
#     json_schema call per grounding request.
# A runtime that rejects the field outright (400/422, or a 501 "structured output
# is unavailable" from Ollama's MLX engine, #176) is retried once WITHOUT it
# (never a hard failure); after a 501 the model is not sent the field again. A reply that still cannot be parsed marks the section
# "not fully verified" on the document instead of passing silently. Capability-
# gated to the local provider only; Bedrock/Anthropic never send it.
# DOCS_GEN_LOCAL_STRUCTURED_OUTPUT=off

# --- Hybrid per-section provider routing (doc-gen Phase 2) — #333 -------------
# DEFAULT OFF. When enabled, doc-gen routes each section group to a provider by
# its faithfulness TIER: literal (0.8) + reconstruction (0.6) sections → the
# LOCAL provider (high-volume, grounding-hardened), narrative (0.4) sections →
# the ESCALATION provider (Sonnet: native Anthropic if ANTHROPIC_API_KEY is set,
# else the Bedrock gateway). Phase-1 fact extraction is unchanged (always local/
# phase1). Routing activates ONLY when this flag is on AND BOTH a local
# (LOCAL_GEMMA_BASE_URL) and an escalation provider are configured; otherwise it
# falls back gracefully to the single configured provider (identical to OFF),
# logging why. The LOCAL_GEMMA_BASE_URL loopback/RFC-1918 guard still applies;
# the Sonnet provider uses its own public path (no cross-wiring). Per-provider
# DOCS_GEN_LOCAL_* / DOCS_GEN_ANTHROPIC_* / DOCS_GEN_BEDROCK_* tuning applies to
# whichever provider a section uses.
# DOCS_GEN_HYBRID_ROUTING=0

# --- Judge-gated escalation (doc-gen quality floor) — #334 --------------------
# DEFAULT OFF. INDEPENDENT of DOCS_GEN_HYBRID_ROUTING but only MEANINGFUL when
# hybrid routing is active AND an escalation provider is configured (it re-uses
# the #333 escalation provider). When enabled: after a section is generated on
# the LOCAL provider and scored by the faithfulness judge, if its score falls
# BELOW that section's tier threshold, the SAME section is re-run ONCE on the
# escalation (Sonnet/cloud) provider and the HIGHER-scoring output is kept (ties
# keep the escalated output — the cloud provider is the quality ceiling). A
# cloud section never escalates (nowhere to escalate to); an UNVERIFIED section
# never escalates ("unverified" is not "below the bar"). Every escalation is
# logged (section, local score, escalated score, decision) and counted so the
# escalation RATE and cost are observable. The cloud re-run's token usage is
# recorded in AITokenUsage under the escalation provider automatically.
# When hybrid routing is OFF or no escalation provider is configured this flag is
# a no-op (behavior identical to pre-#334).
# DOCS_GEN_JUDGE_ESCALATION=0
# Per-DOCUMENT cap on escalation re-runs (bounds cost; the per-SECTION cap is
# always exactly one — no loops). Default 3. Set to 0 to disable escalation via
# budget while leaving the flag on.
# DOCS_GEN_MAX_ESCALATIONS=3
#
# Flipping either default above ON is EVAL-GATED (#335): run the A/B rollout gate
# `pnpm eval:domain:ab` (local+escalation vs all-Sonnet over the same corpus) and
# attach the green JSON summary to the PR. The gate adds NO new env flags — it
# reads these two flags per arm. See docs/ops/local-serving.md §"Eval-gated
# rollout — the A/B gate (#335)".

# Application inference profile ARNs for per-app Bedrock COST ATTRIBUTION (#386/#387).
# When set, the BedrockDirectProvider swaps the matching model ID for the profile
# ARN before invoking the gateway, so spend lands under the application inference
# profile in AWS Cost Explorer. A profile WRAPS a foundation model + cost-allocation
# tags; it does NOT change the model and it does NOT pin a region. Cross-region
# routing (us-east-1 / us-east-2 / us-west-2) via the `us.anthropic.*` system
# inference profiles is INTENTIONAL and permitted by the gateway IAM; there is no
# us-east-1 residency lock.
# The model router (server/src/lib/ai/model-router.ts) routes to:
#   • General/default → Claude Sonnet 5  (cache min 1,024 tokens, no 1h TTL)
#   • Faster/cheaper  → Claude Haiku 4.5 (cache min 4,096 tokens, 1h TTL)
# The sonnet ARN is keyed to BEDROCK_MODEL (default `us.anthropic.claude-sonnet-5`);
# the haiku ARN is keyed to the full `us.anthropic.claude-haiku-4-5-20251001-v1:0`.
# If a cross-region model ID with no matching key reaches the gateway while a
# profile map is configured, the request still succeeds but its spend bypasses
# cost attribution and the provider emits a structured `warn` (model id +
# profileMapConfigured only — never the API key or the ARN).
# Bedrock's prompt-cache MINIMUM token threshold is model-specific; below it
# Bedrock silently does not cache (cached_tokens = 0). See the full profile →
# model → cache-min-token mapping in docs/OPERATIONS.md §7.5 Prompt Caching.
# Use PLACEHOLDER ARNs only — never commit real ARNs or AWS account ids.
# BEDROCK_SONNET_PROFILE=arn:aws:bedrock:us-east-1:ACCOUNT:application-inference-profile/PROFILE_ID
# BEDROCK_HAIKU_PROFILE=arn:aws:bedrock:us-east-1:ACCOUNT:application-inference-profile/PROFILE_ID
#
# OPTIONAL: BEDROCK_MODEL_PROFILES generalizes the two dedicated vars above to
# any number of models. It is a flat JSON object mapping a model id (the same
# ids the model router and /model-preferences API expose, e.g.
# `us.anthropic.claude-fable-5`, `us.anthropic.claude-opus-4-8`) to its
# application inference profile ARN. Entries here are merged with
# BEDROCK_SONNET_PROFILE/BEDROCK_HAIKU_PROFILE (those two still win for their
# respective model ids if both are set).
# BEDROCK_MODEL_PROFILES={"us.anthropic.claude-fable-5":"arn:aws:bedrock:us-east-1:ACCOUNT:application-inference-profile/PROFILE_ID","us.anthropic.claude-opus-4-8":"arn:aws:bedrock:us-east-1:ACCOUNT:application-inference-profile/PROFILE_ID"}
#
# OPTIONAL legacy override (informational — no dedicated env var or code path):
# To pin the older foundation model, point BEDROCK_SONNET_PROFILE at a profile
# that wraps Claude Sonnet 4.5. NOTE: Sonnet 4.5 carries the higher 4,096-token
# cache floor (and a 1h TTL), unlike the 1,024-token floor on the 5.0 default.

# --- Web Research search providers (#929) -------------------------------------
# The analysis web-research augmenter fetches external evidence through a
# pluggable provider. Choose one with WEB_SEARCH_PROVIDER. When unset, a legacy
# WEB_SEARCH_API_KEY (Tavily) is still honored. When nothing is configured or
# AI_OFFLINE=1, a no-op stub is used (keeps tests/e2e deterministic).
#   WEB_SEARCH_PROVIDER=tavily|brave|google|stub
# WEB_SEARCH_PROVIDER=stub

# Tavily (legacy / default real provider).
# WEB_SEARCH_API_KEY=replace-me-tavily-api-key

# Brave Search API (https://api.search.brave.com).
# BRAVE_SEARCH_API_KEY=replace-me-brave-subscription-token

# Google Programmable Search / Custom Search JSON API.
# GOOGLE_CSE_API_KEY=replace-me-google-api-key
# GOOGLE_CSE_ID=replace-me-cse-cx-id

# Corporate egress proxy: all web-search providers honor HTTPS_PROXY / HTTP_PROXY
# and bypass hosts listed in NO_PROXY (comma/space separated; '*' bypasses all).
# HTTPS_PROXY=http://corp-proxy:8080
# NO_PROXY=localhost,127.0.0.1,.internal.corp
#
# Future work (not implemented): an AWS-native Bedrock Knowledge Base web-crawler
# data source would egress from AWS rather than the corporate network.

# --- Impact Analysis AI enrichment (#1025) ------------------------------------
# The impact pipeline's deterministic core (code graph + schema crossing) makes NO
# AI calls. On top of it, four enrichment stages are ON BY DEFAULT and DO cost
# money: roughly 5 provider calls, ~12.5k tokens, ≈$0.05 and ~20 s per CHANGED
# REQUIREMENT against claude-sonnet-5 (a retry can reach ~$0.08 / ~28 s). Four of
# the five calls scale with the requirement count; the run overview is once per run.
# Spend is metered per project under agentStep = impact.<stage>.
#
# Each is an independent kill-switch — set to 0 (or false) to disable that stage.
# All four = 0 restores the deterministic-only behaviour: zero AI calls, zero cost.
# IMPACT_LLM_TABLE_FILTER=0      # prune tangential tables + per-table rationale
# IMPACT_LLM_ADDITIVE_DDL=0      # proposed ALTER TABLE … ADD COLUMN suggestions
# IMPACT_LLM_CLAUSE_RECONCILE=0  # "this analysis may be incomplete" advisories
# IMPACT_LLM_SUMMARY=0           # plain-English narratives (2 of the 5 calls)
#
# Opt-IN, and deliberately still off: both regressed table precision when measured.
# IMPACT_LLM_ENTITY_SEEDS=1      # 0.7626 -> 0.6909 precision; do not enable blindly
# IMPACT_LLM_SEEDING=1           # 0.42 -> 0.29 precision (#931)
#
# Hard per-call deadline for every stage above (ms); a non-positive/non-numeric
# value falls back to the default. There is no "off".
# IMPACT_LLM_TIMEOUT_MS=60000

# --- GitHub Integration -------------------------------------------------------
# Personal access token used for issue/PR automation in dev environments only
GITHUB_TOKEN=replace-me-github-token

# --- Phase 9: GitHub Publishing ----------------------------------------------
# Default GitHub API base URL. Override per-batch for GitHub Enterprise
# (e.g. https://github.example.com/api/v3). GHE hostnames must also appear in
# REPO_ALLOWED_HOSTS or DNS pinning will reject them.
GITHUB_DEFAULT_BASE_URL=https://api.github.com
# Inter-mutation delay between GitHub publish writes (R-F2: ≥1s ± jitter).
PUBLISH_RATE_LIMIT_DELAY_MS=1000
PUBLISH_RATE_LIMIT_JITTER_MS=200
# Secondary rate-limit exponential backoff (60s base → 600s cap, full jitter).
PUBLISH_SECONDARY_BACKOFF_BASE_MS=60000
PUBLISH_SECONDARY_BACKOFF_MAX_MS=600000
# Maximum retries per Octokit call.
PUBLISH_MAX_RETRIES=3
# Hard ceiling on total backoff time per batch (ms).
PUBLISH_BACKOFF_BUDGET_MS=1800000

# --- Server -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# --- UI -----------------------------------------------------------------------
# Server-side URL used by the Next.js API proxy. In Docker compose this must use
# the service DNS name (`http://server:4000/api`), while host-based `pnpm dev`
# can keep the localhost default.
METIS_API_URL=http://localhost:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# --- AGPL-3.0 §13 source offer (#1296) ----------------------------------------
# METIS is served over a network, so §13 obliges the running program to offer every
# remote user the Corresponding Source **of the version they are talking to**. The
# offer is served at `/source` and rendered in the footer on every page; these
# variables are what let it name a commit instead of answering "this deployment's
# exact commit is not identified".
#
# Set METIS_SOURCE_COMMIT at DEPLOY time to the sha the artifact was built from
# (`git rev-parse HEAD`). GIT_COMMIT and SOURCE_COMMIT are read as fallbacks, in that
# order, because several CI systems set one of them already. A value that is not a
# bare 7-40 character hex sha is ignored rather than displayed — an unexpanded
# `$GIT_SHA` template is the usual way this goes wrong, and falling through to the
# next variable is better than publishing the template.
#
# Leave it empty here: a checked-in default would be a commit sha that is wrong for
# every build, which is worse than an honest "unknown".
METIS_SOURCE_COMMIT=
# The UI reads its build-time copy through Next.js, which inlines NEXT_PUBLIC_* at
# `next build` — so this one is a BUILD argument, not a runtime variable. See
# Dockerfile.ui. The server's answer at /api/source wins once it arrives; this is
# what the page shows before that and if the server is unreachable.
NEXT_PUBLIC_METIS_SOURCE_COMMIT=
# Only for a MODIFIED deployment: §13 obliges you to offer YOUR Corresponding
# Source, not ours. Point these at your own public repository if you have changed
# METIS. Unset, both default to https://github.com/openzigs/metis.
# METIS_SOURCE_REPOSITORY_URL=https://github.com/your-org/your-metis
# NEXT_PUBLIC_METIS_SOURCE_REPOSITORY_URL=https://github.com/your-org/your-metis

# --- Phase 5: Documents + RAG -------------------------------------------------
# Where uploaded document blobs are stored (sharded by sha256 prefix).
UPLOAD_DIR=data/uploads
# Per-project vector tables (one JSON file per project).
LANCEDB_PATH=data/lancedb
# Embedding configuration (#783). LEAVE EMBED_MODEL UNSET to get the shipped
# default: Alibaba-NLP/gte-modernbert-base — 768-dim, CLS-pooled, q8 weights.
# That model+pooling is what #788 measured at 0.402 nDCG@10 on NL-requirement →
# code retrieval, vs 0.246 for the bge-small it replaced.
#
# `EMBED_MODEL=metis-offline-hash-v1` is NOT a HuggingFace model — it names the
# deterministic hash stub, and it now routes to the `offline` backend directly.
# (It used to be the shipped default here, was handed to the xenova backend, 401'd
# against the hub, and SILENTLY fell back to hash vectors: months of retrieval
# over meaningless numbers. That fallback is now opt-in — see
# EMBED_ALLOW_HASH_FALLBACK below.)
# EMBED_MODEL=

# --- Pluggable embedding backends (epic #930) --------------------------------
# Select the RAG embedding backend per deployment. NO single backend is
# mandated. Decision matrix + per-backend env vars: docs/EMBEDDINGS_BACKENDS.md
# Keys: offline | xenova | embeddinggemma | sidecar | bedrock | bedrock-sdk | openai
# Precedence: cfg.backend > AI_OFFLINE > EMBED_BACKEND > EMBED_MODEL=metis-offline-hash-v1
#             > EMBEDDINGS_MODE=sidecar > xenova
# EMBED_BACKEND=xenova
# EMBED_MODEL examples by backend (omit to use each backend's default):
#   xenova/sidecar → Alibaba-NLP/gte-modernbert-base     (768-dim, CLS) ← default
#   embeddinggemma → onnx-community/embeddinggemma-300m-ONNX (768-dim, Matryoshka)
#   bedrock(-sdk)  → amazon.titan-embed-text-v2:0        (1024-dim)
#   openai         → text-embedding-3-small              (1536-dim)
# Override embedding dimension. Honoured by the embeddinggemma backend (Matryoshka
# truncation) and used to size a fresh vector table; the xenova/sidecar dimension
# otherwise follows the model (768). Changing it requires a project reindex via
# Admin → Embedding backends — see epic #937.
# EMBED_DIM=768
#
# --- Hash fallback: OPT-IN (#783) --------------------------------------------
# When the xenova/sidecar backend fails to load, the embedder FAILS LOUD: it
# throws, /readyz reports embeddings=error (503), and Admin → Embedding backends
# shows the error. It does NOT quietly substitute the hash stub, because hash
# vectors are non-semantic, they look completely normal in the database, and
# nothing downstream reports the degradation.
#
# Set this ONLY for local dev / genuinely offline work where useless vectors beat
# no service. The fallback is then flagged as DEGRADED in /readyz and the admin
# panel — it is never silent again.
# EMBED_ALLOW_HASH_FALLBACK=1
#
# --- Pooling + quantization for the local runtimes (#782) --------------------
# POOLING MUST MATCH THE MODEL. Mean-pooling a CLS model returns a valid-looking
# but semantically degraded vector (no error!), which silently drops hybrid
# retrieval to BM25-only quality. Resolved per model:
#   gte-modernbert* / granite-embedding* → cls
#   embeddinggemma* / bge* / jina* / *minilm* → mean
# Precedence: /embed request field > EMBED_POOLING_MAP > built-in map >
#             EMBED_POOLING > mean
#
# !! CHANGING POOLING ON AN ALREADY-INDEXED MODEL REQUIRES A FULL REINDEX. !!
# Pooling is part of the INDEX CONTRACT: stored vectors carry the pooling they
# were built with, but chunk reuse is keyed on the MODEL ID ALONE. Flipping this
# on a live deployment leaves your CLS queries searching a mean-pooled corpus —
# silently, with no error and no reindex trigger. Treat it like a model change.
# (Mechanical enforcement is tracked in #792.)
#
# A malformed value here fails at PROCESS START (crashloop), not per request.
# EMBED_POOLING=mean
# EMBED_POOLING_MAP=acme/custom-embedder=cls,other/model=mean
#
# ONNX weight dtype: q8 (default, ~150 MB) | fp32 (~600 MB, 4x RAM).
# MUST match the dtype the image baked — both Dockerfiles take EMBED_DTYPE as a
# build arg and bake with it, so change it at BUILD time
# (`--build-arg EMBED_DTYPE=fp32`), not only at deploy time, or an
# HF_HUB_OFFLINE=1 image will look for weights it never baked.
# EMBED_DTYPE=q8
#
# Where the in-process model runs (#189): worker (default) runs inference in a
# worker_thread so embedding never blocks the event loop; inline runs it on the
# calling thread (tests only — it froze the server during large ingests).
# A malformed value fails loudly.
# EMBED_INPROCESS_RUNTIME=worker
#
# In-process Xenova / EmbeddingGemma air-gapped bundle (#936/#939):
#   HF_HUB_OFFLINE=1 loads baked weights only and FAILS LOUD if the cache is
#   missing (no silent download, no hash fallback). Pre-populate the cache with
#   `pnpm --filter @metis/server prefetch:embeddings` before enabling offline,
#   then re-run it WITH HF_HUB_OFFLINE=1 to verify the cache actually serves the
#   model (that run loads from disk only and exits non-zero if it cannot).
#   TRANSFORMERS_OFFLINE / EMBEDDINGS_OFFLINE are equivalent aliases; any one of
#   the three is enough, and both the server and the sidecar honour all three.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_CACHE=/app/.cache/huggingface
#
# Internal HuggingFace mirror (#784) — for corp networks where huggingface.co is
# blocked or 401s (Node's fetch ignores HTTPS_PROXY, so a proxy will not save
# you). Must serve the standard hub layout ({endpoint}/{model}/resolve/{rev}/…).
# transformers.js itself reads NO env vars: METIS maps this onto env.remoteHost.
# Ignored when an offline flag is set — an air-gapped process fetches from
# nowhere, mirror included. An invalid value fails at PROCESS START.
# Also accepted as a build arg: `docker build --build-arg HF_ENDPOINT=… `.
#
# This setting decides where EXECUTABLE ONNX graphs are downloaded from, and
# transformers.js verifies no checksum, revision pin or signature on them. So the
# value is parsed, not pattern-matched, and rejected at boot when it embeds
# credentials (they leak into build logs — use a proxy or an injected
# Authorization header), carries a query string/fragment (the "{model}/resolve/…"
# path template is concatenated onto it), or is not absolute http(s).
# HF_ENDPOINT=https://hf-mirror.corp.example
#
# Plaintext http:// mirrors are REFUSED unless you accept the risk explicitly:
# anyone on-path can substitute the model the process loads. Prefer https://.
# HF_ENDPOINT_ALLOW_INSECURE=1
#
# Amazon Bedrock — Access Gateway (#932):
# The embeddings backend reuses the canonical gateway vars below (the same ones
# the generative Bedrock path uses); the EMBEDDINGS_BEDROCK_* keys are optional
# aliases that take precedence only when set.
# BEDROCK_GATEWAY_URL=http://localhost:8080
# BEDROCK_GATEWAY_API_KEY=replace-me-gateway-api-key
# EMBEDDINGS_BEDROCK_URL=http://localhost:8080
# EMBEDDINGS_BEDROCK_API_KEY=replace-me-gateway-api-key
# Amazon Bedrock — AWS SDK (#933): uses the standard AWS credential chain.
# AWS_REGION=us-east-1
# OpenAI / Azure OpenAI (#934):
# EMBEDDINGS_OPENAI_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_OPENAI_API_KEY=replace-me-openai-key
# EMBEDDINGS_OPENAI_API_VERSION=2024-02-01
#
# Remote backends (bedrock gateway, openai / azure) honour the standard
# HTTPS_PROXY / HTTP_PROXY / NO_PROXY env vars for firewalled / air-gapped
# deployments — requests route through an undici ProxyAgent when these are set.

# RAG chunker tuning (in characters).
# RAG_CHUNK_OVERLAP is CAPPED at a quarter of RAG_CHUNK_SIZE (512 here) and is
# silently reduced above that, with a warning logged once at startup naming the
# requested and effective values (#1185). Above the cap the chunker's window advance
# collapses to one character per step and ingest emits — and embeds — a huge run of
# near-duplicate chunks: 2048/2047 turned docs/ARCHITECTURE.md into 222,917 chunks.
RAG_CHUNK_SIZE=2048
RAG_CHUNK_OVERLAP=256
# Docs-gen grounding: RAG chunks retrieved PER SECTION when generating business/
# architecture/user-guide docs (Issue #264). Default 40, clamped to [1, 50].
# DOCS_GROUNDING_K=40
# Document upload rate limiter (requests / window in ms).
UPLOAD_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
# Knowledge retrieval rate limiter (requests / window in ms).
RETRIEVE_RATE_LIMIT_MAX=60
RETRIEVE_RATE_LIMIT_WINDOW_MS=60000

# --- Embeddings sidecar (issue #145) -----------------------------------------
# In production the @huggingface/transformers + onnxruntime-node runtime lives in
# a separate `metis-embeddings` container so the main metis-server image can
# stay slim. The server reaches it over token-authenticated HTTP.
#
# `EMBEDDINGS_MODE`:
#   - `sidecar`     — POST to EMBEDDINGS_URL for /embed and /rerank (prod default)
#   - `in-process`  — load Xenova directly inside metis-server (dev/test default)
#   - unset         — auto: tests/AI_OFFLINE → in-process, NODE_ENV=production → sidecar
EMBEDDINGS_MODE=
# Base URL of the embeddings sidecar.
EMBEDDINGS_URL=http://embeddings:5050
# 32+ byte shared secret for `Authorization: Bearer ...`. Sidecar fail-closes
# (returns 503) when unset, so this MUST be set in any production deployment.
EMBEDDINGS_TOKEN=
# Per-request HTTP timeout against the sidecar.
EMBEDDINGS_TIMEOUT_MS=60000
# Retry attempts on 5xx. 4xx are surfaced as terminal errors.
EMBEDDINGS_MAX_ATTEMPTS=3
# (Sidecar process only) port + host the sidecar binds to.
EMBEDDINGS_PORT=5050
EMBEDDINGS_HOST=0.0.0.0
# (Sidecar process only) on-disk model cache; survives container restarts via
# a named volume mounted at this path.
EMBEDDINGS_CACHE_DIR=/var/cache/metis-embeddings

# --- Issue #180: Optional copilot-native sidecar -----------------------------
# When set to `sidecar`, the main server proxies all `@github/copilot-sdk`
# calls through the `copilot-svc` container instead of running the SDK
# in-process. Tests + AI_OFFLINE always stay in-process regardless.
#   - `sidecar`     — POST to COPILOT_NATIVE_BASE_URL
#   - unset / other — keep the SDK in the main process (default)
COPILOT_NATIVE_MODE=
# Base URL of the copilot sidecar — internal only, do not expose to the host.
COPILOT_NATIVE_BASE_URL=http://copilot:5060
# 32+ byte shared secret for `Authorization: Bearer ...`. Sidecar fails closed
# (returns 503) when unset; the server's RemoteCopilotClient refuses to start
# without it.
COPILOT_NATIVE_TOKEN=
# Per-request HTTP timeout against the sidecar (ms).
COPILOT_NATIVE_TIMEOUT_MS=30000
# Streaming `/sessions/:id/send` timeout (ms). Long because model responses
# can run for minutes.
COPILOT_NATIVE_SEND_TIMEOUT_MS=300000
# (Sidecar process only) port + host the sidecar binds to.
COPILOT_NATIVE_PORT=5060
COPILOT_NATIVE_HOST=0.0.0.0
# (Sidecar process only) idle session TTL — the registry destroys sessions
# that have not been touched within this window. Default 30 minutes.
COPILOT_NATIVE_SESSION_TTL_MS=1800000

# --- Phase 6: MCP Server Registry --------------------------------------------
# Comma-separated allow-list of hostnames the platform may connect to for
# http/sse MCP transports. Loopback hosts are refused in production unless
# they appear here OR MCP_ALLOW_LOOPBACK=1 is set.
MCP_ALLOWED_HOSTS=
# Allow loopback MCP URLs (127.0.0.1/localhost) in production. Default 0.
MCP_ALLOW_LOOPBACK=0
# When 1, /readyz reports MCP as `degraded` (not `error`) if some servers are
# unhealthy as long as at least one is ready. Default: any error fails readiness.
MCP_HEALTH_ALLOW_PARTIAL=0
# Local-dev wrapper images accepted by docker-stdio and k8s-sse MCP runtimes.
# Production deployments should narrow this to digest-pinned images.
MCP_IMAGE_ALLOWLIST=ghcr.io/metis-mcps/**

# --- Phase 7: Multi-Agent Analysis Pipeline ----------------------------------
# Hard cap on the total tokens consumed by analysis runs in the current UTC
# month. Set to 0 to disable enforcement entirely.
ANALYSIS_MONTHLY_TOKEN_CAP=5000000
# Informational ceiling per individual specialist agent run; provider-level
# rate limits are the real enforcement boundary.
ANALYSIS_AGENT_TOKEN_CAP=80000
# Optional persona overrides — one set per agent (DOCUMENT|CODE|DATABASE|WEB|
# SYNTHESIS). The defaults map to the BMAD-style cast (Mary/Winston/Sally/
# Quinn/Synthesis) and are good enough for production. Uncomment to override.
# ANALYSIS_PERSONA_DOCUMENT_NAME=Mary
# ANALYSIS_PERSONA_DOCUMENT_ROLE=Business Analyst
# ANALYSIS_PERSONA_DOCUMENT_AVATAR=📄
# ANALYSIS_PERSONA_DOCUMENT_DESCRIPTION=Reads scope documents and extracts user-facing requirements.
# ANALYSIS_PERSONA_CODE_NAME=Winston
# ANALYSIS_PERSONA_CODE_ROLE=Solutions Architect
# ANALYSIS_PERSONA_CODE_AVATAR=🏗️
# ANALYSIS_PERSONA_CODE_DESCRIPTION=Reviews source code for architectural concerns and tech debt.
# ANALYSIS_PERSONA_DATABASE_NAME=Sally
# ANALYSIS_PERSONA_DATABASE_ROLE=Product Owner
# ANALYSIS_PERSONA_DATABASE_AVATAR=🗄️
# ANALYSIS_PERSONA_DATABASE_DESCRIPTION=Inspects schemas and data flow for consistency and compliance.
# ANALYSIS_PERSONA_WEB_NAME=Quinn
# ANALYSIS_PERSONA_WEB_ROLE=QA Lead
# ANALYSIS_PERSONA_WEB_AVATAR=🌐
# ANALYSIS_PERSONA_WEB_DESCRIPTION=Probes web surfaces and references for behaviour gaps.
# ANALYSIS_PERSONA_SYNTHESIS_NAME=Synthesis
# ANALYSIS_PERSONA_SYNTHESIS_ROLE=Reviewer
# ANALYSIS_PERSONA_SYNTHESIS_AVATAR=🧩
# ANALYSIS_PERSONA_SYNTHESIS_DESCRIPTION=Merges specialist findings into deduplicated requirements.

# Epic #725 grounding for the analysis agents. Both default to ENABLED as of
# #752 (they were shipped OFF behind a flag; #750 restored the agentic /
# requirement-grounded code paths that make them worthwhile). Set either to
# `false` to restore the pre-#729 / pre-#732 byte-identical behaviour.
#   • ANALYSIS_FUSED_CODE_RETRIEVAL — passive code-graph symbol grounding for
#     Winston (the code agent) in all three modes. Adds one code-graph query +
#     up to ANALYSIS_FUSED_CODE_TOKEN_BUDGET (default 1500) tokens carved OUT of
#     the agent budget (not additive). No-op when the project has no code graph.
#   • ANALYSIS_SCHEMA_CONTEXT — live read-only DB-schema grounding for Sally
#     (the database agent). Adds up to ANALYSIS_SCHEMA_CONTEXT_TOKEN_BUDGET
#     (default 2000) tokens. No-op when the project has no DB connector.
# ANALYSIS_FUSED_CODE_RETRIEVAL=false
# ANALYSIS_FUSED_CODE_TOKEN_BUDGET=1500
# ANALYSIS_FUSED_CODE_MAX_SYMBOLS=12
# ANALYSIS_SCHEMA_CONTEXT=false
# ANALYSIS_SCHEMA_CONTEXT_TOKEN_BUDGET=2000
# ANALYSIS_SCHEMA_CONTEXT_MAX_TABLES=60

# --- Phase 8: Repo + Database Connectors --------------------------------------
# Comma-separated host allow-lists for outbound connector traffic.
# Empty = allow any (NOT recommended in production). Wildcards: *.example.com
REPO_ALLOWED_HOSTS=
DB_ALLOWED_HOSTS=
# Where shallow repo clones are written (tmp dir if unset).
REPO_CLONE_DIR=
# Hard cap (BYTES) on a shallow repo clone's on-disk size, enforced after a
# --depth=1 --single-branch clone. Default 104857600 (100 MiB). Raise this to
# deep-ingest a larger repository (e.g. 157286400 = 150 MiB); note it raises the
# disk/memory a single ingest may consume. Invalid/non-positive values fall back
# to the default.
REPO_CLONE_MAX_BYTES=
# Issue #288 — local-directory ("local" provider) ingestion allowlist.
# OS-path-list (":" on POSIX, ";" on Windows) of ABSOLUTE directories the server
# may ingest from. DEFAULT-DENY: when unset/empty the feature is disabled. A
# user path must realpath into one of these roots (no `..`/symlink escapes).
# Creating a "local" connector also requires the admin role.
LOCAL_SOURCE_ROOTS=
# Issue #288 — folder upload (".zip", "upload" provider). Where uploaded archives
# and their extractions are written. Issue #329: these now default to PERSISTENT
# app-data dirs (<cwd>/data/repo-archives and <cwd>/data/repo-extracts) rather
# than the OS temp dir, so a stored archive survives an OS temp purge and
# re-ingest can re-extract without requiring re-upload. Override to a mounted
# volume in production. The max upload size (compressed) is fixed at 50 MiB;
# archives are also capped on total/per-file uncompressed bytes and entry count
# to prevent zip bombs. NOTE: like REPO_CLONE_DIR / UPLOAD_DIR (local backend),
# these are per-pod local dirs and are not shared across replicas.
UPLOAD_ARCHIVE_DIR=
UPLOAD_EXTRACT_DIR=
# When true, allow connectors to point at 127.0.0.1 / localhost (dev only).
CONNECTOR_ALLOW_LOOPBACK=false
# Comma-separated PII patterns to disable in the redactor (e.g. ssn,email).
PII_REDACT_DISABLE_PATTERNS=

# Phase 10 — Skills + Agents library auto-discovery.
# When set to an absolute path, the server walks {root}/.github/skills and
# {root}/.github/agents at boot (test env skipped) and imports any new
# definitions into the library. Failures are audited, never thrown.
LIBRARY_AUTO_DISCOVER_ROOT=
# Issue #1075 — allow-list for the per-project skill directories written via
# POST /api/projects/:projectId/skill-directories (admin-only, `skill.manage`).
# OS-path-list (":" on POSIX, ";" on Windows) of directories the SKILL.md
# scanner may be pointed at; a relative entry resolves against the server
# package root. When unset it defaults to <server>/data/skills, i.e. the
# feature is confined to METIS's own data tree rather than the whole
# filesystem. Entries stored before this setting existed, or left outside the
# roots after narrowing them, are reported as errors by GET
# /skill-directories instead of being scanned. Same shape as
# LOCAL_SOURCE_ROOTS above.
SKILL_DIRECTORIES_ALLOWED_ROOTS=

# --- Phase 11: Scheduler + Tasks ---------------------------------------------
# Master kill switch — when 0/false the boot path skips scheduler.start().
SCHEDULER_ENABLED=1
# Maximum tasks running concurrently across the whole queue.
SCHEDULER_CONCURRENCY=4
# Dispatcher tick — drives pending->running promotion and the lastTickAt
# health metric. Floor 100ms.
SCHEDULER_TICK_MS=1000
# Default per-task timeout when a handler doesn't supply one (5 min).
SCHEDULER_DEFAULT_TIMEOUT_MS=300000
# Initial retry backoff after a handler failure; doubles each attempt.
SCHEDULER_RETRY_BACKOFF_MS=1000
# Cap for the exponential retry backoff (1 min).
SCHEDULER_RETRY_BACKOFF_MAX_MS=60000
# Reject cron expressions that fire more often than this many seconds.
SCHEDULER_MIN_CRON_INTERVAL_SEC=60

# --- Phase 11: HTTP webhook task handler -------------------------------------
# Comma-separated allow-list of hostnames the http-webhook task may POST to.
# An empty list means NO external webhooks are permitted.
WEBHOOK_ALLOWED_HOSTS=
# Maximum outbound JSON body size (default 64 KiB).
WEBHOOK_MAX_BYTES=65536
# Outbound request timeout in milliseconds (default 10s).
WEBHOOK_TIMEOUT_MS=10000
