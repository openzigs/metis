    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "^7.8.0",
    "@slack/bolt": "4.7.3",
    "@slack/web-api": "^7.17.0",
    "@tree-sitter-grammars/tree-sitter-kotlin": "1.1.0",
