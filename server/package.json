    "jszip": "^3.10.1",
    "katex": "^0.16.45",
    "ldapts": "^8.1.8",
    "mammoth": "^1.12.0",
    "marked": "^18.0.3",
    "mermaid": "^11.14.0",
    "minisearch": "^7.2.0",
    "multer": "^2.3.0",
    "mysql2": "^3.22.3",
    "node-sql-parser": "^5.4.0",
    "nodemailer": "^9.1.1",
    "officeparser": "^6.1.1",
    "openid-client": "^6.8.4",
    "p-queue": "^9.2.0",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "playwright-core": "^1.59.1",
    "prisma": "^7.8.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^25.8.0",
    "safe-regex2": "^5.1.1",
    "semver": "^7.8.0",
    "simple-git": "^3.36.0",
    "socket.io": "^4.8.3",
    "tree-sitter-c-sharp": "0.23.1",
    "tree-sitter-go": "0.23.4",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-python": "0.23.6",
    "tree-sitter-typescript": "0.23.2",
    "ulid": "^3.0.2",
    "undici": "^8.10.2",
    "vectordb": "^0.21.2",
    "web-tree-sitter": "0.24.4",
    "winston": "^3.19.0",
    "ws": "^8.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/semver": "^7.7.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@xmldom/xmldom": "^0.8.15",
    "micromark": "4.0.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
