{
  "name": "@metis/server",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../scripts/restore-corpus-doc-snapshots.mjs && vitest run",
    "test:coverage": "node ../scripts/restore-corpus-doc-snapshots.mjs && vitest run --coverage",
    "test:integration": "RUN_INTEGRATION_TESTS=1 vitest run --config vitest.integration.config.ts",
    "lint": "eslint src --max-warnings=0",
    "prisma": "prisma",
    "db:generate": "prisma generate",
    "db:gen-postgres": "bash ../scripts/gen-postgres-schema.sh",
    "db:gen-postgres:check": "bash ../scripts/gen-postgres-schema.sh && git diff --exit-code prisma/postgres/schema.prisma",
    "db:migrate:postgres": "prisma migrate deploy",
    "agents-md:write": "tsx src/lib/agents-md/cli.ts",
    "mcp:test": "tsx src/lib/mcp/cli.ts",
    "migrate:link-sso": "tsx src/lib/auth/migrate-link-sso.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "rag:eval": "tsx scripts/rag-eval.ts",
    "eval:domain": "tsx scripts/eval-domain.ts",
    "eval:domain:ab": "tsx scripts/eval-hybrid-ab.ts",
    "eval:codegraph": "tsx scripts/eval-codegraph.ts",
    "eval:reqmap": "tsx scripts/eval-reqmap.ts",
    "eval:impact-recall": "tsx scripts/eval-impact-recall.ts",
    "eval:verification": "tsx scripts/eval-verification.ts",
    "eval:harvest-feedback": "tsx scripts/harvest-feedback.ts",
    "eval:embed-retrieval": "tsx scripts/eval-embed-retrieval.ts",
    "eval:doc-retrieval": "tsx scripts/eval-doc-retrieval.ts",
    "eval:answer-correctness": "tsx --env-file-if-exists=../.env scripts/eval-answer-correctness.ts",
    "eval:docs-gen": "tsx --env-file-if-exists=../.env scripts/eval-docs-gen.ts",
    "prefetch:embeddings": "tsx scripts/prefetch-embeddings-model.ts",
    "embeddings:smoke": "tsx --env-file-if-exists=../.env scripts/embed-smoke.ts",
    "red-team": "tsx scripts/red-team.ts",
    "dr:check": "tsx --env-file=../.env scripts/dr-check.ts",
    "embeddings:migrate": "tsx --env-file=../.env scripts/embed-migrate.ts",
    "backfill:leaked-markers": "tsx --env-file-if-exists=../.env scripts/backfill-leaked-markers.ts",
    "facts:purge-truncated": "tsx --env-file-if-exists=../.env scripts/purge-truncated-facts.ts",
    "verify:cache": "tsx --env-file=../.env scripts/verify-prompt-cache.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.104.2",
    "@aws-sdk/client-cost-explorer": "^3.700.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@github/copilot-sdk": "^0.3.0",
    "@kubernetes/client-node": "^1.4.0",
    "@metis/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@node-saml/passport-saml": "^5.1.0",
    "@octokit/rest": "^22.0.1",
    "@opentelemetry/api": "^1.9.1",
