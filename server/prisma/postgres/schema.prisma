// Epic #249 / Issue #253 — runtime-config write audit log.
// Every write to a Tier-2 (vault secret) or Tier-3 (runtime tunable) config
// key inserts a row here. Tier-1 (bootstrap) writes are rejected upstream and
// never audited. Sensitive keys store both old and new values as `[REDACTED]`.
model ConfigAudit {
  id               String   @id @default(cuid())
  key              String
  oldValueRedacted String
  newValueRedacted String
  actorId          String
  scope            String   @default("global")
  ts               DateTime @default(now())

  @@index([key, ts])
  @@index([actorId, ts])
  @@map("config_audit")
}

// Epic #249 / Issue #254 — Tier-3 runtime tunables backing store.
// Each row holds a single `key`/`value` pair; the `valueType` discriminator
// tells `ConfigService` how to coerce the persisted string back into its
// typed shape. Bootstrap (Tier 1) and secret (Tier 2) keys are NEVER stored
// here — secrets live in the encrypted Vault, bootstrap stays in `.env`.
model RuntimeConfig {
  key         String   @id
  value       String
  valueType   String // string | int | bool | json | csv
  scope       String   @default("global")
  updatedById String
  updatedAt   DateTime @updatedAt

  updatedBy User @relation(fields: [updatedById], references: [id])

  @@index([scope])
  @@map("runtime_config")
}

