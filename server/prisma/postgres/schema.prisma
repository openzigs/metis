  monthlyBudgetCents Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  members           WorkspaceMember[]
  invites           WorkspaceInvite[]
  projects          Project[]
