  /// against `DATABASE_AWARE_ANALYSIS_SETTINGS`
  /// (`packages/shared/src/schema-impact.ts`) at the service/route layer.
  /// This issue (#853) is schema-only — the resolver (env kill-switch +
  /// schema-data presence) and threading into the run/gap-report paths land
  /// in #854/#855/#856; the settings API lands in #857.
  databaseAwareAnalysis String @default("auto")

  /// Epic #882 (#894) — per-project opt-in for the non-ORM SQL-lineage
  /// extraction pass (embedded SQL / SAS PROC SQL / routine bodies /
  /// Tier-1 catalog dependencies), mirroring `databaseAwareAnalysis` above.
  /// Replaces sole reliance on the hidden global `SQL_LINEAGE_MODE` env flag.
  /// Legal values: `auto` (default) | `on` | `off`.
  ///   - `auto` defers to the platform default (`SQL_LINEAGE_MODE=sidecar`) —
  ///     byte-identical to pre-#894 behavior.
  ///   - `on` / `off` are explicit per-project overrides, always reachable
  ///     regardless of the platform env flag.
  /// `String` column (not a Prisma `enum`) for sqlite/postgres twin
  /// portability, matching `databaseAwareAnalysis`. Validated against
  /// `SQL_LINEAGE_SETTINGS` (`packages/shared/src/schema-impact.ts`) at the
  /// service/route layer.
  sqlLineage String @default("auto")

  @@index([status])
  @@index([createdById])
  @@index([workspaceId])
  @@map("projects")
}

// ============================================================================
// FinOps + Safety (Epic #164 — v1.1.0)
// ============================================================================
/// Per-project, per-call token + cost telemetry. One row per provider call.
/// `costCents` is computed at insert time using the static rate map in
/// `lib/finops/provider-rates.ts`. Indexed by (projectId, createdAt) for fast
/// MTD aggregation in the budget enforcer + cost projection.
model TokenUsage {
  id               String   @id @default(cuid())
  projectId        String
  sessionId        String?
  provider         String
  model            String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costCents        Int      @default(0)
  createdAt        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("token_usages")
}

// ============================================================================
// Epic #47 — FinOps: forecasting, alerting, chargeback (Issues #48–#54)
// ============================================================================

/// Issue #48 — persisted time-series cost forecast. One row per
/// (workspace, optional project) per `computedAt` run. The nightly job writes
/// the latest projection so the alert engine + UI read it without recomputing.
/// `scope` is "workspace" (projectId null) or "project" (projectId set).
model CostForecast {
  id                     String   @id @default(cuid())
  workspaceId            String
  /// Null for a workspace-level forecast; set for a per-project forecast.
  projectId              String?
  scope                  String // workspace | project
  /// Month-to-date actual cost in integer cents at compute time.
  monthToDateCents       Int      @default(0)
  /// Blended OLS+EWMA projected month-end cost in integer cents.
  projectedMonthEndCents Int      @default(0)
  /// Forecast daily run-rate in integer cents (blended estimator output).
  dailyRunRateCents      Int      @default(0)
  /// OLS slope (cents/day) — surfaced for trend display.
  slopeCentsPerDay       Float    @default(0)
  /// Final EWMA level (cents/day).
  ewmaCents              Float    @default(0)
  /// Number of observation days used in this forecast.
  sampleDays             Int      @default(0)
  /// MAPE of the in-window backtest (fraction; 0.15 == 15%). Null when the
  /// window is too short to backtest.
  backtestMape           Float?
  computedAt             DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scope, computedAt])
  @@index([projectId, computedAt])
  @@map("cost_forecasts")
}

/// Issue #49 — budget alert threshold rule. `thresholdPct` is a percentage of
/// the workspace monthly budget (e.g. 50, 80, 100) or a custom value.
/// `basis` selects whether the threshold compares against month-to-date actual
/// ("mtd") or the projected month-end ("projected"). `cooldownSec` prevents
/// alert storms — a rule cannot re-fire within the cooldown window.
model AlertRule {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String
  /// Percentage threshold (0–1000). 50/80/100 are the built-in presets;
  /// custom rules may use any positive value.
  thresholdPct Int
  /// "mtd" | "projected" — which spend figure the threshold evaluates.
  basis        String    @default("projected")
  /// Cooldown in seconds before this rule may fire again. Default 3600 (1h).
  cooldownSec  Int       @default(3600)
  enabled      Boolean   @default(true)
  /// Last time this rule fired (idempotency state). Null = never fired.
  lastFiredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events    AlertEvent[]

  @@index([workspaceId, enabled])
  @@map("alert_rules")
}

/// Issue #49 — alert fire history. One row per dispatched alert. Provides the
/// idempotency audit trail and powers the UI alert log.
model AlertEvent {
  id          String   @id @default(cuid())
  workspaceId String
  ruleId      String
  /// Spend figure (cents) that tripped the rule at fire time.
  spendCents  Int
  /// Budget (cents) the threshold was evaluated against.
  budgetCents Int
  /// Computed ratio spend/budget at fire time (fraction).
  ratio       Float
  /// "mtd" | "projected" — copied from the rule for the historical record.
  basis       String
  /// Delivery summary: JSON array of { channelId, type, ok, error? }.
  deliveries  String   @default("[]")
  firedAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rule      AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([workspaceId, firedAt])
  @@index([ruleId, firedAt])
  @@map("alert_events")
}

/// Issue #50 / #51 — outbound alert delivery channel. `type` is
/// "email" | "webhook" | "slack" | "pagerduty" (free-form string; no migration
/// needed to add a type). For email, `target` is the recipient address. For
/// webhook, `target` is the destination URL and `secret` (vault-encrypted at the
/// service layer) signs the HMAC-SHA256 body signature. For slack (#51), `target`
/// (or `config.channel`) is the Slack channel id — the per-workspace bot token is
/// resolved from the #579 install store at dispatch time. For pagerduty (#51),
/// `config.serviceKey` (default "default") selects the #580 per-workspace routing
/// key; `target`/`secret` are unused. `config` holds type-specific JSON.
model AlertChannel {
  id          String   @id @default(cuid())
  workspaceId String
  type        String // email | webhook | slack | pagerduty
  /// Email address (email) or destination URL (webhook).
  target      String
  /// HMAC signing secret for webhooks (null for email). Stored encrypted.
  secret      String?
  /// JSON config blob (type-specific). Default "{}".
  config      String   @default("{}")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, enabled])
  @@map("alert_channels")
}

/// Epic #593 / Issue #602 — per-project model routing preferences.
/// Controls how the ModelRouter selects between Haiku and Sonnet for
/// different task types. `taskTypeOverrides` is a JSON object mapping
/// task type keys to model IDs. `budgetDowngradeThreshold` (in tokens)
/// triggers automatic downgrade from Sonnet to Haiku when exceeded.
model ModelPreference {
  id                       String   @id @default(cuid())
  projectId                String   @unique
  defaultModel             String?
  taskTypeOverrides        String   @default("{}") // JSON
  budgetDowngradeThreshold Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("model_preferences")
}

/// Audit row for every SafetyHook decision. `direction` is "input" (request
/// prompt) or "output" (model completion). `verdict` is "allowed", "blocked"
/// (caller throws SafetyDeniedError), or "redacted" (text was rewritten).
/// `findings` is a JSON-encoded array of `{kind, ranges, message}`.
model SafetyEvent {
  id        String   @id @default(cuid())
  projectId String
  sessionId String?
  direction String // input|output
  verdict   String // allowed|blocked|redacted
  findings  String // JSON-encoded array
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([projectId, verdict])
  @@map("safety_events")
}

model Document {
  id                 String    @id @default(cuid())
  projectId          String
  filename           String
  mimeType           String
  sizeBytes          Int
  storagePath        String
  checksum           String
  status             String    @default("pending") // pending|processing|ready|failed
  /// Epic #157 — RAG hardening. Indexing lifecycle independent of `status`.
  /// `pending` → freshly created. `quarantined` → chunks computed + embedded
  /// but parked in `QuarantineChunk`. `indexed` → chunks live in LanceDB +
  /// `KnowledgeChunk`. `rejected` → operator declined; chunks dropped.
  indexState         String    @default("pending")
  /// Per-document override. When true, ingest skips quarantine even if the
  /// project default is `false`. Defaults to the project default at insert.
  autoApproveTrusted Boolean   @default(false)
  /// JSON array of `{ kind, value }` ACL subject objects mirrored to chunks.
  /// Empty array = visible to all project members. See `lib/rag/acl.ts`.
  aclSubjects        String    @default("[]")
  /// Epic #724 — when true this document is a "spec" and will be used by the
  /// spec-checking scan mode for implementation-vs-spec comparison.
  isSpec             Boolean   @default(false)
  errorMessage       String?
  chunkCount         Int       @default(0)
  uploadedById       String
  uploadedAt         DateTime  @default(now())
  processedAt        DateTime?
  deletedAt          DateTime?

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  chunks           KnowledgeChunk[]
  quarantineChunks QuarantineChunk[]
  /// Epic #159 — impact-analysis runs sourced from this document.
  impactAnalyses   ImpactAnalysis[]

  @@index([projectId])
  @@index([projectId, status])
  @@index([projectId, indexState])
  @@index([checksum])
  @@map("documents")
}

model KnowledgeChunk {
  id              String  @id @default(cuid())
  projectId       String
  documentId      String
  position        Int
  text            String
  md5             String
  // Identifier of the embedding model that produced this chunk's vector.
  // Persisted per-chunk so future model swaps can backfill incrementally.
  embeddingModel  String  @default("metis-offline-hash-v1")
  /// Issue #1182 — the chunker generation that produced this row's boundaries:
  /// PRODUCER, algorithm version AND effective parameters, e.g. `doc:v2:2048/256`
  /// from the shared chunker or `docsgen:v1:1500` from the generated-docs writer.
  /// The producer segment is load-bearing: `classifyChunkerIdentity` splits on the
  /// first `:` to decide whether a row is even comparable. Distinct from
  /// `embeddingModel`, which records how the text was VECTORISED, not how it was
  /// CUT. NULL means only that the row was written before #1182 — provenance
  /// unrecorded. It may be the pre-#1178 generation whose chunks did not tile
  /// their source; it may equally be a generated-doc chunk. Deliberately NOT
  /// backfilled: a value invented for an existing row would be a guess, and the
  /// absence is itself the honest answer. See ADR 0006.
  chunkerIdentity String?
  // The vector embedding lives in LanceDB / the local vector store. We store
  // the row identifier here so we can resolve back into the vector store.
  vectorRef       String?
  metadata        String? // JSON-encoded
  /// Epic #157 — JSON array of `{ kind, value }` ACL subjects propagated
  /// from the parent document at ingest. Empty = visible to all project
  /// members. Filtering happens in `KnowledgeService.search` BEFORE rerank.
  aclSubjects     String   @default("[]")
  createdAt       DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([documentId, position])
  @@index([md5])
  @@map("knowledge_chunks")
}

// ============================================================================
// Epic #157 — RAG hardening (v1.1.0)
// ============================================================================

/// Holds chunks computed during ingest but NOT yet inserted into the live
/// vector store. Operators approve/reject from the project library UI.
model QuarantineChunk {
  id         String   @id @default(cuid())
  documentId String
  projectId  String
  ord        Int
  text       String
  /// JSON-encoded number[] vector — small enough that storing in TEXT keeps
  /// us schema-compatible with both SQLite and Postgres without `Json`.
  embedding  String
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([documentId, ord])
  @@map("quarantine_chunks")
}

/// Per-project agentic memory. Entries are upserted by key + read into the
/// agent system prompt on session start. TTL is enforced via lazy purge.
model ChronicleEntry {
  id              String    @id @default(cuid())
  projectId       String
  key             String
  value           String
  sourceSessionId String?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, key])
  @@index([expiresAt])
  @@map("chronicle_entries")
}

model RepoConnection {
  id            String    @id @default(cuid())
  projectId     String
  label         String
  provider      String    @default("github") // github|github_enterprise|gitlab|local|upload
  ownerOrOrg    String?
  repoName      String?
  defaultBranch String    @default("main")
  /// Issue #288 — absolute server filesystem path for provider="local".
  localPath     String?
  /// Issue #288 — stored .zip archive path for provider="upload".
  uploadPath    String?
  isPrimary     Boolean   @default(false)
  apiBaseUrl    String?
  secretId      String? // reference to encrypted PAT/token
  status        String    @default("pending") // pending|connected|error|disabled
  errorMessage  String?
  lastTestedAt  DateTime?
  lastIngestAt  DateTime?
  lastCommitSha String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  secret             Secret?           @relation(fields: [secretId], references: [id], onDelete: SetNull)
  createdBy          User?             @relation("RepoCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Epic #298 — code graph(s) sourced from this repo.
  codeGraphs         CodeGraph[]       @relation("CodeGraphRepo")
  /// Epic #544 — product associations and cross-repo edges.
  productRepos       ProductRepo[]
  productSourceEdges ProductEdge[]     @relation("ProductSourceEdges")
  productTargetEdges ProductEdge[]     @relation("ProductTargetEdges")
  productDocuments   ProductDocument[] @relation("ProductDocRepo")
  /// Epic #708 — AI Bug Scanner runs against this repo.
  scans              Scan[]

  @@unique([projectId, label])
  @@index([secretId])
  @@index([projectId, status])
  @@map("repo_connections")
}

model DatabaseConnection {
  id                 String    @id @default(cuid())
  projectId          String
  label              String
  driver             String // postgres|mysql|oracle|sqlserver|sqlite|jdbc
  host               String?
  port               Int?
  databaseName       String?
  username           String?
  secretId           String? // reference to encrypted password/connection string
  options            String? // JSON-encoded driver-specific options
  status             String    @default("pending") // pending|connected|error|disabled
  errorMessage       String?
  lastTestedAt       DateTime?
  lastIngestAt       DateTime?
  createdById        String?
  /// Epic #295 Phase 4 (#307) — link to the workspace-scoped DatabaseResource
  /// that dedupes the same physical DB across projects. NULLABLE: connections
  /// in projects with no workspace, or with insufficient identity (e.g. null
  /// host), stay unlinked. SetNull on resource delete keeps the connection.
  databaseResourceId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  secret           Secret?           @relation(fields: [secretId], references: [id], onDelete: SetNull)
  createdBy        User?             @relation("DbCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Epic #295 Phase 4 (#307) — shared physical-DB registry entry.
  databaseResource DatabaseResource? @relation(fields: [databaseResourceId], references: [id], onDelete: SetNull)

  /// Epic #889 (B1 / #891) — requirement ↔ data traceability links.
  dataMappings RequirementDataMapping[]

  @@unique([projectId, label])
  @@index([secretId])
  @@index([projectId, status])
  @@index([databaseResourceId])
  @@map("database_connections")
}

/// Epic #295 Phase 4 (#307) — workspace-scoped registry of PHYSICAL databases.
/// The same physical DB connected from two projects in a workspace collapses to
/// ONE row here (deduped by driver+host+port+databaseName), enabling
/// cross-project usage + impact queries. Authz: a resource is only ever visible
/// or linkable WITHIN its workspace (see cross-project-access.ts).
///
/// NULL-normalization for the dedupe unique key: SQLite (and Postgres) treat
/// NULL as distinct in unique indexes, so two connections both missing a `host`
/// would NOT collide. We therefore only find-or-create / backfill a resource for
/// connections that carry the minimum identity (non-null host AND databaseName);
/// connections below that bar are left unlinked rather than collapsed by
/// accident. The unique constraint is a backstop; the app-level dedupe key
/// (see resource-key.ts) is the source of truth.
model DatabaseResource {
  id           String   @id @default(cuid())
  workspaceId  String
  driver       String // postgres|mysql|oracle|sqlserver|sqlite|jdbc
  host         String?
  port         Int?
  databaseName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connections      DatabaseConnection[]
  /// Epic #295 Phase 4 (#308) — canonical schema-object identities for this DB.
  objectIdentities SchemaObjectIdentity[]

  @@unique([workspaceId, driver, host, port, databaseName])
  @@index([workspaceId])
  @@map("database_resources")
}

/// Epic #295 Phase 4 (#308) — canonical identity for a schema object (table /
/// column / procedure / function) within a shared DatabaseResource. The SAME
/// object seen from multiple projects maps to ONE identity, which is what lets
/// impact reason across projects. `objectType` reuses the ImpactAffectedTable
/// vocabulary (table|column|procedure|function). `usageClass` is an optional
/// rollup across linked projects (used if ANY project uses it, else
/// uncertain/unreferenced) — same vocab as packages/shared schema-impact.ts.
model SchemaObjectIdentity {
  id                 String   @id @default(cuid())
  databaseResourceId String
  schemaName         String?
  objectName         String
  objectType         String   @default("table") // table|column|procedure|function
  /// Optional rollup of usage across the projects linked to this resource:
  /// used|unreferenced|uncertain. Null until first reconciliation.
  usageClass         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  databaseResource DatabaseResource      @relation(fields: [databaseResourceId], references: [id], onDelete: Cascade)
  affectedTables   ImpactAffectedTable[]

  @@unique([databaseResourceId, schemaName, objectName, objectType])
  @@index([databaseResourceId])
  @@map("schema_object_identities")
}

/// Epic #467 (#469) — Suggested database connectors discovered from repo code.
/// Populated by the connection scanner during deep-ingest. No credential fields.
model SuggestedConnector {
  id                   String   @id @default(cuid())
  projectId            String
  driverType           String // oracle|postgresql|mysql|sqlserver|sqlite
  host                 String?
  port                 Int?
  database             String?
  sourceFile           String
  lineNumber           Int
  confidence           String // high|medium|low
  status               String   @default("pending") // pending|accepted|dismissed
  /// Epic #701 / Issue #703 — optional discovered username (dev files only,
  /// gated by Project.allowCredentialScan). Plaintext OK because usernames
  /// are non-sensitive; passwords go via passwordVaultRef.
  username             String?
  /// Vault id of the discovered dev password. NEVER stores plaintext.
  passwordVaultRef     String?
  /// True iff the discovery pipeline extracted dev credentials for this row.
  devCredsDetected     Boolean  @default(false)
  /// Repo-relative path of the dev file that contributed the credentials.
  credentialSourceFile String?
  /// Forward link to the DatabaseConnection provisioned from this suggestion.
  acceptedConnectorId  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, driverType, host, port, database])
  @@index([projectId, status])
  @@index([acceptedConnectorId])
  @@map("suggested_connectors")
}

// ============================================================================
// Analysis Pipeline — Analysis, AgentResult, Finding, Requirement
// ============================================================================

model Analysis {
  id           String    @id @default(cuid())
  projectId    String
  status       String    @default("pending") // pending|running|completed|failed|cancelled
  startedById  String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  totalTokens  Int       @default(0)
  errorMessage String?
  metadata     String? // JSON-encoded run config
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startedBy User    @relation(fields: [startedById], references: [id])

  agentResults         AgentResult[]
  requirements         Requirement[]
  /// Epic #557 — change analysis runs where this is the base or head.
  changeAnalysesAsBase ChangeAnalysis[]          @relation("ChangeAnalysisBase")
  changeAnalysesAsHead ChangeAnalysis[]          @relation("ChangeAnalysisHead")
  /// Epic #597 — human approval checkpoints for requirements enhancement.
  approvalRequests     ApprovalRequest[]
  /// Epic #201 (#210) — durable clarification dialog state.
  clarificationDialog  ClarificationDialogState?
  /// Epic #203 (#221) — first-class cross-document conflict/completeness findings.
  crossDocFindings     CrossDocFinding[]
  /// Epic #475 — discussion threads anchored to this analysis run (nullable anchor).
  discussionThreads    DiscussionThread[]

  @@index([projectId, status])
  @@index([status])
  @@map("analyses")
}

/// Epic #203 (#221) — first-class cross-document conflict / contradiction /
/// completeness finding detected over the ingested customer documents
/// (NOT a side artifact). Persisted directly against the Analysis so the
/// analysis API + UI can surface contradictions and completeness gaps with
/// evidence references. Re-running an analysis replaces the prior set.
model CrossDocFinding {
  id          String   @id @default(cuid())
  analysisId  String
  /// One of CROSS_DOC_FINDING_KINDS: contradiction|missing-nfr|
  /// missing-acceptance-criteria|missing-assumption|missing-risk.
  kind        String
  /// FindingSeverity: critical|high|medium|low|info.
  severity    String   @default("medium")
  title       String
  /// Human-readable detail (contradiction explanation or gap rationale).
  detail      String
  /// JSON array of evidence segment ids (document/chunk ids).
  evidenceIds String   @default("[]")
  /// For contradictions: "self"|"pairwise"; null for completeness gaps.
  scope       String?
  createdAt   DateTime @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([kind])
  @@map("cross_doc_findings")
}

/// Epic #201 (#210) — durable clarification dialog state. Replaces the prior
/// in-memory Map so in-flight clarification survives a server restart
/// (checkpoint/interrupt/resume, native Prisma — no external orchestrator).
/// `state` holds the JSON-serialized `ClarificationState`.
model ClarificationDialogState {
  id         String   @id @default(cuid())
  analysisId String   @unique
  state      String // JSON-encoded ClarificationState
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@map("clarification_dialog_states")
}

model AgentResult {
  id           String    @id @default(cuid())
  analysisId   String
  agentKey     String // e.g. "codebase-assessor", "security-scanner"
  /// Issue #763 (epic #727) — the RepoConnection this result was produced for, on
  /// the multi-repo agentic `code` path. Nullable: single-repo/legacy rows and the
  /// non-code agents (doc/synthesis/security) carry no connector. Scopes the
  /// `persistAgentResult` replace-delete so one repo's persist no longer clobbers
  /// another repo's `code` findings (was replace-by-agentKey only).
  connectorId  String?
  status       String    @default("pending") // pending|running|completed|failed
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  output       String? // JSON-encoded structured output
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  analysis Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  findings Finding[]

  @@index([analysisId, agentKey])
  @@index([status])
  @@map("agent_results")
}

model Finding {
  id            String   @id @default(cuid())
  /// #1330 (ADR 0011) — NULLABLE. A Finding materialised from an approved
  /// ScanFinding has no analysis agent run behind it; its provenance is
  /// `scanFindingId` instead. Exactly one of the two is set. Findings written
  /// by the analysis pipeline still set this and never set `scanFindingId`.
  agentResultId String?
  category      String // security|performance|architecture|dependency|rationale|rationale-todo|...
  severity      String   @default("info") // critical|high|medium|low|info
  title         String
  body          String
  evidence      String? // JSON-encoded references (file paths, line numbers, urls)
  /// Epic #298 — provenance of the finding.
  /// `extracted` = pulled directly from source/AST (rationale, structural facts). MUST have confidence=1.0.
  /// `inferred`  = produced by an analysis-agent's reasoning. confidence is the agent's self-reported probability.
  /// `ambiguous` = the agent flagged the finding for human review. confidence is the agent's uncertainty estimate.
  derivation    String   @default("inferred")
  /// Epic #298 — value in [0.0, 1.0]. For derivation='extracted' MUST be 1.0. SQLite has no
  /// CHECK-constraint introspection in Prisma, so the rule cannot live here.
  /// #1325 (ADR 0010): it is enforced at CI by server/tests/finding-provenance-ratchet.test.ts,
  /// which classifies every Finding-delegate write in server/src + server/scripts + server/prisma
  /// from the AST. A registry entry there waives ONE named call site with a declared count, not a file.
  /// NOTHING validates it at runtime: `createFindingSchema` in packages/shared/src/analysis.ts
  /// carries the same rule as a Zod .refine but is a TYPE-ONLY artefact with no runtime importer.
  /// Note both columns carry a @default, so they are OPTIONAL in FindingCreateInput — tsc will
  /// NOT reject a create that omits them (the old "type-safety gate" claim was false, measured).
  confidence    Float    @default(0.7)
  /// Epic #298 — optional FK to the source CodeSymbol when the finding was extracted from code
  /// (e.g. a `// WHY:` comment). Nullable for legacy/agent-generated findings.
  symbolId      String?
  /// Epic #708 — back-link to the ScanFinding this row was materialised from on
  /// triage-approval. Null for findings produced by the regular analysis pipeline.
  scanFindingId String?  @unique
  /// Epic #727 (#740) — deterministic verifier verdict set after the #734 grounding
  /// gate: `confirmed` (kept a grounded code citation) | `unverified` (code claim dropped).
  /// Null for findings with no code-evidence claim and for rows written before #740.
  verificationStatus String?
  createdAt     DateTime @default(now())

  agentResult AgentResult? @relation(fields: [agentResultId], references: [id], onDelete: Cascade)
  symbol      CodeSymbol?  @relation("SymbolFindings", fields: [symbolId], references: [id], onDelete: SetNull)
  scanFinding ScanFinding? @relation("MaterializedScanFinding", fields: [scanFindingId], references: [id], onDelete: SetNull)
  /// Epic #176 / #179 — issues published from this analysis finding (one per provider).
  issueLinks  IssueLink[]

  @@index([agentResultId])
  @@index([category, severity])
  @@index([derivation])
  @@index([symbolId])
  @@map("findings")
}

model Requirement {
  id               String    @id @default(cuid())
  projectId        String
  analysisId       String
  type             String    @default("feature") // feature|bug|chore|epic|task
  title            String
  body             String
  priority         String    @default("medium") // low|medium|high|critical
  labels           String    @default("[]") // JSON array of label strings
  /// draft|approved|rejected|deferred (typed; legacy `review:*` labels still
  /// parsed on read). Epic #609 (#616): when this requirement is in the scope
  /// of a formal ReviewRequest, the review WORKFLOW owns this column — the
  /// service writes the derived value on every review-status change (see
  /// `deriveRequirementReviewStatus` in `lib/reviews/state-machine.ts`); it
  /// must never be hand-set while a formal review exists.
  reviewStatus     String?
  /// Epic #726 (#736) — deterministic coverage classification computed at
  /// synthesis time from the requirement's linked-finding evidence:
  /// `grounded_in_code` | `grounded_in_docs_only` | `no_evidence`. Nullable —
  /// re-runs recompute it (requirements are delete+recreated), and rows written
  /// before this column carry null (the UI renders a neutral state).
  coverage         String?
  /// Issue #773 — deterministic three-state verdict computed at synthesis from
  /// the requirement's linked CODE findings + the run's retrieval health:
  /// `implemented` | `gap-confirmed` | `could-not-verify`. Distinct from
  /// `coverage` (which says what KIND of evidence exists, not whether the
  /// requirement is satisfied): only `gap-confirmed` licenses telling a user to
  /// build something. Nullable — re-runs recompute it (requirements are
  /// delete+recreated), doc-only runs leave it null, and pre-#773 rows read null.
  verdict          String?
  /// Issue #1096 — JSON array of testable acceptance criteria derived at
  /// synthesis time from this requirement's own evidence. `"[]"` is a truthful
  /// "none could be derived" and renders as an explicit note downstream; it is
  /// never back-filled with boilerplate. Re-runs recompute it (requirements are
  /// delete+recreated) and rows written before this column read `"[]"`.
  acceptanceCriteria String  @default("[]")
  storyPoints      Int?
  parentId         String?
  /// Epic #192 (A.5) — living-spec sync. Set when a PR linked to the
  /// originating issue is merged. `implementedByPr` stores the PR number
  /// and `implementedBySha` the merge commit SHA for traceability.
  implementedAt    DateTime?
  implementedByPr  Int?
  implementedBySha String?
  /// Epic #776 — inbound importer provenance. Set when a requirement
  /// originates from an external tracker (GitHub / Jira / Azure DevOps /
  /// Linear). `externalSource` + `externalId` form the dedup key so a
  /// re-import updates the existing row instead of creating a duplicate.
  externalSource   String? // github|jira|azure-devops|linear
  externalId       String? // stable id within the source (issue number/key/work-item id)
  externalUrl      String? // canonical URL back to the source item
  importSourceId   String? // FK to import_sources.id (scalar; soft link)
  /// Epic #728 — optimistic-locking version counter.
  version          Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysis Analysis      @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  parent   Requirement?  @relation("RequirementHierarchy", fields: [parentId], references: [id])
  children Requirement[] @relation("RequirementHierarchy")

  drafts            IssueDraft[]
  implementations   RequirementImplementation[]
  /// Epic #557 — change analysis: this requirement as head/previous.
  changesAsHead     RequirementChange[]         @relation("ChangeHeadReq")
  changesAsPrev     RequirementChange[]         @relation("ChangePrevReq")
  /// Epic #856 — test coverage mappings + gaps targeting this requirement.
  coverageMappings  CoverageMapping[]
  testCoverageGaps  GapItem[]
  /// Epic #889 (B1 / #891) — requirement ↔ data (table/column) mappings.
  dataMappings      RequirementDataMapping[]
  /// Epic #159 — requirement ↔ code mappings + impact items.
  codeMappings      RequirementCodeMapping[]
  impactItems       ImpactItem[]
  /// Epic #207 — requirement ↔ spec mappings (traceability spine).
  specMappings      RequirementSpecMapping[]
  /// Epic #728 — multi-user collaboration.
  commentThreads    CommentThread[]
  assignments       Assignment[]
  /// Epic #770 — append-only version history.
  versions          RequirementVersion[]
  /// Epic #208 — requirement ↔ stakeholder associations.
  stakeholderLinks  RequirementStakeholder[]
  /// Epic #475 — discussion threads anchored to this requirement (nullable anchor).
  discussionThreads DiscussionThread[]
  /// Epic #609 (#616) — formal review scope items + baseline version pins.
  reviewItems       ReviewRequestItem[]
  baselineItems     BaselineItem[]
  /// Epic #610 (#623) — typed cross-project links where this requirement is the
  /// source (outgoing) / target (incoming) endpoint.
  outgoingLinks     RequirementLink[]           @relation("RequirementLinkSource")
  incomingLinks     RequirementLink[]           @relation("RequirementLinkTarget")

  @@unique([projectId, externalSource, externalId], name: "requirement_external_dedup")
  @@index([projectId])
  @@index([analysisId])
  @@index([parentId])
  @@index([implementedByPr])
  @@index([importSourceId])
  @@map("requirements")
}

/// Epic #610 (#623) — a typed, DIRECTIONAL link between two requirements
/// (`source` → `target`). Links are allowed ACROSS projects, but only WITHIN
/// the same workspace: the source and target projects must share a
/// `Project.workspaceId`. Projects with a NULL workspaceId may only link within
/// the SAME project (a null workspace is not a shared workspace). That
/// same-workspace invariant is enforced in the API sub-issue (#624), which
/// resolves both requirements' projects; the DB cannot express it. `type` is
/// one of the shared `RequirementLinkType` vocabulary
/// (relates_to|duplicates|depends_on|derived_from). Self-links
/// (`source === target`) are rejected at the service layer. `createdById` is a
/// scalar soft-link to `users.id` (no FK), matching other provenance columns.
model RequirementLink {
  id                  String   @id @default(cuid())
  sourceRequirementId String
  targetRequirementId String
  type                String // relates_to|duplicates|depends_on|derived_from
  createdById         String // scalar soft-link to users.id
  createdAt           DateTime @default(now())

  source Requirement @relation("RequirementLinkSource", fields: [sourceRequirementId], references: [id], onDelete: Cascade)
  target Requirement @relation("RequirementLinkTarget", fields: [targetRequirementId], references: [id], onDelete: Cascade)

  @@unique([sourceRequirementId, targetRequirementId, type])
  @@index([sourceRequirementId])
  @@index([targetRequirementId])
  @@map("requirement_links")
}

/// Epic #192 (A.5) — per-PR implementation record. One row per file/range
/// touched by the merged PR. Powers the "Implemented by" UI section.
model RequirementImplementation {
  id            String   @id @default(cuid())
  requirementId String
  prNumber      Int
  prUrl         String
  commitSha     String
  filePath      String
  startLine     Int?
  endLine       Int?
  mergedAt      DateTime
  createdAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@index([prNumber])
  @@map("requirement_implementations")
}

/// Epic #889 (B1 / #891) — links a Requirement to a database table/column,
/// mirroring RequirementImplementation (code) and CoverageMapping (tests)
/// traceability. A null `columnName` denotes a table-level mapping.
model RequirementDataMapping {
  id            String    @id @default(cuid())
  requirementId String
  dbConnectorId String
  schemaName    String? // null => connector's default schema
  tableName     String
  columnName    String? // null => table-level mapping
  confidence    Float     @default(0.7) // 0..1
  source        String    @default("manual") // manual|llm-suggested
  note          String? // optional free-text provenance / rationale
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  requirement Requirement        @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  dbConnector DatabaseConnection @relation(fields: [dbConnectorId], references: [id], onDelete: Cascade)

  @@unique([requirementId, dbConnectorId, schemaName, tableName, columnName])
  @@index([requirementId])
  @@index([dbConnectorId])
  @@map("requirement_data_mappings")
}

/// Epic #776 — Inbound importer configuration. Each row is a saved import
/// from an external tracker (GitHub / Jira / Azure DevOps / Linear). Imported
/// requirements anchor to `analysisId` (a synthetic completed Analysis) and
/// dedup on Requirement.(externalSource, externalId). Optional ongoing sync
/// is driven by a ScheduledJob (`scheduledJobId`) that re-runs the import on a
/// cron interval. After `consecutiveFailures` hits the threshold the sync is
/// auto-disabled (`disabledReason`) to stop hammering a broken upstream.
model ImportSource {
  id                  String    @id @default(cuid())
  projectId           String
  analysisId          String // anchor Analysis for imported requirements
  source              String // github|jira|azure-devops|linear
  label               String
  filter              String    @default("{}") // JSON: per-source non-secret config
  baseUrl             String? // custom host (GH Enterprise / Jira DC / ADO org)
  jiraConnectionId    String? // reuse an existing JiraConnection (jira source)
  secretId            String? // vault secret id holding the API token
  syncEnabled         Boolean   @default(false)
  syncIntervalMinutes Int       @default(15)
  scheduledJobId      String? // ScheduledJob driving ongoing sync
  consecutiveFailures Int       @default(0)
  disabledReason      String? // set when sync auto-disabled after failures
  lastRunAt           DateTime?
  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  runs ImportRun[]

  @@index([projectId])
  @@index([analysisId])
  @@map("import_sources")
}

/// Epic #776 — one execution record per import run (manual or scheduled).
model ImportRun {
  id             String    @id @default(cuid())
  importSourceId String
  projectId      String
  trigger        String    @default("manual") // manual|scheduled
  status         String    @default("pending") // pending|running|completed|failed
  taskId         String? // backing Task row, if enqueued
  createdCount   Int       @default(0)
  updatedCount   Int       @default(0)
  skippedCount   Int       @default(0)
  totalFetched   Int       @default(0)
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  importSource ImportSource @relation(fields: [importSourceId], references: [id], onDelete: Cascade)

  @@index([importSourceId])
  @@index([projectId, createdAt])
  @@map("import_runs")
}

// ============================================================================
// Publishing — IssueDraft -> PublishBatch -> PublishedIssue
// ============================================================================

model IssueDraft {
  id            String    @id @default(cuid())
  projectId     String
  requirementId String?
  parentDraftId String?
  draftType     String    @default("feature") // epic|feature|bug|task
  title         String
  body          String
  labels        String    @default("[]") // JSON array
  assignees     String    @default("[]") // JSON array
  storyPoints   Int?
  status        String    @default("draft") // draft|approved|publishing|published|failed
  dedupHash     String? // sha256(repo + normalized title) used for idempotency
  metadata      String? // JSON-encoded extras (mermaid diagrams, criteria source ids)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  parentDraft IssueDraft?  @relation("DraftHierarchy", fields: [parentDraftId], references: [id])
  childDrafts IssueDraft[] @relation("DraftHierarchy")

  publishedIssues PublishedIssue[]

  @@index([projectId, status])
  @@index([requirementId])
  @@index([parentDraftId])
  @@index([dedupHash])
  @@map("issue_drafts")
}

/// Epic #595 — Configurable issue templates for AI-generated drafts.
/// Each project can have multiple templates for different issue types
/// and platforms (GitHub/Jira). Default templates are seeded at project
/// creation and marked with isDefault=true.
model IssueTemplate {
  id            String   @id @default(cuid())
  projectId     String
  name          String
  platform      String   @default("universal") // github|jira|universal
  templateType  String   @default("feature") // epic|feature|story|bug|task
  schema        String // JSON-encoded TemplateSchema
  defaultValues String   @default("{}") // JSON-encoded defaults
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, platform])
  @@index([projectId, templateType])
  @@map("issue_templates")
}

model PublishBatch {
  id             String    @id @default(cuid())
  projectId      String
  status         String    @default("pending") // pending|running|completed|failed|cancelled
  targetOwner    String
  targetRepo     String
  targetBaseUrl  String?
  provider       String    @default("github") // github|github_enterprise
  dryRun         Boolean   @default(false)
  totalDrafts    Int       @default(0)
  publishedCount Int       @default(0)
  failedCount    Int       @default(0)
  dedupSkipped   Int       @default(0)
  archived       Boolean   @default(false)
  archivedAt     DateTime?
  archiveReason  String?
  archivedById   String?
  dryRunPlan     String? // JSON dry-run plan rendered without API calls
  startedById    String
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  errorMessage   String?
  metadata       String? // JSON-encoded batch options
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startedBy User    @relation(fields: [startedById], references: [id])

  publishedIssues PublishedIssue[]

  @@index([projectId, status])
  @@index([status])
  @@index([archived])
  @@map("publish_batches")
}

model PublishedIssue {
  id                String   @id @default(cuid())
  batchId           String
  draftId           String
  issueNumber       Int
  issueId           String // remote node id for idempotency
  htmlUrl           String
  status            String   @default("created") // created|updated|failed
  /// Epic #557 — which destination this issue was published to.
  destination       String   @default("github") // github|jira
  parentIssueNumber Int?
  dedupHash         String?
  bodyHash          String?
  errorMessage      String?
  publishedAt       DateTime @default(now())

  batch       PublishBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  draft       IssueDraft   @relation(fields: [draftId], references: [id], onDelete: Cascade)
  /// Epic #739 — drift events for this published issue.
  driftEvents DriftEvent[]

  @@unique([batchId, draftId, destination])
  @@index([batchId, issueNumber, destination])
  @@index([issueId])
  @@index([dedupHash])
  @@map("published_issues")
}

// ============================================================================
// Epic #557 — Change Analysis + Dual-Destination Publishing
// ============================================================================

/// Tracks a comparison between two analysis runs (base vs head).
/// Detects additions, removals, and modifications of requirements.
model ChangeAnalysis {
  id             String    @id @default(cuid())
  projectId      String
  baseAnalysisId String
  headAnalysisId String
  status         String    @default("pending") // pending|running|completed|failed
  summary        String?
  totalChanges   Int       @default(0)
  additions      Int       @default(0)
  removals       Int       @default(0)
  modifications  Int       @default(0)
  startedById    String
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  baseAnalysis Analysis @relation("ChangeAnalysisBase", fields: [baseAnalysisId], references: [id], onDelete: Cascade)
  headAnalysis Analysis @relation("ChangeAnalysisHead", fields: [headAnalysisId], references: [id], onDelete: Cascade)
  startedBy    User     @relation("ChangeAnalysisStarter", fields: [startedById], references: [id])

  changes RequirementChange[]

  @@index([projectId])
  @@index([baseAnalysisId])
  @@index([headAnalysisId])
  @@map("change_analyses")
}

/// Individual requirement change detected during a ChangeAnalysis run.
model RequirementChange {
  id                    String    @id @default(cuid())
  changeAnalysisId      String
  changeType            String    @default("modified") // added|removed|modified
  severity              String    @default("medium") // critical|high|medium|low
  impactScore           Float     @default(0.5) // 0.0–1.0
  requirementId         String? // head requirement (null for removals)
  previousRequirementId String? // base requirement (null for additions)
  title                 String
  previousTitle         String?
  body                  String
  previousBody          String?
  diffSummary           String? // human-readable summary of changes
  reviewStatus          String    @default("pending") // pending|approved|rejected
  reviewedById          String?
  reviewedAt            DateTime?
  createdAt             DateTime  @default(now())

  changeAnalysis      ChangeAnalysis @relation(fields: [changeAnalysisId], references: [id], onDelete: Cascade)
  requirement         Requirement?   @relation("ChangeHeadReq", fields: [requirementId], references: [id], onDelete: SetNull)
  previousRequirement Requirement?   @relation("ChangePrevReq", fields: [previousRequirementId], references: [id], onDelete: SetNull)

  @@index([changeAnalysisId])
  @@index([requirementId])
  @@index([previousRequirementId])
  @@index([reviewStatus])
  @@map("requirement_changes")
}

// ============================================================================
// Impact Analysis (Epic #159) — multi-project requirement-change → code-impact
// ============================================================================
/// Links a Requirement to a concrete code location (CodeSymbol) in a project,
/// mirroring RequirementImplementation (PR-derived) and RequirementDataMapping
/// (table/column). Produced by the semantic requirement→code mapper (#161) and
/// reused as the seed set for blast-radius traversal (#162). `codeSymbolId` is
/// nullable so unresolved/external matches still record a file-path hit.
model RequirementCodeMapping {
  id            String   @id @default(cuid())
  requirementId String
  projectId     String
  codeSymbolId  String?
  filePath      String
  startLine     Int?
  endLine       Int?
  confidence    Float    @default(0.7) // 0.0–1.0
  source        String   @default("semantic") // semantic|manual
  createdAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  codeSymbol  CodeSymbol? @relation(fields: [codeSymbolId], references: [id], onDelete: SetNull)

  @@index([requirementId])
  @@index([projectId])
  @@index([codeSymbolId])
  @@map("requirement_code_mappings")
}

// ============================================================================
// Epic #207 — Requirement→Spec→Code traceability spine
// ============================================================================
/// Links a Requirement to a Spec (the spec entity IS a GeneratedDocument).
/// Completes the requirement→spec half of the traceability spine (#226). The
/// pairing is unique per (requirementId, specDocumentId); `source = "derived"`
/// rows are produced by the backfill (#228) from RAG chunks + existing
/// requirement→code mappings, `manual` rows are author-curated and never
/// overwritten by a re-run.
model RequirementSpecMapping {
  id             String   @id @default(cuid())
  requirementId  String
  specDocumentId String
  projectId      String
  confidence     Float    @default(0.7) // 0.0–1.0
  source         String   @default("derived") // derived|manual
  createdAt      DateTime @default(now())

  requirement  Requirement       @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  specDocument GeneratedDocument @relation(fields: [specDocumentId], references: [id], onDelete: Cascade)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([requirementId, specDocumentId])
  @@index([requirementId])
  @@index([specDocumentId])
  @@index([projectId])
  @@map("requirement_spec_mappings")
}

/// Links a Spec (GeneratedDocument) to a concrete code location (CodeSymbol),
/// mirroring `RequirementCodeMapping` field-for-field (#227). Completes the
/// spec→code half of the traceability spine. `codeSymbolId` is nullable so an
/// unresolved/external match still records a file-path hit.
model SpecCodeMapping {
  id             String   @id @default(cuid())
  specDocumentId String
  projectId      String
  codeSymbolId   String?
  filePath       String
  startLine      Int?
  endLine        Int?
  confidence     Float    @default(0.7) // 0.0–1.0
  source         String   @default("derived") // derived|semantic|manual
  createdAt      DateTime @default(now())

  specDocument GeneratedDocument @relation(fields: [specDocumentId], references: [id], onDelete: Cascade)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  codeSymbol   CodeSymbol?       @relation(fields: [codeSymbolId], references: [id], onDelete: SetNull)

  @@index([specDocumentId])
  @@index([projectId])
  @@index([codeSymbolId])
  @@map("spec_code_mappings")
}

/// Epic #208 (E6.1 / #230) — first-class stakeholder model. A real BA captures
/// who cares about a project, how much sway they hold, and how invested they
/// are, so requirements can be attributed to the people they serve. Influence
/// and interest drive the classic power/interest grid; `viewpoint` records the
/// lens this stakeholder brings (e.g. "security", "operations", "end-user").
model Stakeholder {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  /// Free-form role/title, e.g. "Compliance Officer", "Product Owner".
  role        String   @default("")
  description String   @default("")
  /// Power/interest grid axes. low|medium|high (free-form; validated at the
  /// service layer, not the DB layer, to keep the catalog extensible).
  influence   String   @default("medium")
  interest    String   @default("medium")
  /// The analytical lens this stakeholder represents (security, ops, legal,
  /// end-user, …). Empty when unclassified.
  viewpoint   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project      Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirements RequirementStakeholder[]

  @@unique([projectId, name], name: "stakeholder_project_name")
  @@index([projectId])
  @@map("stakeholders")
}

/// Epic #208 (E6.1 / #230) — project-level context model. One row per project
/// capturing the framing a BA elicits up front: business goals, in/out-of-scope
/// boundaries, environmental constraints, and a domain glossary. List-shaped
/// fields are stored JSON-as-TEXT (the schema-duality convention — no Json
/// columns) and serialised by the application.
model ProjectContext {
  id            String   @id @default(cuid())
  projectId     String   @unique
  /// One-paragraph framing of the business problem/opportunity.
  businessGoals String   @default("")
  /// JSON array of in-scope statements.
  inScope       String   @default("[]")
  /// JSON array of explicit out-of-scope statements.
  outOfScope    String   @default("[]")
  /// JSON array of environmental/organisational constraints.
  constraints   String   @default("[]")
  /// JSON array of { term, definition } glossary entries.
  glossary      String   @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_contexts")
}

/// Epic #208 (E6.1 / #230) — requirement ↔ stakeholder association. Lets a
/// requirement be attributed to the stakeholders it serves, with the per-link
/// `priority` recording how each stakeholder ranks it (their priorities can
/// differ from the global requirement priority) and `viewpoint` the lens the
/// requirement satisfies for them.
model RequirementStakeholder {
  id            String   @id @default(cuid())
  requirementId String
  stakeholderId String
  /// This stakeholder's priority for the requirement. must-have|should-have|
  /// nice-to-have (free-form; validated at the service layer).
  priority      String   @default("should-have")
  viewpoint     String   @default("")
  createdAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  stakeholder Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  @@unique([requirementId, stakeholderId], name: "requirement_stakeholder_link")
  @@index([requirementId])
  @@index([stakeholderId])
  @@map("requirement_stakeholders")
}

/// One multi-project requirement-change → code-impact run. A single uploaded
/// document (or pasted text) can impact MANY projects; per-project results are
/// carried by ImpactItem rows. Mirrors ChangeAnalysis lifecycle semantics.
model ImpactAnalysis {
  id                   String    @id @default(cuid())
  status               String    @default("pending") // pending|running|completed|failed
  documentId           String? // source document (null when sourced from text)
  sourceText           String? // raw change text (null when sourced from a document)
  summary              String?
  startedById          String
  startedAt            DateTime  @default(now())
  completedAt          DateTime?
  errorMessage         String?
  totalImpactedSymbols Int       @default(0)
  /// Issue #965 (Epic #960) — DRIFT re-run lineage. When set, THIS run is a
  /// re-execution of `rerunOf` against the CURRENT code graph, reusing that run's
  /// `sourceText`/`documentId` VERBATIM; null for original (first) runs. Original
  /// runs are IMMUTABLE — a re-run never mutates its parent's rows, it only points
  /// back at it so the UI/differ can render "what changed since". Self-relation
  /// `ImpactAnalysisRerun`; SetNull so deleting an original orphans (not deletes)
  /// its re-runs.
  rerunOfId            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  document  Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  startedBy User      @relation("ImpactAnalysisStarter", fields: [startedById], references: [id])

  /// Issue #965 — the original run this run re-executes (null for originals).
  rerunOf ImpactAnalysis?  @relation("ImpactAnalysisRerun", fields: [rerunOfId], references: [id], onDelete: SetNull)
  /// Issue #965 — the re-runs derived from this run (drift lineage children).
  reruns  ImpactAnalysis[] @relation("ImpactAnalysisRerun")

  items ImpactItem[]

  /// Issue #963 (Epic #960) — external issues published from this run (Jira/GitHub).
  issueLinks IssueLink[]

  @@index([documentId])
  @@index([startedById])
  @@index([status])
  @@index([rerunOfId])
  @@map("impact_analyses")
}

/// One (project, requirement-change) impact row within an ImpactAnalysis run.
/// `requirementId` is null for removals where no head requirement persists.
model ImpactItem {
  id                  String   @id @default(cuid())
  impactAnalysisId    String
  projectId           String
  requirementId       String?
  /// #1013 (epic #999) — the changed requirement's own title, SNAPSHOTTED at
  /// analysis time from the extractor's per-change title (#964, ≤120 chars).
  /// A run started from PASTED TEXT persists no `Requirement` row, so
  /// `requirementId` is null and the joined title does not exist — without this
  /// column the export had to re-derive a heading from the run's source text,
  /// which cannot be attributed to the right item (the engine DROPS zero-hit
  /// changes, so item ordinals do not correspond to paste ordinals). NULLABLE:
  /// null ⇒ the row predates this column, or the extractor produced no title —
  /// the export then degrades to the neutral `Requirement change N of M`, never
  /// to another requirement's title. User-supplied text: always rendered through
  /// the markdown/JSX sanitizers, never executed.
  requirementTitle    String?
  changeType          String   @default("modified") // added|removed|modified
  severity            String   @default("medium") // critical|high|medium|low
  impactScore         Float    @default(0.5) // 0.0–1.0
  confidence          Float    @default(0.5) // 0.0–1.0
  affectedFileCount   Int      @default(0)
  affectedSymbolCount Int      @default(0)
  /// #932 (epic #929) — per-item BA-readable narrative + severity summary,
  /// generated post-hoc by the LLM impact summarizer from the DETERMINISTIC
  /// impact facts only (affected symbols/tables, tiers, suggested DDL). NULLABLE:
  /// null ⇒ the summarizer did not run (flag off / provider offline / malformed /
  /// ungrounded output) — the deterministic result is unchanged. Never contains
  /// fabricated facts (grounded ⊆ engine facts).
  summary             String?
  createdAt           DateTime @default(now())

  impactAnalysis ImpactAnalysis @relation(fields: [impactAnalysisId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement    Requirement?   @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  affectedSymbols ImpactAffectedSymbol[]
  affectedTables  ImpactAffectedTable[]
  /// Issue #966 (Epic #960) — BA relevance feedback on this item's affected tables.
  feedback        ImpactTableFeedback[]

  @@index([impactAnalysisId])
  @@index([projectId])
  @@index([requirementId])
  @@map("impact_items")
}

/// A single affected code symbol within an ImpactItem — either a direct
/// requirement→code match (`relation = direct`, `depth = 0`) or a transitive
/// blast-radius hit reached via the code graph. `codeSymbolId` is nullable so
/// unresolved/external references still surface in the report.
model ImpactAffectedSymbol {
  id            String  @id @default(cuid())
  impactItemId  String
  codeSymbolId  String?
  filePath      String
  qualifiedName String
  startLine     Int?
  endLine       Int?
  relation      String  @default("direct") // direct|caller|importer|dependency
  depth         Int     @default(0) // BFS distance from the direct match
  confidence    Float   @default(0.5) // 0.0–1.0

  impactItem ImpactItem  @relation(fields: [impactItemId], references: [id], onDelete: Cascade)
  codeSymbol CodeSymbol? @relation(fields: [codeSymbolId], references: [id], onDelete: SetNull)

  @@index([impactItemId])
  @@index([codeSymbolId])
  @@map("impact_affected_symbols")
}

/// Epic #168 — a single affected database table (or table+column) within an
/// ImpactItem. `columnName = null` is a table-level entry. `suggestedDdl` is a
/// syntactically-plausible DDL string derived from the requirement delta and is
/// **TEXT ONLY — never executed**. `source` records provenance
/// (live-db|mybatis|orm|ddl-file); `reconciliation` flags inferred refs that do
/// not match the live schema (matched|table-not-found|column-not-found). All
/// constrained values are stored as String (not Prisma `enum`) for sqlite/
/// postgres twin portability — see the `schema-parity` test contract.
model ImpactAffectedTable {
  id                     String   @id @default(cuid())
  impactItemId           String
  /// Epic #293 Phase 2 (#302) — object kind: table|column|procedure|function.
  /// Defaults to `table` so existing rows/readers are unaffected. For routines
  /// (`procedure`/`function`) `tableName` holds the routine's qualified name and
  /// `columnName` is null.
  objectKind             String   @default("table")
  tableName              String
  columnName             String? // null = table-level entry
  columnType             String? // live column type when known (source = live-db)
  changeKind             String   @default("reference") // add-table|add-column|alter-column|drop-column|reference
  suggestedDdl           String? // TEXT ONLY — never executed
  source                 String   @default("mybatis") // live-db|mybatis|orm|ddl-file
  reconciliation         String? // matched|table-not-found|column-not-found
  confidence             Float    @default(0.5) // 0.0–1.0
  /// Epic #295 Phase 4 (#308) — link to the canonical cross-project identity for
  /// this object when a DatabaseResource is known for the item's project.
  /// NULLABLE + SetNull: most callers (no workspace/resource context) leave it
  /// null and existing behavior is unchanged.
  schemaObjectIdentityId String?
  /// #936 (epic #929) — persisted tier from the LLM output-relevance filter:
  /// `likely` | `possible` | `unlikely`. NULLABLE: null ⇒ the filter did not run
  /// (flag off / provider offline / legacy row) and the row is read into the
  /// PRIMARY set exactly as before. `unlikely` rows are split into a low-confidence
  /// SECONDARY bucket by the read path — retained for recall, never dropped.
  relevanceTier          String?
  /// #936 — one-line LLM rationale for {@link relevanceTier}. Own column so the
  /// rationale no longer needs folding into the TEXT-ONLY `suggestedDdl` (which
  /// closed an OWASP LLM01 output-handling risk: a newline could de-comment DDL).
  relevanceRationale     String?
  /// Epic #954 (#956) — how this physical table's cross-project CONSUMER set was
  /// resolved: identity|string-match|unverifiable. NULLABLE: null ⇒ consumers
  /// were not computed (single-project / no-workspace context) and the row reads
  /// exactly as before this feature. `identity`/`string-match` carry a (possibly
  /// empty) consumer list; `unverifiable` = could-not-verify (NEVER "no
  /// consumers"). Attached only to the representative row per (item, tableName).
  consumerResolution     String?
  /// Issue #957 (Epic #954) — deterministic DDL risk class for this row's
  /// suggested change: `breaking` | `expanding` | `neutral`. Computed at crossing
  /// time by the PURE `classifyDdlRisk` (expand/contract triage over the
  /// TEXT-ONLY suggested DDL). NULLABLE: null ⇒ a legacy row written before this
  /// field existed (rendered without a risk badge). Advisory only — NEVER gates
  /// any execution path (none exists); the classifier is reused untouched.
  riskClass              String?
  createdAt              DateTime @default(now())

  impactItem           ImpactItem            @relation(fields: [impactItemId], references: [id], onDelete: Cascade)
  /// Epic #295 Phase 4 (#308) — canonical cross-project schema-object identity.
  schemaObjectIdentity SchemaObjectIdentity? @relation(fields: [schemaObjectIdentityId], references: [id], onDelete: SetNull)

  /// Epic #954 (#956) — sibling projects that read/write this shared table.
  consumers ImpactAffectedTableConsumer[]

  @@index([impactItemId])
  @@index([schemaObjectIdentityId])
  @@map("impact_affected_tables")
}

/// Epic #954 (#956) — ONE other project that reads or writes an affected shared
/// table on the same physical database. Read-only provenance: rows are derived
/// from METIS's own usage classifications (never by touching a customer DB). The
/// resolution TIER (identity vs lower-confidence string-match) lives on the
/// parent `ImpactAffectedTable.consumerResolution`; `usage` records read vs
/// write attribution for THIS consumer.
model ImpactAffectedTableConsumer {
  id                  String   @id @default(cuid())
  affectedTableId     String
  /// The sibling project that touches the shared table (never the analyzed project).
  consumerProjectId   String
  /// Display name of the sibling project, snapshotted at analysis time.
  consumerProjectName String
  /// readBy|writtenBy — a write anywhere in the consumer's evidence wins.
  usage               String   @default("readBy")
  /// Schema-qualified object identity as the consumer references it.
  objectQualifiedName String
  createdAt           DateTime @default(now())

  affectedTable ImpactAffectedTable @relation(fields: [affectedTableId], references: [id], onDelete: Cascade)

  @@index([affectedTableId])
  @@map("impact_affected_table_consumers")
}

/// Issue #966 (Epic #960) — BA relevance feedback on an affected-table row
/// (relevant | not-relevant), captured for later harvest as labeled ground
/// truth for the eval corpus (`pnpm eval:harvest-feedback`).
///
/// v1 is CAPTURE + EXPORT ONLY: this table has ZERO behavioral effect on the
/// impact engine or the #936 LLM relevance filter — it is a read-only signal
/// consumed by a HUMAN-REVIEWED harvest script, never auto-fed back in.
///
/// `impactAnalysisId` is denormalized (NOT a FK) purely for fast tenant-scoped
/// listing — mirrors `ImpactAffectedTableConsumer.consumerProjectId`; the
/// owning relation is `impactItem`. `userId`/`userDisplayName` mirror
/// `DiscussionMessage.authorUserId` (no FK to User — snapshotted, not joined).
model ImpactTableFeedback {
  id               String   @id @default(cuid())
  impactAnalysisId String
  impactItemId     String
  /// Schema-qualified table identity, matching ImpactAffectedTable.tableName.
  tableName        String
  /// Bare column name for a column-level verdict; null for a table-level verdict.
  columnName       String?
  /// relevant | not-relevant.
  verdict          String
  /// Id of the user who marked it (no FK — see model doc).
  userId           String
  /// Display name snapshot at mark time, so the UI never needs a User join.
  userDisplayName  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  impactItem ImpactItem @relation(fields: [impactItemId], references: [id], onDelete: Cascade)

  /// Idempotent per (item, table, column, user): re-marking UPDATES rather than
  /// duplicates. Uses findFirst + create/update at the call site (see
  /// schema-usage-override.ts) because the compound unique includes the
  /// NULLABLE `columnName`, which Prisma's generated `upsert` `where` cannot
  /// match against NULL.
  @@unique([impactItemId, tableName, columnName, userId])
  @@index([impactAnalysisId])
  @@index([impactItemId])
  @@map("impact_table_feedback")
}

// ============================================================================
// Platform — MCPServer, Skill, Agent, ScheduledJob, Task
// ============================================================================

model MCPServer {
  id                     String    @id @default(cuid())
  scope                  String    @default("global") // global|project|user
  projectId              String?
  /**
   * Sub-issue #277 — owning user when scope='user'.
   */
  userId                 String?
  label                  String
  transport              String // stdio|http|sse
  /**
   * Sub-issue #279 — execution runtime: native|docker-stdio|k8s-sse.
   */
  runtime                String    @default("native")
  /**
   * Sub-issue #288 — per-server CSV egress allowlist for k8s-sse NetworkPolicy. Null = use global MCP_K8S_EGRESS_ALLOWLIST.
   */
  egressAllowlist        String?
  /**
   * Sub-issue #289 — per-server k8s memory limit override (e.g. 1Gi). Null = use MCP_K8S_MEMORY_LIMIT.
   */
  k8sMemoryLimit         String?
  /**
   * Sub-issue #289 — per-server k8s CPU limit override (e.g. 2000m). Null = use MCP_K8S_CPU_LIMIT.
   */
  k8sCpuLimit            String?
  /**
   * Sub-issue #290 — when true and runtime='k8s-sse', scale Deployment to zero on idle and wake on next tool call.
   */
  coldStart              Boolean   @default(false)
  command                String? // for stdio
  args                   String? // JSON array (stdio)
  url                    String? // for http/sse
  headers                String? // JSON object (http/sse)
  envJson                String? // JSON object — values may be ${vault:label} refs
  envSecretId            String? // optional pointer to a vault secret holding env JSON
  envSecretRefs          String? // JSON map of envKey -> secretLabel (importer + UI)
  trustLevel             String    @default("untrusted") // trusted|untrusted
  defaultToolRisk        String    @default("medium") // low|medium|high
  version                String?
  sha256                 String?
  // Epic #162 — governance + integrity (Issues #104, #105).
  toolSchemaSnapshot     String? // JSON snapshot of last-approved tool schemas
  toolSchemaApprovedAt   DateTime?
  toolAllowlist          String? // JSON array of allowed tool names; null/empty = all
  requireApproval        Boolean   @default(false)
  capabilities           String? // JSON-cached capability descriptor (tools etc.)
  status                 String    @default("idle") // idle|starting|ready|error|disabled
  lastHealthCheckAt      DateTime?
  /**
   * Sub-issue #277 — last successful tool invocation; powers the idle reaper.
   */
  lastToolInvocationAt   DateTime?
  latencyMs              Int?
  failureCount           Int       @default(0)
  lastError              String?
  healthCheckIntervalSec Int       @default(60)
  enabled                Boolean   @default(true)
  createdById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  project       Project?              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  envSecret     Secret?               @relation(fields: [envSecretId], references: [id], onDelete: SetNull)
  createdBy     User?                 @relation("McpCreator", fields: [createdById], references: [id], onDelete: SetNull)
  projectAllows ProjectMCPAllowlist[]
  approvals     MCPToolApproval[]

  @@unique([scope, projectId, label])
  @@index([scope])
  @@index([status])
  @@index([userId])
  @@map("mcp_servers")
}

model ProjectMCPAllowlist {
  projectId   String
  mcpServerId String
  createdAt   DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mcpServer MCPServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)

  @@id([projectId, mcpServerId])
  @@index([mcpServerId])
  @@map("project_mcp_allowlists")
}

// Epic #162 — per-tool, per-session approval audit log (Issue #104).
model MCPToolApproval {
  id        String    @id @default(cuid())
  sessionId String
  serverId  String
  toolName  String
  args      String? // JSON-encoded arguments
  status    String    @default("pending") // pending|approved|denied|timeout
  createdAt DateTime  @default(now())
  decidedAt DateTime?
  decidedBy String?

  server  MCPServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  decider User?     @relation("McpApprovalDecider", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([status])
  @@map("mcp_tool_approvals")
}

// Epic #162 — 24h cache of the public MCP registry payload (Issue #98).
model MCPRegistryCache {
  id        String   @id @default("singleton")
  fetchedAt DateTime
  payload   String

  @@map("mcp_registry_cache")
}

// Epic #195 — federated MCP server discovery cache (Smithery + Official
// Registry mirror). Each row is a READ-ONLY snapshot of an external entry.
// Installation creates a normal `MCPServer` row from `manifest`; this table
// never participates in lifecycle/runtime decisions.
model McpRegistryEntry {
  id          String    @id @default(cuid())
  /// "smithery" | "official" | "local" (mirrored back here on local install
  /// so federation refreshers can dedupe across sources).
  source      String
  /// Vendor-specific identifier (e.g. `@modelcontextprotocol/server-postgres`).
  externalId  String
  /// Human-readable display name.
  name        String
  description String?   @default("")
  publisher   String?
  /// Latest known version string.
  version     String?
  /// Optional aggregate stats surfaced in the federated browser.
  downloads   Int?
  stars       Int?
  /// Upstream `lastUpdated` / `updatedAt` timestamp. Null when unavailable.
  lastUpdated DateTime?
  /// SHA-256 of the canonical install manifest captured at fetch time. The
  /// integrity gate (PR #181) uses this to detect drift between snapshot
  /// and install.
  sha256      String?
  /// JSON-encoded install manifest (stdio/http/sse + command/args/url).
  manifest    String    @default("{}")
  /// JSON-encoded extra metadata from the upstream registry (tags, license,
  /// homepage, etc). Opaque to METIS — surfaced verbatim in the UI.
  metadata    String    @default("{}")
  fetchedAt   DateTime  @default(now())

  @@unique([source, externalId])
  @@index([source])
  @@index([fetchedAt])
  @@map("mcp_registry_entries")
}

// ============================================================================
// Spec Kit Mode (Epic #193 — v1.2.0)
// ============================================================================
/// Cached snapshot of a Spec Kit `.specify/<name>` file. The DB row is the
/// authoritative store in v1.2 — projects without a working repo never
/// touch the filesystem. Allowed `name` values are validated by the route
/// layer and constrained to the canonical Spec Kit set
/// (`spec.md` | `plan.md` | `tasks.md` | `constitution.md` |
/// `clarify.md` | `analysis.md`).
model SpecKitArtifact {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  content     String   @default("")
  /// Monotonically incremented on every PUT so optimistic-concurrency
  /// callers can detect lost updates.
  version     Int      @default(1)
  /// User id of the last writer, or null for system-generated content.
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
  @@map("spec_kit_artifacts")
}

/// Epic #396 — per-feature directory model (`specs/NNN-slug/`). One row per
/// `/speckit.specify` invocation. The `slug` is the canonical Spec Kit form
/// `NNN-kebab-name` (NNN monotonic per project, zero-padded to 3 digits).
/// Branch automation is opt-in via `SPECKIT_AUTOBRANCH=true`.
model SpecKitFeature {
  id          String   @id @default(cuid())
  projectId   String
  /// `NNN-kebab-name`, validated against `^\d{3}-[a-z0-9-]{1,80}$`.
  slug        String
  title       String
  /// Lifecycle: `draft` | `specified` | `planned` | `tasked` | `implemented`.
  status      String   @default("draft")
  /// Git branch created by `/speckit.specify` when SPECKIT_AUTOBRANCH=true.
  branchName  String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project           Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artifacts         SpecKitFeatureArtifact[]
  /// Epic #475 — discussion threads anchored to this feature (nullable anchor).
  discussionThreads DiscussionThread[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@map("spec_kit_features")
}

/// Epic #396 — per-feature artifact (free-form key, e.g. `spec.md`,
/// `plan.md`, `research.md`, `data-model.md`, `tasks.md`, `quickstart.md`,
/// `analysis.md`, `clarify.md`, `checklist-security.md`, or
/// `contracts/api.openapi.yaml`).
model SpecKitFeatureArtifact {
  id          String   @id @default(cuid())
  featureId   String
  key         String
  content     String   @default("")
  version     Int      @default(1)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  feature SpecKitFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([featureId, key])
  @@index([featureId])
  @@map("spec_kit_feature_artifacts")
}

/// Epic #396 (MVP-2) — Spec Kit constitution metadata. Content stays in the
/// existing `SpecKitArtifact` row keyed `constitution.md` (preserves
/// backward compat with v1.2). This row tracks semver + ratification dates.
model SpecKitConstitution {
  id            String    @id @default(cuid())
  projectId     String    @unique
  version       String    @default("0.0.0")
  ratifiedAt    DateTime?
  lastAmendedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("spec_kit_constitutions")
}

/// Epic #396 (MVP-3) — per-project Spec Kit configuration. JSON-as-String
/// for cross-DB portability (matches the established pattern used by
/// `Project.sandboxEgressAllowlist`).
model SpecKitConfig {
  id                      String   @id @default(cuid())
  projectId               String   @unique
  /// JSON array of domain slugs for `/speckit.checklist`. Empty = use defaults.
  checklistDomains        String   @default("[]")
  /// Optional GitHub parent epic number for `/speckit.taskstoissues` exports.
  tasksToIssuesParentEpic Int?
  /// Optional `owner/repo` override for `/speckit.taskstoissues`.
  tasksToIssuesRepo       String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("spec_kit_configs")
}

/// Epic #396 (MVP-4) — idempotency map for `/speckit.taskstoissues`. Keyed
/// by `(featureSlug, taskId)` so re-exports upsert instead of duplicating.
model SpecKitTaskExport {
  id          String   @id @default(cuid())
  projectId   String
  featureSlug String
  taskId      String
  issueNumber Int
  repoOwner   String
  repoName    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, featureSlug, taskId])
  @@index([projectId, featureSlug])
  @@map("spec_kit_task_exports")
}

// ============================================================================
// Phase 10 — Skills + Agents Library
//
// Skills and Agents are YAML-frontmatter Markdown definitions imported from
// local files, GitHub repos, or auto-discovered from the running project's
// `.github/skills` + `.github/agents` directories. Each save creates an
// immutable Version row so we can diff and roll back. Per-project allow-lists
// gate which globally-defined items are usable in a given project.
// ============================================================================

model Skill {
  id            String    @id @default(cuid())
  key           String    @unique
  name          String
  description   String    @default("")
  /// Latest semver — bumped on every save. SkillVersion stores history.
  version       String    @default("0.1.0")
  /// Markdown body (instructions). May be empty when a skill is metadata-only.
  instructions  String    @default("")
  /// JSON array of tool names (HINT only, not a security boundary).
  tools         String    @default("[]")
  /// JSON array of resource paths/refs (informational).
  resources     String    @default("[]")
  /// JSON array of free-form tags used for /library search.
  tags          String    @default("[]")
  /// JSON copy of validated frontmatter (kept for round-tripping).
  manifest      String    @default("{}")
  /// SHA-256 of the canonical (frontmatter + body) source — used for dedup
  /// and audit-log integrity.
  contentSha256 String?
  /// Origin marker — local|repo:<connectionId>|filesystem:<path>|inline.
  source        String    @default("inline")
  enabled       Boolean   @default(true)
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  archivedAt    DateTime?
  deletedAt     DateTime?

  createdBy  User?                   @relation("SkillCreator", fields: [createdById], references: [id], onDelete: SetNull)
  agents     AgentSkill[]
  versions   SkillVersion[]
  allowlists ProjectSkillAllowlist[]

  @@index([enabled, deletedAt])
  @@map("skills")
}

model SkillVersion {
  id            String   @id @default(cuid())
  skillId       String
  version       String
  manifest      String   @default("{}")
  instructions  String   @default("")
  contentSha256 String
  createdById   String?
  createdAt     DateTime @default(now())

  skill     Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdBy User? @relation("SkillVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([skillId, version])
  @@index([skillId, createdAt])
  @@map("skill_versions")
}

model Agent {
  id            String    @id @default(cuid())
  key           String    @unique
  name          String
  /// Optional human-friendly label distinct from the unique key/name.
  displayName   String    @default("")
  description   String    @default("")
  model         String    @default("")
  /// System prompt / persona body (Markdown).
  systemPrompt  String    @default("")
  /// JSON array of tool names (HINT only, not a security boundary).
  tools         String    @default("[]")
  /// JSON array of free-form tags.
  tags          String    @default("[]")
  /// JSON-encoded handoff rule list (free form).
  handoffs      String    @default("[]")
  /// JSON copy of validated frontmatter for round-tripping.
  manifest      String    @default("{}")
  contentSha256 String?
  source        String    @default("inline")
  enabled       Boolean   @default(true)
  version       String    @default("0.1.0")
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  archivedAt    DateTime?
  deletedAt     DateTime?

  createdBy  User?                   @relation("AgentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  skills     AgentSkill[]
  versions   AgentVersion[]
  allowlists ProjectAgentAllowlist[]
  sessions   AISession[]

  @@index([enabled, deletedAt])
  @@map("agents")
}

model AgentVersion {
  id            String   @id @default(cuid())
  agentId       String
  version       String
  manifest      String   @default("{}")
  systemPrompt  String   @default("")
  contentSha256 String
  createdById   String?
  createdAt     DateTime @default(now())

  agent     Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AgentVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([agentId, version])
  @@index([agentId, createdAt])
  @@map("agent_versions")
}

model AgentSkill {
  agentId String
  skillId String

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([agentId, skillId])
  @@index([skillId])
  @@map("agent_skills")
}

model ProjectSkillAllowlist {
  projectId String
  skillId   String
  enabled   Boolean  @default(true)
  addedById String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
  @@map("project_skill_allowlists")
}

model ProjectAgentAllowlist {
  projectId String
  agentId   String
  enabled   Boolean  @default(true)
  addedById String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([projectId, agentId])
  @@index([agentId])
  @@map("project_agent_allowlists")
}

model ScheduledJob {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  cron        String
  taskType    String    @default("http-webhook") // discriminator for the executor handler
  payload     String    @default("{}") // JSON-encoded polymorphic payload
  projectId   String?
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?
  /// Persisted idempotency guard for cron firings — set conditionally so two
  /// processes (or a restart-within-minute) can never enqueue the same instant
  /// twice. Distinct from `lastRunAt` which records the *last enqueue attempt*.
  lastFiredAt DateTime?
  nextRunAt   DateTime?
  maxAttempts Int       @default(3)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@index([enabled, nextRunAt])
  @@index([projectId])
  @@map("scheduled_jobs")
}

model Task {
  id             String    @id @default(cuid())
  scheduledJobId String?
  projectId      String?
  type           String // task type discriminator
  trigger        String    @default("manual") // scheduled|manual|retry|webhook
  status         String    @default("pending") // pending|running|completed|failed|cancelled
  priority       Int       @default(5) // 1=highest, 10=lowest
  payload        String    @default("{}") // JSON-encoded polymorphic payload
  result         String? // JSON-encoded result
  errorMessage   String?
  progress       Int? // 0-100 progress for long-running tasks
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  scheduledFor   DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  scheduledJob ScheduledJob? @relation(fields: [scheduledJobId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, priority, createdAt])
  @@index([scheduledJobId])
  @@index([type, status])
  @@index([projectId, status])
  @@map("tasks")
}

// ============================================================================
// AI Engine — Sessions, token accounting, tool-approval audit trail (Phase 4)
// ============================================================================

model AISession {
  id                     String    @id @default(cuid())
  userId                 String
  projectId              String?
  title                  String    @default("New Chat")
  /// Provider key — copilot|bedrock-gateway|offline-stub|openai|azure|anthropic
  provider               String
  model                  String
  /// JSON-encoded ApprovalPolicy: { low, medium, high } each one of auto|prompt-once|always-prompt|deny
  policy                 String    @default("{\"low\":\"auto\",\"medium\":\"prompt-once\",\"high\":\"always-prompt\"}")
  status                 String    @default("active") // active|archived|terminated
  /// Optional ${vault:id} reference for BYOK credentials override
  providerSecretRef      String?
  /// Per-session COPILOT_HOME directory (R-SDK-9 isolation) — populated lazily
  copilotHome            String?
  /// Phase 10 — optional Agent persona attached to this session.
  agentId                String?
  /// Phase 10 — frozen agent name + version recorded for audit.
  agentSnapshot          String?
  /// Phase 10 — JSON array of skill ids whose instructions were loaded into
  /// the prompt. Used by the load-skill tool to enforce no-op on repeats.
  loadedSkillIds         String    @default("[]")
  /// Epic #165 — mid-session `/model` switching. When non-null, requests
  /// route to this model instead of the original `model` column. The original
  /// `model` is kept for telemetry continuity and audit.
  currentModel           String?
  /// Reasoning-effort flag (low|medium|high) honoured by extended-thinking
  /// models. Cleared when `currentModel` does not support it.
  currentReasoningEffort String?
  /// Plan-mode flag — true while the orchestrator is waiting on
  /// `POST /api/ai/sessions/:id/approve-plan`. Set on session start when
  /// `Project.planModeRequired` is true.
  planModeActive         Boolean   @default(false)
  /// Periodic snapshot of the full session state (message history, current
  /// model, loaded skills, custom-agent set). Updated every
  /// SESSION_SNAPSHOT_INTERVAL messages by the chat handler.
  snapshot               String?
  /// Last-snapshot timestamp — used by the resume listing to filter expired
  /// sessions and by the snapshot interval logic.
  snapshotUpdatedAt      DateTime?
  /// Epic #156 (#150) — context compaction.
  lastCompactedAt        DateTime?
  compactionCount        Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  project            Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agent              Agent?              @relation(fields: [agentId], references: [id], onDelete: SetNull)
  tokenUsages        AITokenUsage[]
  toolApprovals      AIToolApproval[]
  plans              SessionPlan[]
  /// Epic #475 — AI discussion replies backed by this session (for token accounting).
  discussionMessages DiscussionMessage[]

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([agentId])
  @@map("ai_sessions")
}

model AITokenUsage {
  id                  String   @id @default(cuid())
  sessionId           String
  userId              String
  provider            String
  model               String
  promptTokens        Int      @default(0)
  completionTokens    Int      @default(0)
  totalTokens         Int      @default(0)
  /// R-C2 cache accounting (Bedrock prompt caching)
  cacheReadTokens     Int      @default(0)
  cacheWriteTokens    Int      @default(0)
  /// sha256 hex of the prompt content for de-duplication / privacy
  promptHash          String?
  /// Per-category token breakdown (JSON). NULL for legacy rows.
  categoryBreakdown   String?  @map("category_breakdown")
  /// Day bucket (UTC YYYY-MM-DD) for fast daily rollups per user
  dayBucket           String
  ts                  DateTime @default(now())
  /// Epic #594 — optional project association for cost allocation.
  projectId           String?
  /// Epic #594 — Bedrock inference profile ARN used for this invocation.
  inferenceProfileArn String?
  /// Epic #594 — estimated cost in USD based on model pricing.
  estimatedCostUsd    Float?
  /// Epic #594 — agent pipeline step that generated this usage (e.g. "analysis", "chat").
  agentStep           String?

  session AISession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, ts])
  @@index([userId, dayBucket])
  @@index([ts])
  @@index([projectId, ts])
  @@map("ai_token_usages")
}

// ============================================================================
// Collaborative discussions (Epic #475) — multi-analyst realtime threads with
// the LLM as an on-mention participant.
// ============================================================================

/// Epic #475 (Phase 1, #476) — a shared, project-scoped discussion room where
/// multiple analysts and the LLM collaborate. Purpose-built (NOT an extension
/// of single-user `AISession`, NOT a reuse of `Comment` whose `authorId` is a
/// non-null FK to User and so cannot attribute a message to the AI).
///
/// Anchoring is OPTIONAL and additive: a thread may point at a `Requirement`,
/// `Analysis` run, or `SpecKitFeature` for context. All three anchor columns are
/// nullable so adding anchoring later is non-breaking (UI lands in Phase 4).
///
/// `aiResponseMode` is a 3-state String enum (the epic's confirmed product
/// decision, superseding the earlier binary `aiAutoRespond` toggle):
///   - `off`        — the AI never auto-responds, even when @AI-mentioned.
///   - `on_mention` — DEFAULT — the AI replies only when explicitly @AI-mentioned.
///   - `auto`       — proactive — the AI replies whenever a clear question/request
///                    is detected, no mention required.
/// Stored as String for SQLite/Postgres portability (the repo uses no native
/// Prisma enums). The allowed set is enforced in application code.
model DiscussionThread {
  id               String    @id @default(cuid())
  projectId        String
  /// Optional anchors — nullable so anchoring is a non-breaking add. At most one
  /// is expected to be set in practice; not enforced at the DB level.
  requirementId    String?
  analysisId       String?
  specKitFeatureId String?
  title            String    @default("New Discussion")
  /// off|on_mention|auto — default on_mention (epic #475 confirmed decision).
  aiResponseMode   String    @default("on_mention")
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement    Requirement?        @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  analysis       Analysis?           @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  specKitFeature SpecKitFeature?     @relation(fields: [specKitFeatureId], references: [id], onDelete: SetNull)
  createdBy      User                @relation("DiscussionThreadCreator", fields: [createdById], references: [id])
  messages       DiscussionMessage[]
  /// Epic #547 Phase 1 (#549) — Teams channel link (at most one per thread).
  teamsChannelLink TeamsChannelLink?

  @@index([projectId])
  @@index([requirementId])
  @@index([analysisId])
  @@index([specKitFeatureId])
  @@map("discussion_threads")
}

/// Epic #475 (Phase 1, #476) — a single message in a `DiscussionThread`. The
/// `authorKind` discriminator separates human↔human messages (which incur NO
/// AI billing) from AI replies (which link back to an `AISession` for
/// `AITokenUsage` accounting and audit).
///
/// Invariant (documented + enforced in application code, see
/// `server/src/lib/discussions/message-invariant.ts`):
///   - authorKind = "human" ⇒ authorUserId SET, aiModel/aiProvider/aiSessionId NULL
///   - authorKind = "ai"    ⇒ aiModel SET, authorUserId NULL
/// SQLite/Postgres have no portable partial-CHECK we rely on, so the invariant
/// is asserted before every insert.
model DiscussionMessage {
  id           String    @id @default(cuid())
  threadId     String
  /// human|ai — author discriminator (the single real gap vs `Comment`).
  authorKind   String
  /// Set iff authorKind = human.
  authorUserId String?
  /// Set iff authorKind = ai.
  aiProvider   String?
  aiModel      String?
  aiSessionId  String?
  body         String
  /// Epic #547 Phase 2 (#550) — message ORIGIN / loop-guard discriminator.
  /// `metis` (default) for messages created in-app; `teams` for messages
  /// ingested from a linked Teams channel (set by inbound sync #551). Outbound
  /// mirroring (#550) skips `teams`-origin rows so a Teams-sourced message is
  /// never echoed back out to Teams (no echo loop). Free-form like `authorKind`.
  origin       String    @default("metis")
  createdAt    DateTime  @default(now())
  editedAt     DateTime?
  deletedAt    DateTime?

  thread     DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorUser User?            @relation("DiscussionMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  aiSession  AISession?       @relation(fields: [aiSessionId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@map("discussion_messages")
}

model AIToolApproval {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  toolName  String
  risk      String // low|medium|high
  /// approve|deny|auto-approve|expired|error
  decision  String
  reason    String?
  /// sha256 hex of the canonical JSON-encoded tool args
  argsHash  String
  ts        DateTime @default(now())

  session AISession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, ts])
  @@index([toolName])
  @@index([userId, ts])
  @@map("ai_tool_approvals")
}

// ============================================================================
// Observability + Interop (Epic #158 — v1.1.0)
// ============================================================================
/// Deterministic replay of a multi-agent or single-chat run (#110).
model AgentRun {
  id          String    @id @default(cuid())
  sessionId   String
  projectId   String?
  kind        String    @default("chat")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  latencyMs   Int?
  totalTokens Int       @default(0)
  costCents   Int       @default(0)
  status      String    @default("running")

  steps AgentRunStep[]

  @@index([projectId, startedAt])
  @@index([sessionId, startedAt])
  @@index([status])
  @@map("agent_runs")
}

/// Ordered step within an AgentRun (#110 / #153).
model AgentRunStep {
  id        String   @id @default(cuid())
  runId     String
  ord       Int
  kind      String
  content   String
  spanId    String?
  traceId   String?
  latencyMs Int?
  createdAt DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, ord])
  @@map("agent_run_steps")
}

/// Parsed AGENTS.md agent definition discovered in an ingested repo (#154).
model KnownAgentDefinition {
  id           String   @id @default(cuid())
  projectId    String
  source       String   @default("agents-md")
  name         String
  description  String   @default("")
  systemPrompt String   @default("")
  tools        String   @default("[]")
  model        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
  @@map("known_agent_definitions")
}

// ============================================================================
// Epic #165 — Copilot SDK alignment (v1.1.0)
// ============================================================================

/// User-defined or built-in custom agent. The four built-ins
/// (BA / Architect / PO / QA) are seeded with `isBuiltIn=true, projectId=null`
/// and cannot be deleted via the API. Project-scoped agents (`projectId` set)
/// override built-ins of the same name.
model CustomAgent {
  id              String   @id @default(cuid())
  /// `null` for the built-in fleet; otherwise the project that owns this agent.
  projectId       String?
  name            String
  description     String   @default("")
  systemPrompt    String   @default("")
  /// JSON array of tool names this agent is permitted to call.
  tools           String   @default("[]")
  /// Optional per-agent model override; `null` falls back to session default.
  model           String?
  /// Reasoning-effort hint for extended-thinking models (low|medium|high).
  reasoningEffort String?
  isBuiltIn       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project     Project?                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  enablements CustomAgentEnablement[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("custom_agents")
}

/// Epic #260 (#79) — per-project enablement of a CustomAgent. A
/// workspace-shared agent (a `CustomAgent` with `projectId = null`) or a
/// built-in is opted IN to a specific project by a row here. This is a
/// DEDICATED join, distinct from the Library `Agent` enablement
/// (`ProjectAgentAllowlist`) which gates a different model. The
/// `(customAgentId, projectId)` pair is unique so enable is idempotent;
/// `enabled` lets a project soft-disable without losing the row's audit trail.
model CustomAgentEnablement {
  id            String   @id @default(cuid())
  customAgentId String
  projectId     String
  enabled       Boolean  @default(true)
  /// User id that toggled the enablement (for SOC 2 traceability). Nullable
  /// for system-seeded rows.
  enabledById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customAgent CustomAgent @relation(fields: [customAgentId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([customAgentId, projectId])
  @@index([projectId, enabled])
  @@index([customAgentId])
  @@map("custom_agent_enablements")
}

/// Per-project lifecycle hook subscription. `event` is one of the six bus
/// events; `handlerKind` selects how the bus invokes the handler. v1.1 ships
/// `webhook` + `builtin`; `script` is reserved for v1.2.
model HookSubscription {
  id          String   @id @default(cuid())
  projectId   String
  event       String // preToolUse|postToolUse|sessionStart|sessionEnd|userPromptSubmit|notification
  handlerKind String   @default("webhook") // webhook|builtin|script
  /// JSON config: { url?, headers?, builtinName?, scriptPath? }.
  config      String   @default("{}")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, event])
  @@index([enabled])
  @@map("hook_subscriptions")
}

/// Plan-mode artifact. One row per pending plan; status drives the chat-side
/// approve / reject panel.
model SessionPlan {
  id        String    @id @default(cuid())
  sessionId String
  planText  String
  status    String    @default("pending") // pending|approved|rejected
  decidedAt DateTime?
  decidedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  session AISession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@map("session_plans")
}

// ============================================================================
// Epic #156 — Async agent platform (v1.1.0)
// ============================================================================

/// Long-running background run drained by the async runner. Replaces
/// ad-hoc fire-and-forget setImmediate work with a durable, queryable
/// table that survives restarts and surfaces in the dashboard widget.
model BackgroundRun {
  id          String    @id @default(cuid())
  projectId   String
  sessionId   String?
  /// `analysis|chat|browse|custom`.
  kind        String
  /// JSON-encoded payload — the runner deserializes this when the row is
  /// dequeued. Keep small (DB-cell limits in postgres).
  payload     String    @default("{}")
  /// queued|running|paused|cancelled|failed|succeeded.
  status      String    @default("queued")
  priority    Int       @default(0)
  /// Optional run-group membership (best-of-N).
  runGroupId  String?
  /// Heartbeat updated by the runner each step; used by restart-recovery.
  heartbeatAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  error       String?
  /// JSON-serialized result for `succeeded` runs (null otherwise).
  result      String?
  /// Score used by selectionMethod=highest-score.
  score       Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runGroup RunGroup?    @relation(fields: [runGroupId], references: [id], onDelete: SetNull)
  messages RunMessage[]

  @@index([projectId, status])
  @@index([status, priority])
  @@index([runGroupId])
  @@map("background_runs")
}

/// Event-driven trigger configuration. `cron` triggers piggy-back on the
/// Phase-11 scheduler; webhook/github/slack triggers are HTTP-driven.
model Trigger {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  /// webhook|github|slack|cron.
  source      String
  /// JSON: { secret?, repo?, event?, channel?, cronExpr? }.
  config      String    @default("{}")
  enabled     Boolean   @default(true)
  /// Most-recent fire timestamp (audit + UI).
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, source])
  @@index([enabled])
  @@map("triggers")
}

/// Best-of-N / parallel run group. Each row spawns N child BackgroundRuns;
/// once all complete, the selection step picks a winner and updates the
/// `winnerRunId`.
model RunGroup {
  id              String   @id @default(cuid())
  projectId       String
  parentRunId     String?
  n               Int      @default(1)
  /// best-of-n|parallel.
  strategy        String   @default("best-of-n")
  /// judge-llm|highest-score|manual.
  selectionMethod String   @default("highest-score")
  winnerRunId     String?
  /// pending|running|completed|failed.
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs    BackgroundRun[]

  @@index([projectId, status])
  @@map("run_groups")
}

/// Mid-run steering message. Queued during an active run; the runner
/// drains queued messages at every step boundary.
model RunMessage {
  id          String    @id @default(cuid())
  runId       String
  ord         Int
  /// system|user|agent.
  role        String
  content     String
  /// queued|delivered.
  status      String    @default("queued")
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  run BackgroundRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, ord])
  @@index([runId, status])
  @@map("run_messages")
}

// ============================================================================
// ACP Server (Epic #163, Issue #119 — v1.1.0)
// ============================================================================
/// Per-user API token used by the Agent Client Protocol server. Stored as
/// a SHA-256 hash; the plaintext value is shown ONCE at creation. Tokens
/// are bearer credentials and are revoked by setting `revokedAt`.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  /// Hex-encoded SHA-256 of the issued token. Lookup uses an index on this.
  tokenHash  String    @unique
  /// First 8 chars of the plaintext shown so the user can identify which
  /// token they're looking at in the list view (no security risk).
  prefix     String
  scopes     String    @default("[]") // JSON array of scope strings
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([revokedAt])
  @@map("api_tokens")
}

// ============================================================================
// Eval & Bench (Epic #194 — v1.2.0)
// ============================================================================
/// Persisted result of a benchmark run (SWE-bench-Pro, TAU-bench). One row
/// per nightly cron execution; powers `GET /api/eval/leaderboard` and the
/// OPERATIONS dashboard widget.
model BenchRun {
  id            String    @id @default(cuid())
  /// Benchmark suite key — `swe-bench-pro` | `tau-bench`.
  benchmark     String
  /// Model id used (e.g. `claude-sonnet-4`, `gpt-5-codex`).
  model         String
  /// Pass rate ∈ [0,1].
  score         Float     @default(0)
  totalTasks    Int       @default(0)
  passedTasks   Int       @default(0)
  meanTokens    Int       @default(0)
  meanCostCents Int       @default(0)
  meanLatencyMs Int       @default(0)
  startedAt     DateTime
  completedAt   DateTime?
  /// running|completed|failed|disabled.
  status        String    @default("running")
  /// JSON envelope for run-level metadata (commit SHA, env flags, etc.).
  metadata      String    @default("{}")
  createdAt     DateTime  @default(now())

  tasks BenchTaskResult[]

  @@index([benchmark, startedAt])
  @@index([status])
  @@map("bench_runs")
}

/// Per-task detail for a BenchRun. Used by the leaderboard diff viewer to
/// compare expected vs actual output for failing tasks.
model BenchTaskResult {
  id         String   @id @default(cuid())
  benchRunId String
  taskId     String
  passed     Boolean  @default(false)
  score      Float    @default(0)
  tokens     Int      @default(0)
  costCents  Int      @default(0)
  latencyMs  Int      @default(0)
  expected   String?
  actual     String?
  error      String?
  createdAt  DateTime @default(now())

  run BenchRun @relation(fields: [benchRunId], references: [id], onDelete: Cascade)

  @@index([benchRunId])
  @@index([taskId])
  @@map("bench_task_results")
}

// ============================================================================
// Code Discovery / AST Graph (Epic #298)
// ----------------------------------------------------------------------------
// Foundation tables for the AST-derived code graph. Populated by the
// repo-ingest tree-sitter pass (sub-issue #308) and read by the MCP tools
// (sub-issue #310) and the project-overview generator (sub-issue #313).
//
// Symbol kinds: function | class | interface | type | module | method
// Edge kinds:   calls | imports | defines | references
// ============================================================================
model CodeGraph {
  id               String    @id @default(cuid())
  projectId        String
  /// Optional FK to RepoConnection when the graph was sourced from a single repo.
  /// Nullable so document-only ingests still produce a CodeGraph row.
  repoConnectionId String?
  commitSha        String?
  /// Aggregate counts maintained by the ingest pipeline. Cheap to read for the
  /// project-overview "summary" line; recomputed on every full re-ingest.
  symbolCount      Int       @default(0)
  edgeCount        Int       @default(0)
  /// JSON-encoded `Record<string, number>` of language → symbol count.
  /// Used by the overview generator to produce "TypeScript: 412, Python: 88".
  languageStats    String    @default("{}")
  lastIndexedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repoConnection RepoConnection? @relation("CodeGraphRepo", fields: [repoConnectionId], references: [id], onDelete: SetNull)

  symbols CodeSymbol[]
  edges   CodeEdge[]

  @@unique([projectId, repoConnectionId])
  @@index([projectId])
  @@map("code_graphs")
}

model CodeSymbol {
  id            String   @id @default(cuid())
  codeGraphId   String
  projectId     String // denormalised for fast (projectId, kind) reads from the MCP tools
  kind          String // function | class | interface | type | module | method | table | column
  name          String
  qualifiedName String // e.g. "server/src/lib/x.ts::Foo.bar"
  filePath      String
  startLine     Int
  endLine       Int
  language      String // ts | js | py | go | java | sql
  /// SHA256 of the symbol's source slice — used by incremental ingest to
  /// detect "unchanged file → skip" without re-parsing.
  contentHash   String
  /// Epic #168 — provenance for schema symbols (table/column):
  /// live-db | mybatis | orm | ddl-file. Null for ordinary code symbols.
  source        String?
  createdAt     DateTime @default(now())

  graph   CodeGraph @relation(fields: [codeGraphId], references: [id], onDelete: Cascade)
  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fromEdges               CodeEdge[]               @relation("EdgeFrom")
  toEdges                 CodeEdge[]               @relation("EdgeTo")
  findings                Finding[]                @relation("SymbolFindings")
  /// Epic #708 — candidate findings produced by the AI Bug Scanner.
  scanFindings            ScanFinding[]
  /// Epic #159 — requirement→code mappings + impact affected-symbol rows.
  requirementCodeMappings RequirementCodeMapping[]
  impactAffectedSymbols   ImpactAffectedSymbol[]
  /// Epic #207 — spec→code mappings (traceability spine).
  specCodeMappings        SpecCodeMapping[]
  /// Epic #780 / Issue #797 — the symbol's embedding metadata (vector lives in
  /// the vector store; this row holds the index-time text + model tag).
  embedding               CodeSymbolEmbedding?

  @@index([projectId, kind])
  @@index([projectId, qualifiedName])
  @@index([codeGraphId, filePath])
  @@map("code_symbols")
}
/// Epic #780 / Issue #797 — durable metadata for one symbol's embedding.
///
/// The VECTOR does not live here. It lives in the shared {@link VectorStore}
/// under the synthetic namespace `${projectId}__symbols`, exactly like document
/// chunks live in `rag_vectors` and not in `KnowledgeChunk` — a `vector(N)`
/// column's width is runtime-derived from the active embedder and a static
/// Prisma migration cannot express it (see `vector-store-pgvector.ts`).
///
/// What this row IS: the index-time TEXT (`formatSymbolForEmbedding` output),
/// its content hash, and the model tag. The text is the source of truth a
/// re-index reads, which is what lets a model flip re-embed every symbol with
/// NO repo checkout — `CodeSymbol` stores no signature, docstring or body.
model CodeSymbolEmbedding {
  id          String @id @default(cuid())
  projectId   String
  codeGraphId String
  /// 1:1 with the symbol. Cascade-deleted, so ingest's delete-then-recreate of a
  /// re-parsed file's symbols prunes the stale rows for free.
  symbolId    String @unique
  /// `formatSymbolForEmbedding()` output — the exact text that was embedded.
  text        String
  /// SHA-256 of `text`. Incremental skip key: unchanged hash ⇒ no re-embed.
  contentHash String
  /// Empty string = PENDING (row written by ingest, vector not yet computed).
  /// Otherwise the id of the model whose vector is live for this symbol.
  embeddingModel String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  symbol  CodeSymbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, embeddingModel])
  @@index([codeGraphId])
  @@map("code_symbol_embeddings")
}


model CodeEdge {
  id              String   @id @default(cuid())
  codeGraphId     String
  projectId       String // denormalised for (projectId, kind) reads
  kind            String // calls | imports | defines | references | reads | writes | persists-to
  fromSymbolId    String
  /// Nullable when the target is an unresolved external (third-party import,
  /// dynamic call, missing definition). `toQualifiedName` carries the textual
  /// reference in that case so the MCP tools can still surface "who_calls".
  toSymbolId      String?
  toQualifiedName String?
  filePath        String
  line            Int
  /// Edge-specific metadata (JSON-encoded). For TS imports stores
  /// `{ "typeOnly": true }` so the type-only-vs-value-import distinction
  /// is preserved (acceptance criterion in #308).
  metadata        String?
  /// Epic #168 — provenance for schema edges (reads/writes/persists-to):
  /// live-db | mybatis | orm | ddl-file. Null for ordinary code edges.
  source          String?
  createdAt       DateTime @default(now())

  graph      CodeGraph   @relation(fields: [codeGraphId], references: [id], onDelete: Cascade)
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromSymbol CodeSymbol  @relation("EdgeFrom", fields: [fromSymbolId], references: [id], onDelete: Cascade)
  toSymbol   CodeSymbol? @relation("EdgeTo", fields: [toSymbolId], references: [id], onDelete: SetNull)

  @@index([fromSymbolId, kind])
  @@index([toSymbolId, kind])
  @@index([projectId, kind])
  @@index([codeGraphId, filePath])
  @@map("code_edges")
}

/// Epic #292 (#297) — per-object used/unreferenced/uncertain classification,
/// produced by reconciling the introspected full schema (`driver.introspect()`)
/// against the code→schema graph edges. One row per table/column per project;
/// the whole set is replaced on each (re)classification run. `usageClass`,
/// `kind`, `uncertainReason` are stored as String (not Prisma `enum`) for
/// sqlite/postgres twin portability (see `schema-parity` test contract).
/// `evidence` is a JSON-encoded `UsageEvidence[]` (inbound-edge citations).
/// `overriddenClass` is the reserved manual-override seam (Phase 3 #304) — null
/// until a human overrides; `uncertain` objects are NEVER auto-recommended for
/// dropping.
model SchemaUsageClassification {
  id              String   @id @default(cuid())
  projectId       String
  /// `table` | `column`.
  kind            String
  /// Schema-qualified table identity (`<schema>.<table>` or bare `<table>`).
  tableName       String
  /// Bare column name for column rows; null for table rows.
  columnName      String?
  /// Live column type when the object is a column present in introspection.
  columnType      String?
  /// `used` | `unreferenced` | `uncertain`.
  usageClass      String
  /// Required when `usageClass = uncertain`: `table-not-found` |
  /// `column-not-found` | `dynamic-reference`. Null otherwise.
  uncertainReason String?
  /// JSON-encoded `UsageEvidence[]` — inbound code-edge citations.
  evidence        String   @default("[]")
  /// Manual-override seam (Phase 3 #304). Null until a human overrides.
  overriddenClass String?
  computedAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, usageClass])
  @@index([projectId, tableName])
  @@map("schema_usage_classifications")
}

/// Epic #294 (#304) — manual-override assertions for schema usage. Lets an
/// analyst correct/augment a usage edge the SQL parser cannot derive from
/// dynamic SQL (e.g. assert a runtime-built query DOES touch `orders.total`).
/// Persisted with `source = "manual"`; overrides take PRECEDENCE over derived
/// classifications (see SCHEMA_SOURCE_PRECEDENCE in @metis/shared). One row per
/// (project, table, column?, access) — re-asserting updates the existing row.
/// `usageClass`/`kind`/`access` are stored as String (not Prisma `enum`) for
/// sqlite/postgres twin portability (the schema-parity contract).
model SchemaUsageOverride {
  id         String   @id @default(cuid())
  projectId  String
  /// `table` | `column` | `procedure` | `function`.
  kind       String
  /// Schema-qualified table identity (`<schema>.<table>` or bare `<table>`).
  tableName  String
  /// Bare column name for column rows; null for table/routine rows.
  columnName String?
  /// Asserted class: `used` | `unreferenced` | `uncertain` (usually `used`).
  usageClass String
  /// Asserted access for the emitted edge: `reads` | `writes` | `persists-to`.
  access     String   @default("reads")
  /// Optional human rationale for the override.
  note       String?
  /// User id of the analyst who asserted it (audit trail).
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, tableName, columnName, access])
  @@index([projectId])
  @@map("schema_usage_overrides")
}

// ============================================================================
// Sandbox (Epic #395 — v1.2.x)
// ============================================================================
/// Per-execution sandbox session metadata. One row per `provider.create()`
/// lifecycle. Cleared at no point — kept indefinitely as SOC 2 evidence
/// (#410, #413). `provider`, `outcome` are stored as String (not Prisma
/// `enum`) for sqlite/postgres twin portability — see `schema-parity` test
/// contract. Valid `provider` values: `e2b` | `daytona` | `noop` |
/// `local_dev` | `self_hosted`. Valid `outcome` values (when set):
/// `completed` | `timeout` | `killed` | `error`.
model SandboxSession {
  id              String    @id @default(cuid())
  projectId       String
  userId          String?
  /// Optional foreign key to `AgentRun.id` so the UI can group sessions
  /// by Run on the run-detail page (#419). No `@relation` is declared
  /// because `AgentRun.projectId` is nullable and we want the sandbox
  /// session row to outlive a run cleanup; treat as a soft FK.
  runId           String?
  provider        String
  vendorSandboxId String
  templateId      String?
  vCpus           Int
  memMiB          Int
  createdAt       DateTime  @default(now())
  destroyedAt     DateTime?
  wallClockMs     Int?
  cpuTimeMs       Int?
  /// Cost in micro-USD (integer). Avoids `Decimal` for sqlite/postgres
  /// twin portability. Null when cost telemetry is unavailable.
  costMicroUsd    Int?
  outcome         String?
  errorMessage    String?

  project Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  events  SandboxAuditEvent[]

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([runId, createdAt])
  @@map("sandbox_sessions")
}

/// Append-only audit trail for sandbox lifecycle + IO events. Consumed by
/// SOC 2 evidence collection (#413). `eventType` valid values:
/// `create` | `exec` | `upload` | `download` | `pause` | `resume` |
/// `destroy` | `timeout`. `payload` is JSON-encoded (String for
/// sqlite/postgres twin portability) and is redacted by
/// `sandbox/audit/redact.ts` before persistence — file contents,
/// secret/token-shaped keys, and Authorization headers are stripped.
model SandboxAuditEvent {
  id        String   @id @default(cuid())
  sessionId String
  eventType String
  /// JSON-encoded payload (object). Redacted before persistence.
  payload   String   @default("{}")
  timestamp DateTime @default(now())

  session SandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
  @@index([eventType, timestamp])
  @@map("sandbox_audit_events")
}

/// Epic #394 (#403/#404/#405) — Persistent PR-review state per (repo, PR).
///
/// One row per (projectId, repoOwner, repoName, prNumber) tracking the
/// last review's head SHA, per-AC verdicts (so incremental re-reviews can
/// inherit prior verdicts on unchanged files), and a pointer back to the
/// AgentRun row that produced the review.
///
/// Updated atomically by the agent at the END of every review (or by the
/// incremental path when a re-review is fully inherited). `acVerdictsJson`
/// is stored as String for sqlite/postgres twin portability — see
/// `schema-parity` test contract.
model PrReviewState {
  id              String   @id @default(cuid())
  projectId       String
  repoOwner       String
  repoName        String
  prNumber        Int
  /// SHA of the HEAD commit at the time of the last completed review.
  lastReviewedSha String?
  /// JSON-encoded array of per-AC verdicts at that SHA. Schema:
  /// [{ acId, verdict, reasoning, evidenceFiles[] }]. Used by the
  /// incremental path to carry forward verdicts when no cited file changed.
  acVerdictsJson  String   @default("[]")
  /// Last AgentRun row id (see runs-service) for the review.
  lastRunId       String?
  /// Last verdict posted: approve|request_changes|comment|skipped.
  lastVerdict     String?
  /// Bookkeeping for queue dedup + observability.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, repoOwner, repoName, prNumber])
  @@index([projectId, updatedAt])
  @@map("pr_review_state")
}

/// Epic #394 (#403) — Webhook delivery dedup table.
///
/// GitHub re-delivers webhooks on transient receiver errors. We record
/// each `X-GitHub-Delivery` UUID so the queue producer can short-circuit
/// duplicates instead of enqueueing the same review twice. Rows are
/// purged opportunistically by the dedup helper when older than 24h.
model PrReviewWebhookDelivery {
  id         String   @id @default(cuid())
  /// `X-GitHub-Delivery` header value (UUID).
  deliveryId String   @unique
  /// `X-GitHub-Event` header value (e.g. `pull_request`).
  eventType  String
  receivedAt DateTime @default(now())
  /// BackgroundRun id created for this delivery (null when deduped).
  runId      String?

  @@index([receivedAt])
  @@map("pr_review_webhook_deliveries")
}

// ============================================================================
// Epic #486 — Auto Documentation Generator
// ============================================================================

/// Represents a generated documentation artifact for a project (e.g. full
/// technical doc, module doc, API reference). Linked to GeneratedDocumentVersion
/// for history tracking and incremental regeneration.
model GeneratedDocument {
  id            String    @id @default(cuid())
  projectId     String
  title         String
  /// Scope of the document: `full` (whole project), `module` (single package),
  /// `symbol` (single class/function).
  scope         String    @default("full")
  /// JSON-encoded filter metadata (e.g. module paths, symbol ids)
  scopeFilter   String    @default("{}")
  /// #1353 — server-authored, versioned initiating-user/reference policy.
  /// Legacy NULL is unknown authorization, never an implicit system principal.
  evidencePolicy String?
  /// Final rendered markdown content (latest version)
  content       String    @default("")
  /// SHA-256 hash of the code graph state at generation time. Used for
  /// incremental regeneration to detect which symbols changed.
  codeGraphHash String?
  /// JSON-encoded structured schema graph (tables + FK edges + descriptions)
  /// for the interactive Schema Graph Explorer. Only populated for
  /// `scope = "database"` documents (Epic #895).
  schemaGraph   String?
  /// Status: pending|generating|ready|degraded|failed
  status        String    @default("pending")
  errorMessage  String?
  /// Epic #204 follow-up (#252) — structured degraded-output warnings
  /// (`DocWarning[]`) for `degraded` documents. Previously overloaded onto
  /// `errorMessage`; now a dedicated JSON column so diagnostic warnings never
  /// share a field with genuine error strings and `status` stays a clean
  /// state-machine field. Null for clean (`ready`) docs.
  warnings      Json?
  /// Whether this document should auto-regenerate on code ingest
  autoUpdate    Boolean   @default(false)
  generatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  project             Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions            GeneratedDocumentVersion[]
  /// Epic #207 — this document acting as a "spec" in the traceability spine.
  requirementMappings RequirementSpecMapping[]
  codeMappings        SpecCodeMapping[]
  /// Epic #609 (#616) — formal review scope items targeting this spec.
  reviewItems         ReviewRequestItem[]

  @@index([projectId, status])
  @@index([projectId, scope])
  @@map("generated_documents")
}

/// Version history for a generated document. Each regeneration (full or
/// incremental) creates a new version row with the diff summary.
model GeneratedDocumentVersion {
  id             String   @id @default(cuid())
  documentId     String
  version        Int
  /// Stable revision identity shared by generated publication/cleanup/regeneration.
  revisionId     String?
  /// JSON-encoded immutable generation provenance manifest (#1355).
  provenanceManifest String?
  content        String
  /// Human-readable summary of what changed (for incremental regen)
  diffSummary    String?
  /// JSON array of symbol qualified names that were regenerated
  changedSymbols String   @default("[]")
  createdAt      DateTime @default(now())

  document GeneratedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([revisionId])
  @@index([documentId, version])
  @@map("generated_document_versions")
}

/// Phase-1 fact-extraction cache for the holistic doc synthesizer.
///
/// Phase 1 of doc generation is the cost-and-time bottleneck: 150
/// modules x ~20K input tokens each = 3M input tokens per doc. When
/// underlying source files haven't changed, the LLM output is
/// deterministic enough that we can replay the prior result instead of
/// paying for another LLM call.
///
/// Cache key construction: SHA-256 of (modulePath || sortedFileShas ||
/// systemPromptVersion || model). Any source change invalidates only
/// the affected modules; prompt-prompt-version bumps invalidate
/// globally.
///
/// Per-project scoping prevents cross-project leakage even if two
/// projects happen to have identical file contents.
model DocsGenFactCache {
  id              String   @id @default(cuid())
  projectId       String
  /// Stable hash key — see header for construction.
  cacheKey        String
  /// Module path (informational; cacheKey is the real identifier).
  modulePath      String
  /// SHA-256 of every file contributing to this module's facts, joined
  /// in canonical (sorted) order. Used as a quick visual sanity check
  /// when debugging cache misses.
  fileFingerprint String
  /// LLM model that produced these facts (e.g. claude-haiku-4-5).
  model           String
  /// System prompt version this cache row was produced under.
  promptVersion   Int      @default(1)
  /// LLM-generated structured fact text (PURPOSE/RULES/WORKFLOWS/...).
  facts           String
  /// JSON array of ExtractedFormula objects.
  formulasJson    String   @default("[]")
  /// JSON array of MinedRule objects (Java rule miner output).
  minedRulesJson  String   @default("[]")
  /// Top class names cached so we don't re-derive on cache hit.
  topClassesJson  String   @default("[]")
  /// Class/method counts at extraction time.
  classCount      Int      @default(0)
  methodCount     Int      @default(0)
  /// Token usage from the LLM call that produced this entry. Used for
  /// cost reporting and to verify cache savings.
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  cacheReadTokens Int      @default(0)
  createdAt       DateTime @default(now())
  /// Updated on every cache hit so we can age out stale entries.
  lastUsedAt      DateTime @default(now())
  /// Number of times this entry was returned (popularity metric).
  hitCount        Int      @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, cacheKey])
  @@index([projectId, modulePath])
  @@index([lastUsedAt])
  @@map("docs_gen_fact_cache")
}

// ============================================================================
// Multi-Repository Product Documentation (Epic #544)
// ============================================================================

/// A Product groups multiple repositories into a single conceptual product.
/// Products can span multiple GitHub organizations and contain repos from
/// different projects.
model Product {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  slug        String   @unique
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy    User                 @relation("ProductCreator", fields: [createdById], references: [id])
  projects     Project[]
  repos        ProductRepo[]
  edges        ProductEdge[]
  analyses     ProductAnalysis[]
  documents    ProductDocument[]
  contractDocs ProductContractDoc[]

  @@index([createdById])
  @@map("products")
}

/// Join table between Product and RepoConnection. A repo can belong to
/// multiple products with different roles.
model ProductRepo {
  id               String   @id @default(cuid())
  productId        String
  repoConnectionId String
  role             String? // frontend | backend-api | shared-lib | microservice | gateway | docs
  createdAt        DateTime @default(now())

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  repoConnection RepoConnection @relation(fields: [repoConnectionId], references: [id], onDelete: Cascade)

  @@unique([productId, repoConnectionId])
  @@index([repoConnectionId])
  @@map("product_repos")
}

/// Cross-repo edges discovered by the relationship detector.
model ProductEdge {
  id           String   @id @default(cuid())
  productId    String
  sourceRepoId String // RepoConnection ID
  targetRepoId String // RepoConnection ID
  edgeType     String // calls | imports | produces | consumes | extends | implements
  confidence   Float // 0.0 to 1.0
  evidence     String   @default("[]") // JSON array of evidence objects
  sourceFile   String?
  targetFile   String?
  commitSha    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceRepo RepoConnection @relation("ProductSourceEdges", fields: [sourceRepoId], references: [id], onDelete: Cascade)
  targetRepo RepoConnection @relation("ProductTargetEdges", fields: [targetRepoId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sourceRepoId])
  @@index([targetRepoId])
  @@index([productId, edgeType])
  @@map("product_edges")
}

/// Tracks product-level cross-repo analysis jobs.
model ProductAnalysis {
  id          String    @id @default(cuid())
  productId   String
  status      String    @default("pending") // pending | running | completed | failed
  startedAt   DateTime?
  completedAt DateTime?
  edgeCount   Int       @default(0)
  error       String?
  triggeredBy String? // user ID or "webhook"
  createdAt   DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_analyses")
}

/// Generated documentation for a product (unified arch, per-service, API contracts).
model ProductDocument {
  id          String   @id @default(cuid())
  productId   String
  docType     String // unified-architecture | per-service | api-contract
  title       String
  content     String   @default("")
  repoId      String? // null for unified; RepoConnection ID for per-service/api-contract
  metadata    String   @default("{}") // JSON metadata (provenance, generation params)
  version     Int      @default(1)
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  repo    RepoConnection? @relation("ProductDocRepo", fields: [repoId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([productId, docType])
  @@index([repoId])
  @@map("product_documents")
}

/// Issue #90 (epic #86) — versioned, diffable API-contract docs.
///
/// Each product analysis run regenerates a repo's API-contract doc. This table
/// keeps an append-only, monotonically-versioned history per `(productId,
/// repoId)`. Regenerating an UNCHANGED contract is deduped by `contentHash` and
/// does NOT append a new row. Regenerating a CHANGED contract appends version
/// N+1 and stores the semantic diff (added/removed/changed endpoints, GraphQL
/// types, protobuf services/messages) vs version N.
///
/// `itemsSnapshot` is the normalised structured contract (JSON `ContractItem[]`)
/// for this version, so the next run diffs against the exact prior contract
/// rather than re-parsing specs that are no longer retained. `diff` is the
/// rendered `ContractDiff` (null for the initial version). All JSON columns are
/// TEXT for sqlite/postgres twin portability (the `schema-parity` contract).
model ProductContractDoc {
  id          String   @id @default(cuid())
  productId   String
  /// RepoConnection id this contract belongs to. Nullable to mirror
  /// ProductDocument.repoId, but always set in practice.
  repoId      String?
  /// Monotonic version number per (productId, repoId), starting at 1.
  version     Int
  /// SHA-256 of the normalised contract item set — the dedupe key.
  contentHash String
  /// JSON `{ file, format }[]` identifying the source specs.
  specIdentity String  @default("[]")
  /// JSON `ContractItem[]` snapshot of this version's structured contract.
  itemsSnapshot String @default("[]")
  /// JSON-encoded ContractDiff vs the previous version (null for v1).
  diff        String?
  /// One-line human summary of the diff (or "Initial version.").
  diffSummary String   @default("")
  /// Rendered Markdown (base contract doc + diff section).
  content     String   @default("")
  title       String
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, repoId, version])
  @@index([productId])
  @@index([productId, repoId])
  @@map("product_contract_docs")
}

// ============================================================================
// Epic #556 — Jira Integration
// ============================================================================

/// External Jira connection (Cloud v3 or Data Center v2). Credentials are
/// stored as vault references (secretId FK → Secret). TLS CA cert is an
/// optional second vault reference via the named relation "JiraTlsCa".
model JiraConnection {
  id                    String    @id @default(cuid())
  projectId             String
  label                 String
  edition               String // cloud | datacenter
  baseUrl               String
  username              String
  secretId              String
  proxyUrl              String?
  tlsRejectUnauthorized Boolean   @default(true)
  tlsCaSecretId         String?
  status                String    @default("untested") // untested | ok | error
  errorMessage          String?
  lastTestedAt          DateTime?
  createdById           String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  secret          Secret    @relation("JiraSecret", fields: [secretId], references: [id])
  tlsCa           Secret?   @relation("JiraTlsCa", fields: [tlsCaSecretId], references: [id])
  createdBy       User      @relation("JiraCreator", fields: [createdById], references: [id])
  publishProjects Project[] @relation("ProjectJiraPublish")

  @@unique([projectId, label])
  @@index([projectId])
  @@index([createdById])
  @@map("jira_connections")
}

// ============================================================================
// Token Tracking & Cost Allocation (Epic #594 — v1.3.0)
