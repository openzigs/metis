  // Envelope-encrypted payload — actual crypto lives in Phase 2
  ciphertext  String
  iv          String
  tag         String
  salt        String
  keyVersion  Int       @default(1)
  algorithm   String    @default("aes-256-gcm")
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  repoConnections RepoConnection[]
  dbConnections   DatabaseConnection[]
  mcpServers      MCPServer[]
  jiraConnections JiraConnection[]     @relation("JiraSecret")
  jiraTlsCa       JiraConnection[]     @relation("JiraTlsCa")

  @@index([keyVersion])
  @@map("secrets")
}

