// ============================================================================
// Epic #708 — AI Bug Scanner for Connected Repositories
// ============================================================================

/// Issue #710 — A collection of user-authored rules scoped to a project.
/// Rule sets are versionless aggregates; activation/deactivation is per-set so
/// scans can opt in to subsets via the `mode` parameter.
model RuleSet {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String   @default("")
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("RuleSetCreator", fields: [createdById], references: [id])
  rules     Rule[]

  @@unique([projectId, name])
  @@index([projectId, isActive])
  @@map("scanner_rule_sets")
}

/// Issue #710 — A single natural-language rule, optionally compiled by the LLM
/// into structured retrieval/symbol filters plus exemplar grades. `status`
/// drives the editor wizard:
///   draft           — saved, not yet compiled
///   compiling       — LLM compilation in flight
///   awaiting_grading — compiled, user must grade ≥5 exemplars
///   active          — graded and ready for scans
///   failed          — compilation failed; see `errorMessage`
model Rule {
  id              String   @id @default(cuid())
  ruleSetId       String
  naturalLanguage String
  /// JSON-encoded `{keywords:string[], symbolKinds:string[], exemplars:string[]}`.
  /// Empty string when status='draft'.
  compiledMeta    String   @default("")
  /// JSON-encoded array of `{symbolId, grade:"positive"|"negative"|"unsure"}`.
  exemplarGrades  String   @default("[]")
  status          String   @default("draft")
  severity        String   @default("medium")
  category        String   @default("security")
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ruleSet      RuleSet       @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  scanFindings ScanFinding[]

  @@index([ruleSetId])
  @@index([status])
  @@map("scanner_rules")
}

/// Issue #711 — A single scan run over a repo at a specific commit SHA. The
/// scan is queued, executed by the task scheduler, and produces ScanFinding
/// rows that gate on triage approval before they become Finding rows.
model Scan {
  id               String    @id @default(cuid())
  projectId        String
  repoConnectionId String
  /// Commit SHA frozen at scan-start. Used for the stale-commit gate at
  /// publish time and for evidence-line cross-checks.
  commitSha        String
  status           String    @default("queued") // queued|running|completed|failed|cancelled
  /// `rules` — only RuleSet matches; `heuristic` — Sonnet open-ended bug hunt;
  /// `both` — union with de-duplication by fingerprint.
  mode             String    @default("rules")
  startedAt        DateTime?
  completedAt      DateTime?
  totalSymbols     Int       @default(0)
  scannedSymbols   Int       @default(0)
  totalTokens      Int       @default(0)
  costCents        Int       @default(0)
  /// Hard token budget. Scan auto-aborts (status=cancelled) when exceeded.
  budgetCapTokens  Int       @default(2000000)
  errorMessage     String?
  createdById      String
  createdAt        DateTime  @default(now())

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repoConnection RepoConnection @relation(fields: [repoConnectionId], references: [id], onDelete: Cascade)
  createdBy      User           @relation("ScanCreator", fields: [createdById], references: [id])
  scanFindings   ScanFinding[]

  @@index([projectId, status])
  @@index([repoConnectionId, createdAt])
  @@map("scanner_scans")
}

/// Issue #712/#713 — A candidate finding produced by the per-symbol scanner
/// and FP filter. Promoted to a Finding row on triage approval. `fingerprint`
/// is a SHA256 over (projectId, repoId, qualifiedName, rule-or-heuristic-key,
/// normalized title) — used for cross-scan dedup and publish idempotency.
model ScanFinding {
  id                    String    @id @default(cuid())
  scanId                String
  ruleId                String?
  symbolId              String
  fingerprint           String
  title                 String
  body                  String
  severity              String    @default("medium") // critical|high|medium|low|info
  category              String    @default("security")
  /// JSON-encoded int[] of line numbers (1-indexed) inside `symbol.filePath`.
  evidenceLines         String    @default("[]")
  /// LLM-reported confidence after FP-filter self-consistency, [0.0, 1.0].
  confidence            Float     @default(0.5)
  triageStatus          String    @default("pending") // pending|approved|rejected|deferred
  triageNote            String?
  triagedAt             DateTime?
  triagedById           String?
  /// Set when this row was promoted into a Finding via triage approval.
  materializedFindingId String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  scan       Scan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  rule       Rule?       @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  symbol     CodeSymbol  @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  triagedBy  User?       @relation("ScanFindingTriager", fields: [triagedById], references: [id])
  finding    Finding?    @relation("MaterializedScanFinding")
  issueLinks IssueLink[]

  @@unique([scanId, fingerprint])
  @@index([scanId, triageStatus])
  @@index([symbolId])
  @@index([fingerprint])
  @@map("scanner_scan_findings")
}

/// Issue #715 — Idempotency record linking a ScanFinding to the external
/// issue tracker entry it was published to. Reused on republish to avoid
/// duplicates (one row per provider).
///
/// Epic #176 / #179 — also used to link an analysis `Finding` (not just a
/// scanner `ScanFinding`) to a published issue. Exactly one of
/// `scanFindingId` / `findingId` is set per row; the other is null. Each has
/// its own `(<id>, provider)` unique index so idempotency holds per source.
model IssueLink {
  id            String   @id @default(cuid())
  scanFindingId String?
  findingId     String?
  /// Issue #963 (Epic #960) — links a published external issue to a whole
  /// ImpactAnalysis RUN (one issue per run). NULLABLE + mutually exclusive with
  /// scanFindingId/findingId: exactly one of the three id slots is set per row.
  /// Idempotent re-publish keys on `@@unique([impactAnalysisId, provider])`.
  impactAnalysisId String?
  provider      String // github|jira
  externalId    String // issue number (github) or key (jira)
  externalUrl   String
  fingerprint   String
  createdAt     DateTime @default(now())

  scanFinding     ScanFinding?    @relation(fields: [scanFindingId], references: [id], onDelete: Cascade)
  finding         Finding?        @relation(fields: [findingId], references: [id], onDelete: Cascade)
  impactAnalysis  ImpactAnalysis? @relation(fields: [impactAnalysisId], references: [id], onDelete: Cascade)

  @@unique([scanFindingId, provider])
  @@unique([findingId, provider])
  @@unique([impactAnalysisId, provider])
  @@index([provider, externalId])
  @@index([fingerprint])
  @@index([findingId])
  @@index([impactAnalysisId])
  @@map("scanner_issue_links")
}

// ============================================================================
// Epic #739 — Bidirectional Issue Sync (Drift Detection)
// ============================================================================

/// Tracks a detected drift between an external issue (GitHub/Jira) and the
/// local published issue. One row per incoming webhook/poll event that detects
/// a change.
model DriftEvent {
  id               String    @id @default(cuid())
  publishedIssueId String
  projectId        String
  requirementId    String?
  source           String // github|jira
  deliveryId       String    @unique
  action           String // edited|closed|reopened|labeled|assigned|unassigned
  fieldDiffs       String // JSON array of {field, local, external}
  externalSnapshot String // JSON of full external fields
  localSnapshot    String? // JSON of local fields at time of detection
  status           String    @default("pending") // pending|resolved
  resolution       String? // adopt|push|divergent
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  publishedIssue PublishedIssue @relation(fields: [publishedIssueId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([publishedIssueId])
  @@index([source])
  @@map("drift_events")
}

// ============================================================================
// Test Coverage Gap Analysis (Epic #856)
// ============================================================================
/// A coverage run executes Mode A (matching) or Mode B (cold-start
/// suggestions) for a project. `contentHash` allows idempotent re-runs.
model TestCoverageRun {
  id               String    @id @default(cuid())
  projectId        String
  createdById      String
  /// `queued|running|completed|failed|cancelled|budget_exceeded`.
  status           String    @default("queued")
  /// `A` (matching against existing tests) or `B` (cold-start suggestions).
  mode             String    @default("A")
  /// sha256 over the canonical sorted set of input contentHashes.
  contentHash      String
  /// Sum of token costs (cents * 100) tracked across the run lifecycle.
  tokenCostCents   Int       @default(0)
  /// Tokens spent on the embedding phase (#878).
  embeddingTokens  Int       @default(0)
  /// Tokens spent on the LLM judge phase (#878).
  judgeTokens      Int       @default(0)
  /// Tokens spent on the AI suggestion phase (#878).
  suggestionTokens Int       @default(0)
  /// JSON serialized phase progress map: `{phase: {pct, ts}}`.
  phaseProgress    String    @default("{}")
  /// Error message when status=failed.
  error            String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imports     TestCaseImport[]
  mappings    CoverageMapping[]
  gaps        GapItem[]
  suggestions Suggestion[]

  @@index([projectId, status])
  @@index([contentHash])
  @@map("test_coverage_runs")
}

/// A single import batch — either an uploaded file or an external pull.
/// One `TestCaseImport` produces 0..N `TestCaseDoc` rows.
model TestCaseImport {
  id        String   @id @default(cuid())
  projectId String
  runId     String?
  /// `excel|csv|docx|markdown|gherkin|jira|xray|zephyr|testrail`.
  source    String
  /// `pending|importing|completed|failed`.
  status    String   @default("pending")
  /// Original file name (uploads) or external resource label (pulls).
  label     String   @default("")
  /// Count of successfully normalised test cases.
  testCount Int      @default(0)
  /// Error message when status=failed.
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run       TestCoverageRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  testCases TestCaseDoc[]

  @@index([projectId, status])
  @@index([runId])
  @@map("test_case_imports")
}

/// Canonical test case record (normalised from any source).
/// Steps are stored as JSON: `[{action, expected?}]`.
model TestCaseDoc {
  id             String   @id @default(cuid())
  projectId      String
  sourceImportId String
  /// External identifier from the source system (Jira key, TestRail id…).
  externalId     String?
  title          String
  preconditions  String?
  /// JSON array of `{action: string, expected?: string}`.
  stepsJson      String   @default("[]")
  expected       String?
  /// `low|medium|high|critical`.
  priority       String   @default("medium")
  /// JSON array of tag strings.
  tags           String   @default("[]")
  /// Matches `TestCaseImport.source`.
  source         String
  /// sha256 over canonical-JSON of the normalised case.
  contentHash    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  import   TestCaseImport    @relation(fields: [sourceImportId], references: [id], onDelete: Cascade)
  mappings CoverageMapping[]

  @@unique([projectId, source, externalId])
  @@index([projectId, contentHash])
  @@map("test_case_docs")
}

/// Many-to-many requirement ↔ test mapping with per-cell scores.
/// `status` mirrors the matcher verdict and can be overridden by humans.
model CoverageMapping {
  id               String    @id @default(cuid())
  runId            String
  requirementId    String
  testCaseDocId    String
  cosine           Float
  bm25             Float     @default(0)
  fused            Float
  judgeConfidence  Float?
  /// `COVERED|UNCOVERED|AMBIGUOUS|OVERRIDDEN`.
  status           String
  overriddenById   String?
  overrideReason   String?
  /// Epic #260 (#45) — latest JUnit execution verdict for this mapping:
  /// `PASSED|FAILED|SKIPPED` (null until a JUnit round-trip is uploaded).
  lastResult       String?
  /// When `lastResult` was last set by a JUnit round-trip upload.
  lastResultAt     DateTime?
  /// Free-form ref for the JUnit upload that set `lastResult` (import id / label).
  lastResultRunRef String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  run         TestCoverageRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  requirement Requirement     @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  testCaseDoc TestCaseDoc     @relation(fields: [testCaseDocId], references: [id], onDelete: Cascade)

  @@unique([runId, requirementId, testCaseDocId])
  @@index([runId, status])
  @@index([requirementId])
  @@map("coverage_mappings")
}

/// One row per uncovered requirement (or low-coverage with severity hint).
model GapItem {
  id            String   @id @default(cuid())
  runId         String
  requirementId String
  /// `low|medium|high|critical`.
  severity      String   @default("medium")
  /// JSON metadata (best-cosine, reason, etc.).
  meta          String   @default("{}")
  createdAt     DateTime @default(now())

  run         TestCoverageRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  requirement Requirement     @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([runId, requirementId])
  @@index([runId, severity])
  @@map("test_coverage_gaps")
}

/// AI-generated test case suggestion gated by HallucinationScorer faithfulness.
model Suggestion {
  id                   String   @id @default(cuid())
  runId                String
  /// JSON array of mapped requirement ids (many-to-many).
  mappedRequirementIds String   @default("[]")
  title                String
  /// JSON: { given: string[], when: string[], then: string[] }.
  gwtJson              String   @default("{}")
  /// JSON array of step objects: [{action, expected?}].
  stepsJson            String   @default("[]")
  /// 0..1 faithfulness score from HallucinationScorer.
  faithfulness         Float    @default(0)
  /// JSON array of source chunk descriptors for traceability.
  sourceChunks         String   @default("[]")
  /// `draft|accepted|rejected|exported`.
  status               String   @default("draft")
  /// `low-confidence` flag when faithfulness < 0.6.
  lowConfidence        Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  run TestCoverageRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@map("test_coverage_suggestions")
}

// ============================================================================
// Epic #856 Phase 3 — Test Management Tool Connections (Issue #871)
// ============================================================================

/// External test management tool connection (Xray, Zephyr Scale, TestRail).
/// Mirrors the Jira connector pattern: secrets live in the vault and are
/// referenced from `authConfigJson`/`tlsConfigJson` as `${vault:label}` tokens
/// — raw credentials are never persisted on this row and never logged.
model TestManagementConnection {
  id              String    @id @default(cuid())
  projectId       String
  label           String
  /// `xray | zephyr | testrail`.
  kind            String
  baseUrl         String
  /// JSON; per-kind shape with `${vault:label}` refs for every secret value.
  ///   xray:     { "clientIdRef": "${vault:...}", "clientSecretRef": "${vault:...}" }
  ///   zephyr:   { "bearerTokenRef": "${vault:...}" }
  ///   testrail: { "email": "...", "apiKeyRef": "${vault:...}" }
  authConfigJson  String    @default("{}")
  /// JSON `{ "url": "https://..." }` or null.
  proxyConfigJson String?
  /// JSON `{ "rejectUnauthorized": bool, "caCertRef": "${vault:...}" | null }` or null.
  tlsConfigJson   String?
  /// `untested | ok | error`.
  status          String    @default("untested")
  errorMessage    String?
  lastTestedAt    DateTime?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, label])
  @@index([projectId])
  @@index([projectId, kind])
  @@map("test_management_connections")
}

// ============================================================================
// Epic #728 — Multi-User Collaboration on Requirements & Specs
// ============================================================================

/// Polymorphic comment thread — attached to a Requirement or a Spec Kit
/// artifact (by name within a project). Exactly one of requirementId /
/// specKitProjectId+specKitArtifactName is set.
model CommentThread {
  id                  String   @id @default(cuid())
  requirementId       String?
  /// Spec Kit artifact — keyed by (projectId, artifactName).
  specKitProjectId    String?
  specKitArtifactName String?
  title               String?
  resolved            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  comments    Comment[]

  @@index([requirementId])
  @@index([specKitProjectId, specKitArtifactName])
  @@map("comment_threads")
}

/// Single comment in a thread, authored by a user.
model Comment {
  id        String    @id @default(cuid())
  threadId  String
  authorId  String
  body      String
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  thread   CommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mentions Mention[]

  @@index([threadId])
  @@index([authorId])
  @@map("comments")
}

/// An @mention inside a Comment body.
model Mention {
  id              String   @id @default(cuid())
  commentId       String
  mentionedUserId String
  notified        Boolean  @default(false)
  createdAt       DateTime @default(now())

  comment       Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User    @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([commentId, mentionedUserId])
  @@index([mentionedUserId])
  @@map("mentions")
}

/// Assigns a Requirement to a user, optionally with an SLA deadline.
model Assignment {
  id            String    @id @default(cuid())
  requirementId String
  assigneeId    String
  assignedById  String
  slaDeadline   DateTime?
  resolvedAt    DateTime?
  /// Set once the SLA deadline has been notified; prevents repeat notifications.
  notifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  assignee    User        @relation("Assignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assignedBy  User        @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  @@unique([requirementId, assigneeId])
  @@index([requirementId])
  @@index([assigneeId])
  @@map("assignments")
}

/// Epic #770 — append-only per-Requirement version history.
///
/// One row is appended every time a Requirement's tracked fields change.
/// `changedFields` stores a compact JSON diff (only the fields that actually
/// changed, each as `{ from, to }`) — never a full snapshot. History is
/// immutable: restores append a NEW row (version N+1) rather than mutating or
/// deleting prior rows.
model RequirementVersion {
  id            String   @id @default(cuid())
  requirementId String
  /// Monotonic version number, mirrors the Requirement.version counter at the
  /// time the change was committed.
  version       Int
  /// Compact JSON diff of changed fields: `{ field: { from, to } }`.
  changedFields String
  /// User who triggered the change (null for system/automated edits).
  /// Scalar soft-link to users.id (no FK, mirroring RequirementChange.reviewedById).
  actorId       String?
  /// Optional free-text reason (e.g. "Restored to version 3").
  reason        String?
  createdAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, version])
  @@index([requirementId])
  @@index([actorId])
  @@map("requirement_versions")
}

/// Epic #404 (#413) — persistent refresh-token revocation.
///
/// Replaces the in-memory `revokedTokens` Set in `lib/auth/jwt.ts` so a server
/// restart no longer wipes revocation state and force-logs-out every user.
/// One row is inserted when a refresh token is revoked (single-use rotation,
/// explicit logout). The hot-path revocation CHECK (every /refresh + /logout)
/// is an indexed `tokenId` lookup, never a scan.
///
/// Stores ONLY the `tokenId` (a ULID embedded in the refresh JWT — NOT a
/// secret), never the raw refresh token. `expiresAt` mirrors the refresh-token
/// TTL so `pruneExpired()` can delete rows whose underlying token can no longer
/// be presented, keeping the table bounded.
model RevokedRefreshToken {
  id        String   @id @default(cuid())
  /// ULID `tokenId` claim of the revoked refresh token. Unique + indexed so the
  /// per-request revocation check is an O(1) point lookup.
  tokenId   String   @unique
  /// Owning user (scalar soft-link to users.id, no FK — mirrors how other
  /// auth/audit tables reference users without a hard relation).
  userId    String
  revokedAt DateTime @default(now())
  /// Mirrors the original refresh-token `exp`. Rows past this are pruneable.
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
  @@map("revoked_refresh_tokens")
}

/// Epic #404 (#413) — persistent "revoke all sessions for a user" marker.
///
/// Replaces the in-memory `userTokenMap` + `disabledUsers` Sets. Rather than
/// writing a row per issued token (a write on every login — the hottest path),
/// we persist a single per-user `cutoff` timestamp: any refresh token whose
/// `iat` (issued-at) is at or before the cutoff is rejected. This invalidates
/// every CURRENT session in one write, while a token issued AFTER the cutoff
/// (e.g. after the user is re-provisioned and logs in again) still validates —
/// matching the SCIM deprovision/reprovision acceptance criteria.
model UserSessionRevocation {
  userId    String   @id
  /// Refresh tokens with `iat <= cutoff` for this user are rejected.
  cutoff    DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_session_revocations")
}

// ============================================================================
// Issue #416 — Persisted in-app notifications (mention + SLA deadline).
// ============================================================================

/// Persisted notification row for a single user.
/// type values: "mention" | "sla_deadline"
model Notification {
  id        String   @id @default(cuid())
  /// The user this notification belongs to. Indexed for fast per-user queries.
  userId    String
  /// Machine-readable type: "mention" | "sla_deadline"
  type      String
  title     String
  message   String
  /// Optional deep-link URL (relative path). Null when not derivable.
  href      String?
  /// Full event payload stored for client use (JSON).
  payload   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@map("notifications")
}

/// Epic #608 (#611) — per-user notification preferences.
///
/// One row per (user, channel, event) cell the user has EXPLICITLY toggled.
/// Absent row = default ("absent row = default" semantics): existing users
/// have zero rows and resolve to the default matrix in
/// `server/src/lib/notifications/preferences.ts` — no backfill/seeding.
/// channel/event values come from the shared vocabulary in
/// `packages/shared/src/notifications.ts` (channels: email|inApp|webhook|teams;
/// events: analysisCompleted|requirementsApproved|issuesPublished|systemAlerts|
/// mention|slaDeadline). Stored as free-form strings for forward-compat.
model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  /// Delivery channel: "email" | "inApp" | "webhook" | "teams"
  channel   String
  /// Event key, e.g. "analysisCompleted" | "mention" | "slaDeadline"
  event     String
  enabled   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("NotificationPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, event])
  @@index([userId])
  @@map("notification_preferences")
}

/// Epic #547 (Phase 0, #548) — per-workspace Microsoft Teams app installation.
///
/// Stands up the SHARED Teams-app foundation reused by the collaboration bridge
/// (#549–#554) and the pre-existing ChatOps/notification epics (#63/#67). One row
/// per (workspace, Azure bot app) registration.
///
/// SECRET HANDLING: the bot's Microsoft App Password (client secret) is NEVER
/// stored on this row. It is written to the hardened `Secret` vault
/// (`server/src/lib/vault/vault-service.ts`, AES-256-GCM) and only a
/// `${vault:label}` reference is persisted in `appPasswordRef`. Decryption
/// happens at adapter-construction time via the same vault, so plaintext bot
/// credentials never touch this table, logs, or API responses.
model TeamsAppInstallation {
  id String @id @default(cuid())
  /// Owning METIS workspace (multi-tenant scoping key).
  workspaceId String
  /// Azure AD application (client) id of the bot — the `MicrosoftAppId`.
  appId String
  /// `${vault:label}` reference to the encrypted Microsoft App Password. Never
  /// the plaintext secret. Resolved via the vault at adapter-construction time.
  appPasswordRef String
  /// Azure AD tenant id this app is registered in. For single-tenant bots this
  /// is the `MicrosoftAppTenantId`; null for multi-tenant ("MultiTenant") apps.
  tenantId String?
  /// Bot identity type — "MultiTenant" | "SingleTenant" | "UserAssignedMSID".
  /// Defaults to MultiTenant, matching the Azure Bot default.
  appType String @default("MultiTenant")
  /// Lifecycle status — "active" | "revoked". Free-form string (no migration to
  /// add states), mirroring the GeneratedDocument.status convention.
  status String @default("active")
  /// Optional human label for the registration (shown in the admin UI).
  label String?
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace              Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy              User?                        @relation("TeamsInstallationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  conversationReferences TeamsConversationReference[]

  /// One active app registration per workspace at a time. (A revoked row is
  /// soft-replaced by upsert; we do not keep history here.)
  @@unique([workspaceId, appId])
  @@index([workspaceId])
  @@map("teams_app_installations")
}

/// Epic #547 (Phase 0, #548) — a persisted Bot Framework `ConversationReference`.
///
/// Captured on install / first interaction so later phases can send PROACTIVE
/// messages into the Teams channel (#550 outbound mirror) without an inbound
/// activity to reply to. Durable relational data keyed by (workspace,
/// conversation) — hence a proper Prisma model + migration rather than the
/// UNLOGGED ephemeral tables used for rate-limit/SSO-state counters (#541/#542),
/// which are crash-disposable. Losing a ConversationReference would silently
/// break proactive delivery, so it must survive restarts and replicate.
model TeamsConversationReference {
  id String @id @default(cuid())
  /// The installation (and thus workspace) this conversation belongs to.
  installationId String
  /// Denormalized workspace id for cheap workspace-scoped lookups + the unique
  /// key. Always equals `installation.workspaceId`.
  workspaceId String
  /// Bot Framework conversation id (the channel/group/personal chat).
  conversationId String
  /// `serviceUrl` the proactive message must be POSTed back to.
  serviceUrl String
  /// AAD tenant id of the conversation (from `conversation.tenantId`).
  tenantId String?
  /// Bot Framework channel id — "msteams" for Teams.
  channelId String
  /// AAD object id of the user who triggered capture (from `user.aadObjectId`).
  /// Used by later phases to map AAD → METIS user. Nullable for channel-scoped
  /// references with no single user.
  aadObjectId String?
  /// Bot Framework user id (`user.id`) — the channel-specific account id.
  userId String?
  /// The full serialized `ConversationReference` JSON (source of truth for
  /// `continueConversationAsync`). Stored as TEXT for SQLite/Postgres parity.
  reference String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installation TeamsAppInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  /// get/save/delete is keyed by (workspace, conversation): a conversation maps
  /// to exactly one reference per workspace.
  @@unique([workspaceId, conversationId])
  @@index([installationId])
  @@index([workspaceId])
  @@map("teams_conversation_references")
}

/// Epic #547 Phase 1 (#549) — links a METIS `DiscussionThread` to a specific
/// Teams channel within a workspace, so later phases (#550 outbound /#551
/// inbound) know which thread a channel mirrors.
///
/// Cardinality: ONE channel ↔ ONE thread per workspace, enforced by TWO unique
/// keys — `(workspaceId, conversationId)` (a channel links to at most one
/// thread) and `(workspaceId, threadId)` (a thread links to at most one
/// channel). `projectId` is denormalized from the thread so the link can be
/// authorized via the existing member-only project check
/// (`server/src/lib/discussions/access.ts`) without a second lookup.
///
/// Durable relational data (a mapping the bridge depends on), so a real Prisma
/// model + migration — same choice as the #548 ConversationReference store, not
/// the crash-disposable UNLOGGED tables of #541/#542.
model TeamsChannelLink {
  id String @id @default(cuid())
  /// Owning METIS workspace (multi-tenant scoping key).
  workspaceId String
  /// The linked METIS discussion thread. Unique on its own: a thread belongs to
  /// exactly one project/workspace, so one link per thread globally — which also
  /// satisfies the 1:1 back-relation on DiscussionThread.
  threadId String @unique
  /// Denormalized project id of the thread, for cheap member-only authz.
  projectId String
  /// Bot Framework conversation id of the Teams channel (the mirror target).
  conversationId String
  /// Bot Framework channel id — "msteams" for Teams.
  channelId String
  /// AAD tenant id of the linked channel. Null for multi-tenant contexts where
  /// the tenant is not yet known; set once an inbound activity carries it.
  tenantId String?
  /// Free-form lifecycle status — "active" by default. No migration to add
  /// states, mirroring the GeneratedDocument.status convention.
  status String @default("active")
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  thread    DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("TeamsChannelLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// A channel links to at most one thread per workspace.
  @@unique([workspaceId, conversationId])
  @@index([workspaceId])
  @@index([projectId])
  @@map("teams_channel_links")
}

/// Epic #547 Phase 1 (#549) — durable Teams-side projection of identity: binds a
/// Teams sender's `(tenantId, aadObjectId)` to a METIS `User`.
///
/// This is NOT a parallel identity system. METIS SSO (OIDC/SAML) maps an external
/// identity to a `User` by EMAIL (`server/src/lib/auth/migrate-link-sso.ts`
/// `linkOnFirstSSOLogin` + the OIDC/SAML providers extract `email` from claims).
/// A Bot Framework inbound activity, however, carries `aadObjectId`/`tenantId`
/// but not reliably an email — so we persist the `(tenantId, aadObjectId)→userId`
/// binding once, established THROUGH that same email match (or admin linking).
/// The resolver then does a tenant-scoped lookup: a `(tenantId, aadObjectId)`
/// from a DIFFERENT tenant can never resolve to a METIS user (no cross-tenant
/// leakage); an unbound sender resolves to null (never silently attributed).
model TeamsUserIdentity {
  id String @id @default(cuid())
  /// Owning METIS workspace (multi-tenant scoping key).
  workspaceId String
  /// AAD tenant id of the sender — part of the resolver key. Tenant scoping is
  /// the cross-tenant isolation boundary.
  tenantId String
  /// AAD object id (stable per-user id within the tenant) — part of the key.
  aadObjectId String
  /// The resolved METIS user.
  userId String
  /// Optional email captured at binding time (provenance; the SSO match key).
  email String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One binding per (tenant, aadObjectId): the resolver key. Tenant-scoped so a
  /// foreign-tenant aadObjectId cannot collide with a local user's binding.
  @@unique([tenantId, aadObjectId])
  @@index([workspaceId])
  @@index([userId])
  @@map("teams_user_identities")
}

/// Issue #67 — a workspace's registered destination for a ONE-WAY Teams
/// notification card. Distinct from `TeamsChannelLink` (#549), which binds a
/// channel to a single DiscussionThread for bidirectional message mirroring:
/// a notification target carries NO thread — it is just "for event X in this
/// workspace, proactively post the rendered card into THIS Teams channel".
///
/// Keying: `(workspaceId, eventType)` is unique → at most one channel per event
/// per workspace (re-registering the same event upserts the destination in
/// place). `eventType` is free-form ("analysis-complete" | "publish-rolled-back"
/// | "budget-exceeded" today); new event kinds need no migration, mirroring the
/// `status`-as-free-form convention used across the Teams models.
///
/// Durable relational data → a real Prisma model + migration (same choice as the
/// #548 ConversationReference store and the #549 channel-link store, NOT the
/// crash-disposable UNLOGGED tables of #541/#542): losing a target silently
/// stops notification delivery until an admin re-registers it. The serialized
/// `reference` is the Bot Framework `ConversationReference` (#548) used for the
/// proactive `continueConversationAsync` send (#550 mechanism).
///
/// Tenant scoping: every read/write is keyed by `workspaceId`, so one workspace
/// can only ever route notifications to its OWN registered channel — a
/// notification can never leak into another workspace's Teams channel.
model TeamsNotificationTarget {
  id String @id @default(cuid())
  /// Owning METIS workspace (multi-tenant scoping key).
  workspaceId String
  /// The event whose notifications route to this channel. Free-form; today one
  /// of "analysis-complete" | "publish-rolled-back" | "budget-exceeded".
  eventType String
  /// Bot Framework conversation id of the destination Teams channel.
  conversationId String
  /// Bot Framework channel id — "msteams" for Teams.
  channelId String
  /// AAD tenant id of the destination channel, if known. Used by the #554 tenant
  /// allowlist gate before a proactive send.
  tenantId String?
  /// Serialized Bot Framework `ConversationReference` JSON for the proactive send.
  reference String
  /// Free-form lifecycle status — "active" by default. No migration to add
  /// states, mirroring the TeamsChannelLink / GeneratedDocument.status convention.
  status String @default("active")
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("TeamsNotificationTargetCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// One destination per event per workspace.
  @@unique([workspaceId, eventType])
  @@index([workspaceId])
  @@map("teams_notification_targets")
}

/// Issue #580 (epic #63) — per-workspace, per-service PagerDuty Events API v2
/// configuration for sev-1 critical-event alerting.
///
/// A "service" is PagerDuty's routing unit: one routing (integration) key maps to
/// exactly one PagerDuty service. The `serviceKey` here is a free-form LOGICAL
/// name (e.g. "default" | "publishing" | "infra") that the sev-1 sources select
/// to route different event classes to different PagerDuty services. Simple
/// deployments use a single "default" config.
///
/// SECRET HANDLING (OWASP A02): the PagerDuty routing key is NOT a column. It is
/// encrypted into the hardened vault (AES-256-GCM) under a deterministic label and
/// only the `${vault:label}` REFERENCE is stored in `routingKeyRef`. Plaintext
/// never touches this row, logs, or API responses — mirroring the #548
/// TeamsAppInstallation.appPasswordRef pattern.
///
/// Every read/write is keyed by `workspaceId`, so one workspace's events can only
/// ever resolve — and fire to — its OWN routing key (tenant isolation).
model PagerDutyServiceConfig {
  id String @id @default(cuid())
  /// Owning METIS workspace (multi-tenant scoping key).
  workspaceId String
  /// Free-form logical service name selected by sev-1 sources. "default" unless
  /// an admin splits event classes across PagerDuty services. No migration to add
  /// new service names (free-form, like the status conventions elsewhere).
  serviceKey String
  /// `${vault:label}` REFERENCE to the encrypted PagerDuty routing key. Never the
  /// plaintext key itself.
  routingKeyRef String
  /// Optional human label for the PagerDuty service (display only).
  label String?
  /// Free-form lifecycle status — "active" by default. An "inactive" config is
  /// treated as not-registered by the trigger path (delivery disabled).
  status String @default("active")
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("PagerDutyServiceConfigCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// One config per logical service per workspace.
  @@unique([workspaceId, serviceKey])
  @@index([workspaceId])
  @@map("pagerduty_service_configs")
}

/// Issue #579 (epic #63) — per-(workspace, Slack team) Slack app installation.
///
/// Models the Slack OAuth install that grants METIS a per-workspace bot token.
/// The bot token (`xoxb-...`) is the sensitive material; it is NEVER persisted on
/// this row. Only the `${vault:label}` REFERENCE to the AES-256-GCM-encrypted
/// token is stored in `botTokenRef`, mirroring the #548
/// TeamsAppInstallation.appPasswordRef pattern.
model SlackAppInstallation {
  id String @id @default(cuid())
  /// Owning METIS workspace (multi-tenant scoping key).
  workspaceId String
  /// Slack team (workspace) id from the OAuth `team.id` — the Slack-side tenant.
  slackTeamId String
  /// Optional Slack team/enterprise name captured at install (display only).
  slackTeamName String?
  /// Slack `bot_user_id` returned by `oauth.v2.access` (display/diagnostics).
  botUserId String?
  /// `${vault:label}` reference to the encrypted Slack bot token. Never the
  /// plaintext token. Resolved via the vault when constructing a WebClient.
  botTokenRef String
  /// Lifecycle status — "active" | "revoked". Free-form string (no migration to
  /// add states), mirroring the GeneratedDocument.status convention.
  status String @default("active")
  /// Optional human label for the registration (shown in the admin UI).
  label String?
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("SlackInstallationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// One installation per (workspace, Slack team). Re-installing rotates in place.
  @@unique([workspaceId, slackTeamId])
  @@index([workspaceId])
  @@index([slackTeamId])
  @@map("slack_app_installations")
}

/// Issue #579 (epic #63) — Slack user → METIS user identity binding.
///
/// A Slack interaction carries a `team.id` + `user.id`, but not reliably an
/// email. METIS SSO maps an external identity to a `User` BY EMAIL, so we reuse
/// that linkage (mirroring the #549 Teams AAD resolver): a durable
/// `(slackTeamId, slackUserId)→User` binding established through an email match
/// (or explicit admin linking), then resolved against on future interactions.
///
/// SECURITY — team-scoped, no cross-team leakage: the binding key is
/// `(slackTeamId, slackUserId)` (unique). A `slackUserId` from a DIFFERENT team
/// can never collide with a local user's binding, so a foreign-team sender
/// resolves to `null`.
model SlackUserIdentity {
  id String @id @default(cuid())
  /// Owning METIS workspace (multi-tenant scoping key).
  workspaceId String
  /// Slack team id of the sender — part of the resolver key. Team scoping is the
  /// cross-team isolation boundary.
  slackTeamId String
  /// Slack user id (stable per-user id within the team) — part of the key.
  slackUserId String
  /// The resolved METIS user.
  userId String
  /// Optional email captured at binding time (provenance; the SSO match key).
  email String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One binding per (team, user): the resolver key. Team-scoped so a
  /// foreign-team slackUserId cannot collide with a local user's binding.
  @@unique([slackTeamId, slackUserId])
  @@index([workspaceId])
  @@index([userId])
  @@map("slack_user_identities")
}

// ============================================================================
// Epic #609 (#616) — formal review & approval workflow for requirements and
// specs, plus baselines. Distinct from ApprovalRequest (Epic #597), which is
// the analysis-pipeline HITL checkpoint — this is formal sign-off on AUTHORED
// artifacts.
// ============================================================================

/// Epic #609 (#616) — a formal review: the container for scope items and
/// reviewer assignments, carrying the status state machine.
///
/// `status` transitions are enforced EXCLUSIVELY by
/// `server/src/lib/reviews/state-machine.ts` (exhaustive transition table;
/// illegal transitions throw a typed 409):
///   draft → in_review (submit) → approved | rejected;
///   in_review → draft (withdraw); rejected → draft (revise);
///   approved → in_review (re-open on content change);
///   any non-closed → closed (terminal archive).
model ReviewRequest {
  id            String    @id @default(cuid())
  projectId     String
  title         String
  description   String    @default("")
  /// draft|in_review|approved|rejected|closed — see state-machine.ts.
  status        String    @default("draft")
  /// Decision policy: `all` (every reviewer must approve) or `quorum`
  /// (`quorum` approvals suffice). Aggregation lives in state-machine.ts.
  policy        String    @default("all") // all|quorum
  /// Required approvals when policy = "quorum"; null for "all".
  quorum        Int?
  requestedById String
  dueAt         DateTime?
  /// Set when the state machine reaches a decision (approved/rejected);
  /// cleared on re-open.
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy User                 @relation("ReviewRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  items       ReviewRequestItem[]
  assignments ReviewerAssignment[]
  /// Produced on approval (#620) — at most one baseline per review.
  baseline    Baseline?

  @@index([projectId, status])
  @@index([requestedById])
  @@map("review_requests")
}

/// Epic #609 (#616) — one artifact in a review's scope: a Requirement OR a
/// GeneratedDocument (spec) — exactly one of the two FKs is set — pinned to
/// the exact version under review. `pinnedVersion` mirrors the artifact's
/// version counter at submit time (`Requirement.version` backed by
/// `RequirementVersion` history, or `GeneratedDocumentVersion.version`), so
/// sign-off is auditable against an immutable snapshot — no new snapshot
/// machinery.
model ReviewRequestItem {
  id                  String   @id @default(cuid())
  reviewRequestId     String
  requirementId       String?
  generatedDocumentId String?
  /// Artifact version counter captured at submit time — the reviewed pin.
  pinnedVersion       Int
  createdAt           DateTime @default(now())

  reviewRequest     ReviewRequest      @relation(fields: [reviewRequestId], references: [id], onDelete: Cascade)
  requirement       Requirement?       @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  generatedDocument GeneratedDocument? @relation(fields: [generatedDocumentId], references: [id], onDelete: Cascade)

  @@unique([reviewRequestId, requirementId])
  @@unique([reviewRequestId, generatedDocumentId])
  @@index([requirementId])
  @@index([generatedDocumentId])
  @@map("review_request_items")
}

/// Epic #609 (#616) — per-reviewer decision on a ReviewRequest. One row per
/// assigned reviewer; the decision is recorded with timestamp + note and
/// aggregated into the review outcome by the all/quorum policy.
model ReviewerAssignment {
  id              String    @id @default(cuid())
  reviewRequestId String
  reviewerId      String
  decision        String    @default("pending") // pending|approved|rejected
  /// Optional free-text note recorded with the decision.
  note            String?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reviewRequest ReviewRequest @relation(fields: [reviewRequestId], references: [id], onDelete: Cascade)
  reviewer      User          @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([reviewRequestId, reviewerId])
  @@index([reviewerId, decision])
  @@map("reviewer_assignments")
}

/// Epic #609 (#616) — a named, immutable snapshot of approved requirement
/// versions: a set of `(requirementId, version)` pins over the
/// `RequirementVersion` history substrate (Epic #770). Auto-created when a
/// review is approved (#620); `reviewRequestId` is null for manually created
/// baselines.
model Baseline {
  id              String   @id @default(cuid())
  projectId       String
  /// Producing review, when auto-created on approval. SetNull so a baseline
  /// (immutable audit artifact) survives deletion of its review.
  reviewRequestId String?  @unique
  name            String
  description     String   @default("")
  createdById     String
  createdAt       DateTime @default(now())

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewRequest ReviewRequest? @relation(fields: [reviewRequestId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("BaselineCreator", fields: [createdById], references: [id], onDelete: Cascade)
  items         BaselineItem[]

  @@unique([projectId, name])
  @@map("baselines")
}

/// Epic #609 (#616) — one `(requirementId, version)` pin inside a Baseline.
/// `version` mirrors the pinned `Requirement.version` counter — the full
/// content at that version is reconstructable from `RequirementVersion`
/// history (append-only, Epic #770).
model BaselineItem {
  id            String   @id @default(cuid())
  baselineId    String
  requirementId String
  /// Pinned Requirement.version counter (see RequirementVersion).
  version       Int
  createdAt     DateTime @default(now())

  baseline    Baseline    @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([baselineId, requirementId])
  @@index([requirementId])
  @@map("baseline_items")
}
