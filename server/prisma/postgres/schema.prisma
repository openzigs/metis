  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("inference_profiles")
}

/// Issue #606 — Token budget configuration. Scoped to either a project
/// (projectId set) or a user (userId set, projectId null). Enforces
