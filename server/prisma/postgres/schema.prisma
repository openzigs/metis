  status     String    @default("pending") // "pending" | "approved" | "rejected"
  reviewerId String?
  reviewNote String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId, status])
  @@index([status])
