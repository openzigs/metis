  {
    "name": "metis_read_file_slice",
    "description": "Read up to 200 numbered lines of a file in the project's repository, to confirm a search hit and quote the lines you cite. Take the exact path from a search result and ask for a narrow range around the locator.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "The project's id, from metis_list_projects."
        },
        "filePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Repository-relative path, exactly as a search result gave it."
        },
        "startLine": {
          "description": "1-based, inclusive.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "endLine": {
          "description": "1-based, inclusive; at most 200 lines after startLine.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "projectId",
        "filePath"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "type": "string"
        },
        "resultCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "instructions": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "tool",
        "projectId",
        "result",
        "resultCount",
        "truncated",
        "citations",
        "instructions"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "execution": {
