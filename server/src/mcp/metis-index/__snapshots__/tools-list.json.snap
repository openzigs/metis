  {
    "name": "metis_read_requirements",
    "description": "Read the project's METIS requirements. Without requirementId: list them, filtered by review status, label or a query matched by meaning and by words. With requirementId: one requirement in full, with acceptance criteria, code links, data mappings and its requirement → spec → code trace.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "The project's id, from metis_list_projects."
        },
        "requirementId": {
          "description": "Read this requirement in full (an id from a listing).",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "description": "List: only this status.",
          "type": "string",
          "enum": [
            "draft",
            "approved",
            "rejected",
            "deferred"
          ]
        },
        "label": {
          "description": "List: only this label.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "query": {
          "description": "List: what to look for, in the analyst's own words.",
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "projectId"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "type": "string"
        },
        "resultCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "instructions": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "tool",
        "projectId",
        "result",
        "resultCount",
        "truncated",
        "citations",
        "instructions"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "metis_search_code_context",
    "description": "Answer-oriented code search: the whole functions and classes that answer a question about a project's code, adjacent matches merged, each with a file:line locator and the indexed commit. When: you need the code behind a behaviour or business term. Empty result: reword with a synonym or the likely identifier, or try metis_search_symbols.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "The project's id, from metis_list_projects."
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Two to five words in the code's own vocabulary, not the whole question."
        },
        "limit": {
          "description": "Most spans to return (1-12).",
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      },
      "required": [
        "projectId",
        "query"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "type": "string"
        },
        "resultCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "instructions": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "tool",
        "projectId",
        "result",
        "resultCount",
        "truncated",
        "citations",
        "instructions"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "metis_search_symbols",
    "description": "Keyword + semantic search over a project's code symbols (functions, classes, methods), each with a file:line locator and the indexed commit. Narrow with fileGlob, symbolKind or language. Empty result: reword with a synonym or the identifier spelling, then try metis_search_code_context, or metis_graph_callers with a name.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "The project's id, from metis_list_projects."
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Two to five words in the code's own vocabulary, not the whole question."
        },
        "limit": {
          "description": "Most hits to return (1-30).",
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "fileGlob": {
          "description": "Only files matching this repository-relative glob, e.g. 'internal/reader/**'.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "symbolKind": {
          "description": "Only symbols of this kind.",
          "type": "string",
          "enum": [
            "function",
            "method",
            "class",
            "interface",
            "type",
            "module",
            "table",
            "column",
            "procedure"
          ]
        },
        "language": {
          "description": "Only files of this language.",
          "type": "string",
          "enum": [
            "ts",
            "js",
            "py",
            "go",
            "java",
            "kt",
            "scala",
            "cs",
            "c",
            "cpp",
            "rs",
            "sas",
            "cbl",
            "sql"
          ]
        }
      },
      "required": [
        "projectId",
        "query"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "type": "string"
        },
        "resultCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "instructions": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "tool",
        "projectId",
        "result",
        "resultCount",
        "truncated",
        "citations",
        "instructions"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  }
]
