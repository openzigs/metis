[
  {
    "name": "metis_graph_callees",
    "description": "The symbols the named symbol calls, from the project's code graph, plus calls the parser could not resolve. Read a call with metis_read_file_slice before you state that one function calls another.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "The project's id, from metis_list_projects."
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "The symbol's name; its qualified name when the bare name is ambiguous."
        }
      },
      "required": [
        "projectId",
        "symbol"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "type": "string"
        },
        "resultCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "instructions": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "tool",
        "projectId",
        "result",
        "resultCount",
        "truncated",
        "citations",
        "instructions"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
