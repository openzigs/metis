        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "model": {
        "type": "string"
      }
    },
    "required": [
      "original",
      "patch"
    ]
  },
  "score_grounding": {
    "type": "object",
    "properties": {
      "output": {
        "type": "string"
      },
      "sources": {
        "type": "array",
