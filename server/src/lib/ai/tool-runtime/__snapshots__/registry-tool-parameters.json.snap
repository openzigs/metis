        "type": "string"
      },
      "projectIds": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "k": {
        "type": "integer"
      }
    },
    "required": [
      "query"
    ]
  },
  "search-knowledge": {
    "type": "object",
    "properties": {
