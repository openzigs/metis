          "type": "string"
        }
      },
      "ngramSize": {
        "type": "integer"
      },
      "maxClaims": {
        "type": "integer"
      }
    },
    "required": [
      "output",
      "sources"
    ]
  },
  "inspect_schema": {
    "type": "object",
    "properties": {
      "connectorId": {
        "type": "string",
        "description": "Id of the project's database connector"
      },
      "schema": {
        "type": "string"
      }
    },
    "required": [
      "connectorId"
    ]
  },
  "query_database": {
    "type": "object",
    "properties": {
      "connectorId": {
        "type": "string",
        "description": "Id of the project's database connector"
      },
      "sql": {
        "type": "string",
        "description": "A single read-only SELECT statement. Writes/DDL are rejected."
      },
      "maxRows": {
        "type": "integer"
      }
    },
    "required": [
      "connectorId",
      "sql"
    ]
  },
  "search-knowledge-global": {
    "type": "object",
    "properties": {
