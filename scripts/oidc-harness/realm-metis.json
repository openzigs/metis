{
  "realm": "metis",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "groups": [
    { "name": "metis-admins", "path": "/metis-admins" },
    { "name": "metis-developers", "path": "/metis-developers" },
    { "name": "metis-readers", "path": "/metis-readers" }
  ],
  "users": [
    {
      "username": "tester",
      "enabled": true,
      "emailVerified": true,
      "email": "tester@metis.local",
      "firstName": "Tess",
      "lastName": "Tester",
      "credentials": [{ "type": "password", "value": "testpass", "temporary": false }],
      "groups": ["/metis-admins"]
    },
    {
      "username": "dev",
      "enabled": true,
      "emailVerified": true,
      "email": "dev@metis.local",
      "firstName": "Dev",
      "lastName": "Eloper",
      "credentials": [{ "type": "password", "value": "devpass", "temporary": false }],
      "groups": ["/metis-developers"]
    }
  ],
  "clients": [
    {
      "clientId": "metis",
      "name": "METIS (local OIDC harness)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "metis-local-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:4000/api/auth/oidc/callback"],
      "webOrigins": ["http://localhost:3000", "http://localhost:4000"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ]
}
