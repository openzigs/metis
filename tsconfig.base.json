{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@metis/shared": ["./packages/shared/src/index.ts"],
      "@metis/shared/*": ["./packages/shared/src/*"],
      "@metis/ui-kit": ["./packages/ui-kit/src/index.ts"],
      "@metis/ui-kit/*": ["./packages/ui-kit/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "coverage"]
}
