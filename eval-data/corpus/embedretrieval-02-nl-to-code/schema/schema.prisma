model Workspace {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  logoUrl            String?
  /// Epic #47 (#49) — workspace-level monthly spend budget in integer cents.
  /// Null = no budget configured (alert rules that reference the budget are
  /// skipped). Drives the 50/80/100% FinOps alert thresholds.
  monthlyBudgetCents Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  members           WorkspaceMember[]
  invites           WorkspaceInvite[]
  projects          Project[]
  usageDaily        WorkspaceUsageDaily[]
  /// Epic #47 (#48) — persisted cost forecasts (per workspace + per project).
  costForecasts     CostForecast[]
  /// Epic #47 (#49) — budget alert threshold rules.
  alertRules        AlertRule[]
  /// Epic #47 (#49) — alert fire history (idempotency + audit).
  alertEvents       AlertEvent[]
  /// Epic #47 (#50) — outbound alert delivery channels (email + webhook).
  alertChannels     AlertChannel[]
  /// Epic #295 Phase 4 (#307) — shared physical-DB registry for this workspace.
  databaseResources DatabaseResource[]
  /// Epic #547 Phase 0 (#548) — Teams app installations for this workspace.
  teamsInstallations TeamsAppInstallation[]
  /// Epic #547 Phase 1 (#549) — thread↔channel links for this workspace.
  teamsChannelLinks  TeamsChannelLink[]
  /// Epic #547 Phase 1 (#549) — AAD→METIS identity bindings for this workspace.
  teamsUserIdentities TeamsUserIdentity[]
  /// Issue #67 — one-way Teams notification targets for this workspace.
  teamsNotificationTargets TeamsNotificationTarget[]
  /// Issue #580 — PagerDuty sev-1 service configs for this workspace.
  pagerDutyServiceConfigs PagerDutyServiceConfig[]
  /// Issue #579 — Slack app installations for this workspace.
  slackInstallations SlackAppInstallation[]
  /// Issue #579 — Slack→METIS identity bindings for this workspace.
  slackUserIdentities SlackUserIdentity[]

  @@index([slug])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member") // owner|admin|member
  joinedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        String    @default("member") // owner|admin|member
  token       String    @unique
  invitedById String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("WorkspaceInviter", fields: [invitedById], references: [id])

  @@index([workspaceId])
  @@index([email])
  @@index([token])
  @@map("workspace_invites")
}

model WorkspaceUsageDaily {
  id          String   @id @default(cuid())
  workspaceId String
  date        DateTime
  tokensUsed  Int      @default(0)
  costCents   Int      @default(0)
  sessions    Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
  @@index([workspaceId, date])
  @@map("workspace_usage_daily")
}

model UserRole {
